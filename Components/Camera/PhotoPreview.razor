@* Photo Preview Component with Swipe Navigation *@

<MudPaper id="photo-preview-container" Class="mb-4 d-flex justify-center align-center grey lighten-3" Elevation="0"
    Style="height: 250px; overflow: hidden; position: relative; user-select: none;">
    @if (Photos.Any())
    {
        <MudImage Src="@Photos[CurrentIndex]" ObjectFit="ObjectFit.Cover"
            Style="width:100%; height:100%;" Class="fade-in" 
            Alt="@($"Foto {CurrentIndex + 1} de {Photos.Count}")" />
        
        <!-- Swipe Indicators -->
        @if (CurrentIndex > 0)
        {
            <div style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; padding: 8px; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
            </div>
        }
        @if (CurrentIndex < Photos.Count - 1)
        {
            <div style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; padding: 8px; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </div>
        }
        
        <!-- Photo Counter -->
        <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.6); color: white; padding: 4px 12px; border-radius: 16px; font-size: 12px; font-weight: 500;">
            @(CurrentIndex + 1) / @Photos.Count
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center gap-2" style="color: var(--mud-palette-text-secondary);">
            <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Size="Size.Large" Style="opacity: 0.5;" />
            <MudText Typo="Typo.body2">Nenhuma foto capturada</MudText>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public List<string> Photos { get; set; } = new();
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public EventCallback<int> CurrentIndexChanged { get; set; }
}
