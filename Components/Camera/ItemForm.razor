@using pwa_camera_poc_blazor.Models

@* Item Form Component *@

<EditForm EditContext="@EditContext" OnValidSubmit="OnSubmit" id="camera-form">
    <DataAnnotationsValidator />
    <MudGrid Spacing="2">
        <!-- Section: Identificação -->
        <MudItem xs="12">
            <div class="d-flex align-center gap-2 mb-2 mt-2">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Identificação do Patrimônio</MudText>
            </div>
            <MudDivider Class="mb-4" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="Item.Codigo" Label="Código/ID *" Variant="Variant.Outlined"
                For="@(() => Item.Codigo)" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="Item.Nome" Label="Nome do Item *" Variant="Variant.Outlined"
                For="@(() => Item.Nome)" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Categoria *</MudText>
            <div class="mud-input-control mud-input-input-control">
                <div class="mud-input-control-input-container">
                    <div class="mud-input mud-input-outlined" style="position: relative;">
                        <select @bind="Item.Category" class="mud-input-slot mud-input-root mud-input-root-outlined" 
                                style="height: 40px; padding: 8px 14px; width: 100%; -webkit-appearance: none; appearance: none; background: transparent; z-index: 10; font-size: 0.875rem; color: var(--mud-palette-text-primary);">
                            <option value="">Selecione a categoria</option>
                            <option value="Móveis">Móveis</option>
                            <option value="Eletrônicos">Eletrônicos</option>
                            <option value="Equipamentos">Equipamentos</option>
                            <option value="Ferramentas">Ferramentas</option>
                            <option value="Materiais">Materiais</option>
                            <option value="Outros">Outros</option>
                        </select>
                        <div class="mud-input-outlined-border"></div>
                        <div style="position: absolute; right: 14px; top: 8px; pointer-events: none;">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Secondary" Size="Size.Small" />
                        </div>
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- Section: Detalhes -->
        <MudItem xs="12" Class="mt-4">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Localização e Detalhes</MudText>
            </div>
            <MudDivider Class="mb-4" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="Item.Localizacao" Label="Localização *" Variant="Variant.Outlined"
                For="@(() => Item.Localizacao)" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="Item.Observacoes" Label="Observações"
                Variant="Variant.Outlined" Lines="2" For="@(() => Item.Observacoes)" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-end gap-2 mt-6 pb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="OnCancel" Class="rounded-lg hover-lift">
                Cancelar
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                Disabled="@IsSaving" StartIcon="@Icons.Material.Filled.Save" Class="rounded-lg px-6 hover-lift ripple-effect">
                @(IsSaving ? "Salvando..." : "Salvar")
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter] public ItemPatrimonio Item { get; set; } = new();
    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
