@namespace AspecCaptura.Components.Base

<div class="@GetCardClasses()" @onclick="HandleClick">
    @if (Header != null)
    {
        <div class="px-4 py-3 border-b border-outline">
            @Header
        </div>
    }
    
    @if (ChildContent != null)
    {
        <div class="p-4">
            @ChildContent
        </div>
    }
    
    @if (Actions != null)
    {
        <div class="px-4 py-3 border-t border-outline flex gap-2 justify-end">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public CardElevation Elevation { get; set; } = CardElevation.Medium;
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        if (Clickable)
        {
            await OnClick.InvokeAsync();
        }
    }

    private string GetCardClasses()
    {
        var classes = new List<string>
        {
            "bg-surface-container",
            "rounded-lg",
            "overflow-hidden",
            "transition-all"
        };

        // Elevation
        classes.Add(Elevation switch
        {
            CardElevation.None => "shadow-none",
            CardElevation.Low => "shadow-sm",
            CardElevation.Medium => "shadow-md",
            CardElevation.High => "shadow-lg",
            _ => "shadow-md"
        });

        // Clickable
        if (Clickable)
        {
            classes.Add("cursor-pointer");
            classes.Add("hover:shadow-xl");
            classes.Add("hover:scale-[1.02]");
        }

        return string.Join(" ", classes);
    }

    public enum CardElevation { None, Low, Medium, High }
}
