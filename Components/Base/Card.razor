@*
    Card Component
    
    A versatile card container with elevation levels and interactive states.
    Supports header, body, and footer sections via RenderFragments.
    
    Features:
    - Elevation levels: flat, raised, elevated
    - Interactive variant with ripple effect
    - Horizontal and vertical layouts
    - 16px padding for content areas
    - 12px border radius
    
    Usage:
    <Card Elevation="CardElevation.Raised" Interactive="true" OnClick="HandleClick">
        <Header>
            <h3>Card Title</h3>
        </Header>
        <Body>
            <p>Card content goes here</p>
        </Body>
        <Footer>
            <Button>Action</Button>
        </Footer>
    </Card>
    
    Requirements: 2.1, 16.1, 16.2, 16.3, 16.4, 16.6, 16.7, 16.8
*@

@namespace AspecCaptura.Components.Base

<div 
    class="card card--@Elevation.ToString().ToLower() card--@Layout.ToString().ToLower() @(Interactive ? "card--interactive" : "")"
    @onclick="HandleClick">
    
    @if (Header != null)
    {
        <div class="card__header">
            @Header
        </div>
    }
    
    @if (Body != null)
    {
        <div class="card__body">
            @Body
        </div>
    }
    else if (ChildContent != null)
    {
        <div class="card__body">
            @ChildContent
        </div>
    }
    
    @if (Footer != null)
    {
        <div class="card__footer">
            @Footer
        </div>
    }
</div>

@code {
    /// <summary>
    /// Card elevation level
    /// </summary>
    [Parameter]
    public CardElevation Elevation { get; set; } = CardElevation.Raised;

    /// <summary>
    /// Whether card is interactive (clickable with hover effects)
    /// </summary>
    [Parameter]
    public bool Interactive { get; set; }

    /// <summary>
    /// Card layout orientation
    /// </summary>
    [Parameter]
    public CardLayout Layout { get; set; } = CardLayout.Vertical;

    /// <summary>
    /// Header content
    /// </summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>
    /// Body content
    /// </summary>
    [Parameter]
    public RenderFragment? Body { get; set; }

    /// <summary>
    /// Footer content
    /// </summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Default content (used if Body is not specified)
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Click event callback (only fires if Interactive is true)
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        if (Interactive)
        {
            await OnClick.InvokeAsync();
        }
    }

    public enum CardElevation
    {
        Flat,
        Raised,
        Elevated
    }

    public enum CardLayout
    {
        Vertical,
        Horizontal
    }
}
