@namespace pwa_camera_poc_blazor.Components.Base

<div class="flex flex-col gap-1">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm font-medium text-on-surface" for="@_inputId">@Label</label>
    }
    
    <div class="relative">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">@Icon</span>
        }
        
        <input 
            id="@_inputId"
            type="@GetInputType()"
            class="@GetInputClasses()"
            placeholder="@Placeholder"
            value="@Value"
            disabled="@Disabled"
            required="@Required"
            @oninput="HandleInput" />
    </div>
    
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="text-xs text-error mt-1">@ErrorMessage</span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public InputType Type { get; set; } = InputType.Text;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Icon { get; set; }

    private readonly string _inputId = $"input-{Guid.NewGuid():N}";

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetInputClasses()
    {
        var classes = new List<string>
        {
            "w-full",
            "px-4",
            "py-2",
            "border",
            "rounded-md",
            "bg-surface",
            "text-on-surface",
            "transition-all",
            "focus:ring-2",
            "focus:ring-primary",
            "focus:border-primary",
            "focus:outline-none"
        };

        if (!string.IsNullOrEmpty(Icon))
        {
            classes.Add("pl-10");
        }

        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            classes.Add("border-error");
        }
        else
        {
            classes.Add("border-outline");
        }

        if (Disabled)
        {
            classes.Add("opacity-50");
            classes.Add("cursor-not-allowed");
        }

        return string.Join(" ", classes);
    }

    private string GetInputType()
    {
        return Type switch
        {
            InputType.Text => "text",
            InputType.Password => "password",
            InputType.Email => "email",
            InputType.Number => "number",
            InputType.Tel => "tel",
            _ => "text"
        };
    }

    public enum InputType { Text, Password, Email, Number, Tel }
}
