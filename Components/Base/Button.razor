@*
    Button Component
    
    A versatile button component with multiple variants, sizes, and states.
    Follows mobile-first design with proper touch targets and accessibility.
    
    Features:
    - Variants: primary, secondary, outline, ghost
    - Sizes: sm, md, lg
    - Full-width option
    - Icon support
    - Ripple effect for touch interactions
    - Minimum 44x44px touch target
    - Proper ARIA labels
    
    Usage:
    <Button 
        Variant="ButtonVariant.Primary"
        Size="ButtonSize.Medium"
        Icon="add"
        OnClick="HandleClick">
        Add Item
    </Button>
    
    Requirements: 2.1, 2.6, 2.7, 3.3, 4.5, 8.1, 8.4
*@

@namespace AspecCaptura.Components.Base

<button 
    type="@Type"
    class="btn btn--@Variant.ToString().ToLower() btn--@Size.ToString().ToLower() @(FullWidth ? "btn--full-width" : "") @(Disabled ? "btn--disabled" : "")"
    disabled="@Disabled"
    aria-label="@AriaLabel"
    @onclick="HandleClick">
    
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="btn__icon material-symbols-outlined">@Icon</span>
    }
    
    @if (ChildContent != null)
    {
        <span class="btn__text">@ChildContent</span>
    }
</button>

@code {
    /// <summary>
    /// Button variant style
    /// </summary>
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>
    /// Button size
    /// </summary>
    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>
    /// Whether button should take full width of container
    /// </summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>
    /// Whether button is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Material Symbols icon name
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// ARIA label for accessibility
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Button type attribute (button, submit, reset)
    /// </summary>
    [Parameter]
    public string Type { get; set; } = "button";

    /// <summary>
    /// Click event callback
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Button content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick()
    {
        if (!Disabled)
        {
            await OnClick.InvokeAsync();
        }
    }

    public enum ButtonVariant
    {
        Primary,
        Secondary,
        Outline,
        Ghost
    }

    public enum ButtonSize
    {
        Small,
        Medium,
        Large
    }
}
