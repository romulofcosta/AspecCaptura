@*
    Badge Component
    
    A small status indicator or label component with semantic colors.
    Uses pill shape with full border radius.
    
    Features:
    - Variants: primary, success, warning, error, neutral
    - Sizes: sm, md, lg
    - Dot variant for notification indicators
    - Position support for absolute positioning
    
    Usage:
    <Badge Variant="BadgeVariant.Success" Size="BadgeSize.Medium">
        Active
    </Badge>
    
    <Badge Variant="BadgeVariant.Error" Dot="true" />
    
    Requirements: 2.1, 21.1, 21.2, 21.3, 21.4, 21.7, 21.8
*@

@namespace AspecCaptura.Components.Base

@if (Dot)
{
    <span class="badge badge--dot badge--@Variant.ToString().ToLower() @(Position != BadgePosition.None ? $"badge--{Position.ToString().ToLower()}" : "")"></span>
}
else
{
    <span class="badge badge--@Variant.ToString().ToLower() badge--@Size.ToString().ToLower() @(Position != BadgePosition.None ? $"badge--{Position.ToString().ToLower()}" : "")">
        @ChildContent
    </span>
}

@code {
    /// <summary>
    /// Badge variant (color scheme)
    /// </summary>
    [Parameter]
    public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;

    /// <summary>
    /// Badge size
    /// </summary>
    [Parameter]
    public BadgeSize Size { get; set; } = BadgeSize.Medium;

    /// <summary>
    /// Whether to display as a dot (notification indicator)
    /// </summary>
    [Parameter]
    public bool Dot { get; set; }

    /// <summary>
    /// Position for absolute positioning (e.g., on top of an icon)
    /// </summary>
    [Parameter]
    public BadgePosition Position { get; set; } = BadgePosition.None;

    /// <summary>
    /// Badge content
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public enum BadgeVariant
    {
        Primary,
        Success,
        Warning,
        Error,
        Neutral
    }

    public enum BadgeSize
    {
        Small,
        Medium,
        Large
    }

    public enum BadgePosition
    {
        None,
        TopRight,
        TopLeft,
        BottomRight,
        BottomLeft
    }
}
