<MudPaper Elevation="0"
    Class="@($"footer-bar d-flex justify-space-around align-center width-100 {(IsHidden ? "d-none" : "")}")"
    role="navigation"
    aria-label="Navegação principal">

    <!-- Início -->
    <div class="@($"footer-nav-item {(ActiveTab == "home" ? "active" : "")}")" 
        @onclick="SetTabHome"
        role="button"
        tabindex="0"
        aria-label="Ir para página inicial"
        aria-current="@(ActiveTab == "home" ? "page" : "false")"
        @onkeypress="@((e) => { if (e.Key == "Enter" || e.Key == " ") SetTabHome(); })">
        <MudIcon Icon="@Icons.Material.Filled.Home" 
            Class="@($"footer-icon {(ActiveTab == "home" ? "active" : "")}")"
            aria-hidden="true" />
        <MudText Typo="Typo.caption" Class="@($"footer-text {(ActiveTab == "home" ? "active" : "")}")">
            Início</MudText>
    </div>

    <!-- Central Capture FAB -->
    <div class="footer-fab-container">
        <MudIconButton Icon="@Icons.Material.Filled.CameraAlt" 
            Class="footer-fab" 
            OnClick="OnCaptureClick"
            aria-label="Capturar novo patrimônio" />
    </div>

    <!-- Sincronização -->
    <div class="@($"footer-nav-item {(ActiveTab == "sync" ? "active" : "")}")" 
        @onclick="SetTabSync"
        role="button"
        tabindex="0"
        aria-label="@($"Ir para sincronização{(PendingSyncCount > 0 ? $" - {PendingSyncCount} itens pendentes" : "")}")"
        aria-current="@(ActiveTab == "sync" ? "page" : "false")"
        @onkeypress="@((e) => { if (e.Key == "Enter" || e.Key == " ") SetTabSync(); })">
        <MudBadge Content="@PendingSyncCount" 
            Overlap="true" 
            Bordered="true" 
            Color="Color.Error"
            Visible="@(PendingSyncCount > 0)"
            aria-label="@($"{PendingSyncCount} itens pendentes de sincronização")">
            <MudIcon Icon="@Icons.Material.Filled.Sync"
                Class="@($"footer-icon {(ActiveTab == "sync" ? "active" : "")}")"
                aria-hidden="true" />
        </MudBadge>
        <MudText Typo="Typo.caption" Class="@($"footer-text {(ActiveTab == "sync" ? "active" : "")}")">
            Sincronização</MudText>
    </div>
</MudPaper>

@code {
    [Parameter] public string ActiveTab { get; set; } = "home";















    [Parameter] public int PendingSyncCount { get; set; } = 0;















    [Parameter] public EventCallback<string> OnTabChanged { get; set; }















    [Parameter] public EventCallback OnCaptureClick { get; set; }















    [Parameter] public bool IsHidden { get; set; }



    private async Task SetTabHome() => await OnTabChanged.InvokeAsync("home");

    private async Task SetTabSync() => await OnTabChanged.InvokeAsync("sync");
}