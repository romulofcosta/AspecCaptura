<MudPaper Elevation="0" Class="@($"d-flex justify-space-around align-center width-100 {(IsHidden ? "d-none" : "")}")"
    Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; height: 75px; background-color: #ffffff; border-top: 1px solid rgba(0,0,0,0.05); padding-bottom: env(safe-area-inset-bottom);">
    
    <!-- Início -->
    <div class="d-flex flex-column align-center justify-center" style="width: 33%; height: 100%; cursor: pointer; background-color: #EEF2FF; border-radius: 12px; margin: 8px 4px;"
        @onclick='() => OnTabChanged.InvokeAsync("home")'>
        <MudIcon Icon="@Icons.Material.Filled.Home" 
            Style="@($"font-size: 1.8rem; color: {(ActiveTab == "home" ? "#3F51B5" : "#9E9E9E")};")" />
        <MudText Typo="Typo.caption" 
            Style="@($"font-weight: 600; font-size: 0.75rem; color: {(ActiveTab == "home" ? "#3F51B5" : "#9E9E9E")};")">Início</MudText>
    </div>

    <!-- Central Capture FAB -->
    <div class="d-flex align-center justify-center" style="width: 33%; height: 100%; position: relative;">
        <MudIconButton Icon="@Icons.Material.Filled.CameraAlt" 
            Color="Color.Surface"
            Style="background-color: #3F51B5; border-radius: 50%; width: 56px; height: 56px; box-shadow: 0 4px 12px rgba(63,81,181,0.4); z-index: 10; transform: translateY(-15px);"
            OnClick="OnCaptureClick" />
    </div>

    <!-- Sincronização -->
    <div class="d-flex flex-column align-center justify-center" style="width: 33%; height: 100%; cursor: pointer;"
        @onclick='() => OnTabChanged.InvokeAsync("sync")'>
        <MudBadge Content="@PendingSyncCount" Overlap="true" Bordered="true" Color="Color.Error" Visible="@(PendingSyncCount > 0)">
            <MudIcon Icon="@Icons.Material.Filled.Sync" 
                Style="@($"font-size: 1.8rem; color: {(ActiveTab == "sync" ? "#3F51B5" : "#9E9E9E")};")" />
        </MudBadge>
        <MudText Typo="Typo.caption" 
            Style="@($"font-weight: 600; font-size: 0.75rem; color: {(ActiveTab == "sync" ? "#3F51B5" : "#9E9E9E")};")">Sincronização</MudText>
    </div>
</MudPaper>

@code {
    [Parameter] public string ActiveTab { get; set; } = "home";
    [Parameter] public int PendingSyncCount { get; set; } = 0;
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    [Parameter] public EventCallback OnCaptureClick { get; set; }
    [Parameter] public bool IsHidden { get; set; }
}