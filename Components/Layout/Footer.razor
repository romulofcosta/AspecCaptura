<MudPaper Elevation="0" Class="@($"d-flex justify-space-around align-center width-100 {(IsHidden ? "d-none" : "")}")"
    Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; height: 96px; background-color: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px); border-top: 2px solid rgba(1, 49, 92, 0.12); padding-bottom: env(safe-area-inset-bottom);">
    
    <MudIconButton Icon="@Icons.Material.Outlined.Home" 
        Color="@(ActiveTab == "home" ? Color.Primary : Color.Default)"
        Style="@(ActiveTab == "home" ? "opacity: 1; font-size: 3.2rem;" : "opacity: 0.35; font-size: 3.2rem;")"
        OnClick='() => OnTabChanged.InvokeAsync("home")' />

    <div class="d-flex align-center justify-center" style="height: 100%;">
        <MudIconButton Icon="@Icons.Material.Outlined.AddAPhoto" 
            Color="Color.Primary"
            Style="font-size: 5.0rem; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); transform: translateY(-8px);"
            Class="logo-hover"
            OnClick="OnCaptureClick" />
    </div>

    <MudBadge Content="@PendingSyncCount" Overlap="true" Bordered="true" Color="Color.Error"
        Visible="@(PendingSyncCount > 0)" Style="transform: scale(1.2);">
        <MudIconButton Icon="@Icons.Material.Outlined.CloudSync" 
            Color="@(ActiveTab == "sync" ? Color.Primary : Color.Default)"
            Style="@(ActiveTab == "sync" ? "opacity: 1; font-size: 3.2rem;" : "opacity: 0.35; font-size: 3.2rem;")"
            OnClick='() => OnTabChanged.InvokeAsync("sync")' />
    </MudBadge>
</MudPaper>

@code {
    [Parameter] public string ActiveTab { get; set; } = "home";
    [Parameter] public int PendingSyncCount { get; set; } = 0;
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    [Parameter] public EventCallback OnCaptureClick { get; set; }
    [Parameter] public bool IsHidden { get; set; }
}