<MudPaper Elevation="4" Class="@($"d-flex justify-space-around align-center width-100 {(IsHidden ? "d-none" : "")}")"
    Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; height: 70px; background-color: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border-top: 1px solid rgba(0,0,0,0.08); padding-bottom: env(safe-area-inset-bottom);">
    
    <div class="d-flex flex-column align-center justify-center" style="width: 80px;">
        <MudIconButton Icon="@Icons.Material.Outlined.Home" 
            Color="@(ActiveTab == "home" ? Color.Primary : Color.Default)"
            Style="@(ActiveTab == "home" ? "opacity: 1;" : "opacity: 0.4;")"
            OnClick='() => OnTabChanged.InvokeAsync("home")' Size="Size.Medium" />
        <MudText Typo="Typo.caption" Color="@(ActiveTab == "home" ? Color.Primary : Color.Default)" 
            Style="@(ActiveTab == "home" ? "font-weight: 600; font-size: 0.7rem; margin-top: -8px;" : "opacity: 0.4; font-size: 0.7rem; margin-top: -8px;")">Início</MudText>
    </div>

    <div class="d-flex align-center justify-center" style="margin-top: -14px;">
        <MudIconButton Icon="@Icons.Material.Filled.AddAPhoto" 
            Color="Color.Surface"
            Style="background-color: var(--mud-palette-primary); border: 3px solid white; border-radius: 22px; padding: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);"
            OnClick="OnCaptureClick" Size="Size.Large" />
    </div>

    <div class="d-flex flex-column align-center justify-center" style="width: 80px;">
        <MudBadge Content="@PendingSyncCount" Overlap="true" Bordered="true" Color="Color.Error"
            Visible="@(PendingSyncCount > 0)" Class="mt-1">
            <MudIconButton Icon="@Icons.Material.Outlined.CloudSync" 
                Color="@(ActiveTab == "sync" ? Color.Primary : Color.Default)"
                Style="@(ActiveTab == "sync" ? "opacity: 1;" : "opacity: 0.4;")"
                OnClick='() => OnTabChanged.InvokeAsync("sync")' Size="Size.Medium" />
        </MudBadge>
        <MudText Typo="Typo.caption" Color="@(ActiveTab == "sync" ? Color.Primary : Color.Default)" 
            Style="@(ActiveTab == "sync" ? "font-weight: 600; font-size: 0.7rem; margin-top: -8px;" : "opacity: 0.4; font-size: 0.7rem; margin-top: -8px;")">Sincronizar</MudText>
    </div>
</MudPaper>

@code {
    [Parameter] public string ActiveTab { get; set; } = "home";
    [Parameter] public int PendingSyncCount { get; set; } = 0;
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    [Parameter] public EventCallback OnCaptureClick { get; set; }
    [Parameter] public bool IsHidden { get; set; }
}