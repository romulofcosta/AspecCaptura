@using MudBlazor

<MudPaper Elevation="8" Class="d-flex justify-space-around align-center py-1 absolute bottom-0 width-100 z-30"
    Style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1200;">
    <MudIconButton Icon="@Icons.Material.Filled.Home" Color="@(ActiveTab == "home" ? Color.Primary : Color.Default)"
        OnClick='() => OnTabChanged.InvokeAsync("home")' Size="Size.Large" />

    <MudIconButton Icon="@Icons.Material.Filled.BarChart"
        Color="@(ActiveTab == "stats" ? Color.Primary : Color.Default)"
        OnClick='() => OnTabChanged.InvokeAsync("stats")' Size="Size.Large" />

    <MudIconButton Icon="@Icons.Material.Filled.CameraAlt" Color="Color.Primary" OnClick="OnCaptureClick"
        Size="Size.Large" />

    <MudBadge Content="@(PendingSyncCount > 0 ? (object)PendingSyncCount : null)" Color="Color.Error" Overlap="true"
        Bordered="true">
        <MudIconButton Icon="@Icons.Material.Filled.Sync" Color="@(ActiveTab == "sync" ? Color.Primary : Color.Default)"
            OnClick='() => OnTabChanged.InvokeAsync("sync")' Size="Size.Large" />
    </MudBadge>

    <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Default" OnClick="OnExportClick"
        Size="Size.Large" />
</MudPaper>
@code {
    [Parameter] public string ActiveTab { get; set; } = "home";
    [Parameter] public int PendingSyncCount { get; set; } = 0;
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    [Parameter] public EventCallback OnCaptureClick { get; set; }
    [Parameter] public EventCallback OnExportClick { get; set; }
}
