@inherits LayoutComponentBase
@implements IDisposable
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject AppState appState
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@using System.Text
@using MudBlazor
@inject ISnackbar Snackbar

<MudThemeProvider Theme="currentTheme" @bind-IsDarkMode="appState.IsDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleMenu" />
        <MudImage Src="images/aspec_logo.png" Alt="Aspec Capture" Width="32" Height="32" Class="mr-2 ml-3" Style="border-radius: 4px;"/>
        <MudText Typo="Typo.h6">Aspec Capture</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="isMenuOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Responsive" Style="z-index: 10001;">
        <NavMenu OnThemeToggle="ToggleTheme" OnUnitSelected="HandleUnitSelected" OnMenuItemClick="@(() => isMenuOpen = false)" />
    </MudDrawer>

    <MudMainContent Class="mud-width-full" Style="display: flex; flex-direction: column; height: calc(100vh - 64px - 64px); overflow: hidden;">
        @Body
    </MudMainContent>

    <Footer ActiveTab="@activeTab" PendingSyncCount="@appState.PendingSyncCount" OnTabChanged="HandleTabChanged"
        OnCaptureClick="HandleCaptureClick" IsHidden="@appState.IsCameraActive" />
</MudLayout>

@code {
    private bool isMenuOpen = false;
    private string activeTab = "home";

    // ASPEC Identity Theme Configuration
    private MudTheme currentTheme = new MudTheme()
    {
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px",
            DrawerWidthLeft = "280px",
            DrawerWidthRight = "300px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Outfit", "Inter", "Roboto", "Helvetica", "Arial", "sans-serif" },
                FontSize = "0.875rem",
                FontWeight = "400",
                LineHeight = "1.43",
                LetterSpacing = ".01071em"
            },
            H3 = new H3Typography() { FontSize = "2rem", FontWeight = "700", LineHeight = "1.2" },
            H4 = new H4Typography() { FontSize = "1.75rem", FontWeight = "700", LineHeight = "1.2" },
            H5 = new H5Typography() { FontSize = "1.5rem", FontWeight = "600", LineHeight = "1.3" },
            H6 = new H6Typography() { FontSize = "1.25rem", FontWeight = "600", LineHeight = "1.3" },
            Button = new ButtonTypography() { TextTransform = "none", FontWeight = "600", FontSize = "0.875rem" }
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#3F51B5", // Vibrant Indigo Blue from layout
            Secondary = "#757575",
            Success = "#4CAF50",
            Info = "#2196F3",
            Warning = "#FFC107",
            Error = "#F44336",
            AppbarBackground = "#3F51B5",
            Background = "#F5F7FA", // Light greyish background
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            TextPrimary = "#212121",
            TextSecondary = "#757575",
            ActionDefault = "#757575",
            Divider = "#E0E0E0"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#4da3ff",
            Secondary = "#adb5bd",
            Success = "#34ce57",
            Info = "#2dbbd2",
            Warning = "#ffcd39",
            Error = "#e35d6a",
            AppbarBackground = "#1A2238", // ASPEC Dark Blue
            Background = "#121212",
            Surface = "#1e1e1e",
            DrawerBackground = "#1e1e1e",
            TextPrimary = "#FFFFFF", // Increased contrast
            TextSecondary = "#B0BEC5", // Improved readability
            ActionDefault = "#4da3ff", // Match primary for better visibility in dark mode
            Divider = "rgba(255, 255, 255, 0.12)"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        ToastService.OnShow += HandleToastShow;
        appState.OnChange += HandleAppStateChange;
        Navigation.LocationChanged += HandleLocationChanged;

        UpdateActiveTab();

        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading theme: {ex.Message}");
        }

        try
        {
            await UpdateSyncCount();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error updating sync count: {ex.Message}");
            appState.PendingSyncCount = 0;
        }

        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                appState.CurrentUnitId = user.CurrentUnitId;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting current user: {ex.Message}");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(() =>
        {
            UpdateActiveTab();
            StateHasChanged();
        });
    }

    private void HandleAppStateChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleToastShow(string message, string type)
    {
        InvokeAsync(() => ShowSnackbar(message, type));
    }

    private void UpdateActiveTab()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        if (string.IsNullOrEmpty(relativePath) || relativePath == "home") activeTab = "home";
        else if (relativePath == "sync") activeTab = "sync";
        else activeTab = ""; 

        if (relativePath != "camera" && appState.IsCameraActive)
        {
            appState.IsCameraActive = false;
        }
    }

    private async Task UpdateSyncCount()
    {
        try
        {
            var items = await DbService.GetAllAsync<InventoryItem>("items");
            appState.PendingSyncCount = items.Count(i => !i.Synced);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting items for sync count: {ex.Message}");
            appState.PendingSyncCount = 0;
        }
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private async Task ToggleTheme()
    {
        appState.IsDarkMode = !appState.IsDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", appState.IsDarkMode ? "dark" : "light");
    }

    private void ShowSnackbar(string message, string type)
    {
        try
        {
            Severity severity = type switch
            {
                "success" => Severity.Success,
                "error" => Severity.Error,
                "warning" => Severity.Warning,
                "info" => Severity.Info,
                _ => Severity.Normal
            };
            Snackbar.Add(message, severity);
        }
        catch { }
    }

    private void HandleTabChanged(string tab)
    {
        activeTab = tab;
        if (tab == "home") Navigation.NavigateTo("/home");
        else if (tab == "sync") Navigation.NavigateTo("/sync");
    }

    private void HandleCaptureClick()
    {
        Navigation.NavigateTo("/camera?mode=photo");
    }

    private void HandleUnitSelected(int unitId)
    {
        appState.CurrentUnitId = unitId;
    }

    public void Dispose()
    {
        ToastService.OnShow -= HandleToastShow;
        appState.OnChange -= HandleAppStateChange;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
