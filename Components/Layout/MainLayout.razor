    private void UpdateActiveTab()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        if (string.IsNullOrEmpty(relativePath) || relativePath == "home") activeTab = "home";
        else if (relativePath == "stats") activeTab = "stats";
        else if (relativePath == "sync") activeTab = "sync";
        else activeTab = ""; // Other pages might not have a tab

        // If we navigate away from camera, ensure IsCameraActive is false
        if (relativePath != "camera" && appState.IsCameraActive)
        {
            // Note: Camera page usually handles this in Dispose, 
            // but this is a safety net for "stuck" state.
            appState.IsCameraActive = false;
        }
    }

    private async Task UpdateSyncCount()
    {
        try
        {
            var items = await DbService.GetAllAsync<InventoryItem>("items");
            appState.PendingSyncCount = items.Count(i => !i.Synced);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting items for sync count: {ex.Message}");
            appState.PendingSyncCount = 0;
        }
    }

