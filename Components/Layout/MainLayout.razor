    private async Task ExportDataAsync()
    {
        try
        {
            var items = await DbService.GetAllAsync<InventoryItem>("items");
            var csv = GenerateCsv(items);
            await DownloadCsv(csv, "inventory_export.csv");
            ShowToast("Dados exportados com sucesso!", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"Erro ao exportar dados: {ex.Message}", "error");
        }
    }

    private string GenerateCsv(IEnumerable<InventoryItem> items)
    {
        var csv = new StringBuilder();
        csv.AppendLine("ID,Nome,Código,Categoria,Localização,Observações,Data de Criação,Sincronizado,Unidade");

        foreach (var item in items)
        {
            csv.AppendLine($"{item.Id},{item.Name},{item.Code},{item.Category},{item.Location},{item.Observations},{item.Timestamp:yyyy-MM-dd HH:mm:ss},{item.Synced},{item.UnitId}");
        }

        return csv.ToString();
    }

    private async Task DownloadCsv(string csvContent, string fileName)
    {
        var bytes = Encoding.UTF8.GetBytes(csvContent);
        await JSRuntime.InvokeVoidAsync("appInterop.downloadFile", fileName, Convert.ToBase64String(bytes));
    }

