@inherits LayoutComponentBase
@implements IDisposable
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject AppState appState
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@using System.Text
@using MudBlazor
@inject ISnackbar Snackbar

<MudThemeProvider Theme="currentTheme" @bind-IsDarkMode="appState.IsDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="2" Color="Color.Primary" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleMenu" />
        <MudImage Src="images/aspec_logo.png" Alt="Aspec Capture" Width="32" Height="32" Class="mr-2 ml-3" Style="border-radius: 4px;"/>
        <MudText Typo="Typo.h6">Aspec Capture</MudText>
        <MudSpacer />
    </MudAppBar>

    <MudDrawer @bind-Open="isMenuOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu OnThemeToggle="ToggleTheme" OnUnitSelected="HandleUnitSelected" />
    </MudDrawer>

    <MudMainContent Class="mud-width-full" Style="padding-bottom: 80px; min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>

    @if (!appState.IsCameraActive)
    {
        <Footer ActiveTab="@activeTab" PendingSyncCount="@appState.PendingSyncCount" OnTabChanged="HandleTabChanged"
            OnCaptureClick="HandleCaptureClick" OnExportClick="HandleExportClick" />
    }
</MudLayout>

@code {
    private bool isMenuOpen = false;
    private string activeTab = "home";

    // ASPEC Identity Theme Configuration
    // ASPEC Identity Theme Configuration
    private MudTheme currentTheme = new MudTheme()
    {
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px",
            DrawerWidthLeft = "260px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Outfit", "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#0066CC", // ASPEC Corporate Blue
            Secondary = "#004C99",
            AppbarBackground = "#003366", // Darker Blue for Header
            Background = "#F5F7FA", // Very light blue-gray
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#2C3E50",
            TextSecondary = "#7F8C8D",
            ActionDefault = "#0066CC"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#4A90E2", // Lighter Blue for Dark Mode
            Secondary = "#64B5F6",
            AppbarBackground = "#1A2238", // Dark Blue-Black
            Background = "#121212",
            Surface = "#1E1E1E",
            DrawerBackground = "#1E1E1E",
            TextPrimary = "#E0E0E0",
            TextSecondary = "#B0BEC5",
            ActionDefault = "#4A90E2"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        ToastService.OnShow += ShowToast;
        appState.OnChange += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;

        UpdateActiveTab();

        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading theme: {ex.Message}");
        }

        try
        {
            await UpdateSyncCount();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error updating sync count: {ex.Message}");
            appState.PendingSyncCount = 0;
        }

        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                appState.CurrentUnitId = user.CurrentUnitId;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting current user: {ex.Message}");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActiveTab();
        StateHasChanged();
    }

    private void UpdateActiveTab()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        if (string.IsNullOrEmpty(relativePath) || relativePath == "home") activeTab = "home";
        else if (relativePath == "stats") activeTab = "stats";
        else if (relativePath == "sync") activeTab = "sync";
        else activeTab = ""; // Other pages might not have a tab

        // If we navigate away from camera, ensure IsCameraActive is false
        if (relativePath != "camera" && appState.IsCameraActive)
        {
            // Note: Camera page usually handles this in Dispose, 
            // but this is a safety net for "stuck" state.
            appState.IsCameraActive = false;
        }
    }

    private async Task UpdateSyncCount()
    {
        try
        {
            var items = await DbService.GetAllAsync<InventoryItem>("items");
            appState.PendingSyncCount = items.Count(i => !i.Synced);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error getting items for sync count: {ex.Message}");
            appState.PendingSyncCount = 0;
        }
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private async Task ToggleTheme()
    {
        appState.IsDarkMode = !appState.IsDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", appState.IsDarkMode ? "dark" : "light");
    }

    private void ShowToast(string message, string type)
    {
        Severity severity = type switch
        {
            "success" => Severity.Success,
            "error" => Severity.Error,
            "warning" => Severity.Warning,
            "info" => Severity.Info,
            _ => Severity.Normal
        };
        Snackbar.Add(message, severity);
    }

    private void HandleTabChanged(string tab)
    {
        activeTab = tab;
        if (tab == "home") Navigation.NavigateTo("/home");
        else if (tab == "stats") Navigation.NavigateTo("/stats");
        else if (tab == "sync") Navigation.NavigateTo("/sync");
    }

    private void HandleCaptureClick()
    {
        Navigation.NavigateTo("/camera");
    }

    private async Task HandleExportClick()
    {
        await ExportDataAsync();
    }

    private void HandleUnitSelected(int unitId)
    {
        appState.CurrentUnitId = unitId;
        // appState.OnChange will trigger re-renders in listening components
    }

    private async Task ExportDataAsync()
    {
        try
        {
            var items = await DbService.GetAllAsync<InventoryItem>("items");
            var csv = GenerateCsv(items);
            await DownloadCsv(csv, "inventory_export.csv");
            ShowToast("Dados exportados com sucesso!", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"Erro ao exportar dados: {ex.Message}", "error");
        }
    }

    private string GenerateCsv(IEnumerable<InventoryItem> items)
    {
        var csv = new StringBuilder();
        csv.AppendLine("ID,Nome,Código,Categoria,Localização,Observações,Data de Criação,Sincronizado,Unidade");

        foreach (var item in items)
        {
            csv.AppendLine($"{item.Id},{item.Name},{item.Code},{item.Category},{item.Location},{item.Observations},{item.Timestamp:yyyy-MM-dd HH:mm:ss},{item.Synced},{item.UnitId}");
        }

        return csv.ToString();
    }

    private async Task DownloadCsv(string csvContent, string fileName)
    {
        var bytes = Encoding.UTF8.GetBytes(csvContent);
        await JSRuntime.InvokeVoidAsync("appInterop.downloadFile", fileName, Convert.ToBase64String(bytes));
    }

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
        appState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
