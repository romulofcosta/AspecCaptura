@inherits LayoutComponentBase
@implements IDisposable
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject AppState appState
@inject IIndexedDbService DbService
@inject IAuthService AuthService

<div class="app-container">
    <Header OnToggleMenu="ToggleMenu" />

    <NavMenu IsOpen="isMenuOpen" OnClose="ToggleMenu" OnUnitSelected="HandleUnitSelected" />

    <main class="main-content">
        @Body
    </main>

    <Footer ActiveTab="@activeTab" PendingSyncCount="@appState.PendingSyncCount" OnTabChanged="HandleTabChanged"
        OnCaptureClick="HandleCaptureClick" />

    <Toast @ref="toastComponent" />
</div>

@code {
    private bool isMenuOpen = false;
    private string activeTab = "home";
    private Toast? toastComponent;

    protected override async Task OnInitializedAsync()
    {
        ToastService.OnShow += ShowToast;
        appState.OnChange += StateHasChanged;

        await UpdateSyncCount();

        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            appState.CurrentUnitId = user.CurrentUnitId;
        }
    }

    private async Task UpdateSyncCount()
    {
        var items = await DbService.GetAllAsync<InventoryItem>("items");
        appState.PendingSyncCount = items.Count(i => !i.Synced);
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void ShowToast(string message, string type)
    {
        toastComponent?.Show(message, type);
    }

    private void HandleTabChanged(string tab)
    {
        activeTab = tab;
        if (tab == "home") Navigation.NavigateTo("/");
        else if (tab == "stats") Navigation.NavigateTo("/stats");
        else if (tab == "sync") Navigation.NavigateTo("/sync");
    }

    private void HandleCaptureClick()
    {
        Navigation.NavigateTo("/camera");
    }

    private void HandleUnitSelected(int unitId)
    {
        appState.CurrentUnitId = unitId;
        // appState.OnChange will trigger re-renders in listening components
    }

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
        appState.OnChange -= StateHasChanged;
    }
}
