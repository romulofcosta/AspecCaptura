@namespace AspecCaptura.Components.Layout
@inject NavigationManager Navigation

<nav class="bottom-nav">
    <a href="/camera" class="nav-item nav-item-scan @(GetActiveClass("/camera"))" aria-label="Capturar" @onclick='() => NavigateTo("/camera")' @onclick:preventDefault="true">
        <span class="material-symbols-outlined">qr_code_scanner</span>
        <span class="nav-label">SCAN</span>
    </a>
    
    <a href="/" class="nav-item @(GetActiveClass("/items"))" @onclick='() => NavigateTo("/")' @onclick:preventDefault="true">
        <span class="material-symbols-outlined">assignment</span>
        <span class="nav-label">LISTA</span>
    </a>
    
    <a href="/sync" class="nav-item @(GetActiveClass("/sync"))" @onclick='() => NavigateTo("/sync")' @onclick:preventDefault="true">
        <div class="icon-wrapper">
            <span class="material-symbols-outlined">sync</span>
            @if (PendingSyncCount > 0)
            {
                <span class="sync-badge">@PendingSyncCount</span>
            }
        </div>
        <span class="nav-label">SINC</span>
    </a>
    
    <a href="/settings" class="nav-item @(GetActiveClass("/settings"))" @onclick='() => NavigateTo("/settings")' @onclick:preventDefault="true">
        <span class="material-symbols-outlined">settings</span>
        <span class="nav-label">AJUSTES</span>
    </a>
</nav>

@code {
    [Parameter] public int PendingSyncCount { get; set; } = 0;

    private void NavigateTo(string href) => Navigation.NavigateTo(href);

    private string GetActiveClass(string href)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var current = "/" + relativePath;
        if (current == "/") current = "/items";
        return current.StartsWith(href) ? "active" : "";
    }
}
