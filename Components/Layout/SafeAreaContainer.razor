@namespace pwa_camera_poc_blazor.Components.Layout

<div class="min-h-screen flex flex-col pt-safe">
    <div class="@GetContentClasses()">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IncludeBottomNav { get; set; } = true;

    private string GetContentClasses()
    {
        var classes = new List<string>
        {
            "flex-1",
            "overflow-y-auto"
        };

        if (IncludeBottomNav)
        {
            classes.Add("pb-20");
        }
        else
        {
            classes.Add("pb-safe");
        }

        return string.Join(" ", classes);
    }
}
