@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState appState

<div id="menu-backdrop" class="menu-backdrop @(IsOpen && !appState.IsCameraActive ? "" : "hidden")" @onclick="Close"></div>
<aside id="app-menu" class="app-menu @(IsOpen && !appState.IsCameraActive ? "" : "hidden")">
    <div class="menu-header">
        <div class="menu-user-info">
            <span class="user-avatar">👤</span>
            <span id="menu-username">@Username</span>
        </div>
        <button id="close-menu-btn" class="icon-btn secondary" @onclick="Close">✕</button>
    </div>

    <div class="menu-items">
        @if (units != null && units.Any())
        {
            <div class="form-group" style="padding: 0 0.5rem;">
                <label for="menu-unit-select"
                    style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">Unidade Atual</label>
                <select id="menu-unit-select" class="form-select" style="width: 100%; padding: 0.5rem;"
                @onchange="OnUnitChanged" value="@selectedUnitId">
                    @foreach (var unit in units)
                    {
                        <option value="@unit.Id">@unit.Name</option>
                    }
                </select>
            </div>
        }

        <div class="menu-divider"></div>

        <button id="menu-theme-btn" class="menu-item-btn" @onclick="ToggleTheme">
            <span class="icon" id="menu-theme-icon">
                @if (isDarkMode)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path
                            d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                }
            </span>
            Alternar Tema
        </button>

        <button id="menu-logout-btn" class="menu-item-btn text-danger" @onclick="HandleLogout">
            <span class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 17l5-5-5-5" />
                    <path d="M15 12H3" />
                    <path d="M21 21V3h-6" />
                </svg>
            </span>
            Sair
        </button>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnUnitSelected { get; set; }

    private string Username = "Usuário";
    private List<Unit> units = new();
    private int selectedUnitId;
    private bool isDarkMode = false;
    private User? currentUser;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && units.Count == 0)
        {
            await LoadUserData();
        }

        var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
        isDarkMode = theme == "dark";
    }

    private async Task LoadUserData()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            Username = currentUser.Username;
            selectedUnitId = currentUser.CurrentUnitId ?? 0;

            units.Clear();
            foreach (var id in currentUser.UnitIds)
            {
                var unit = await DbService.GetAsync<Unit>("units", id);
                if (unit != null) units.Add(unit);
            }
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task OnUnitChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedUnitId = id;
            if (currentUser != null)
            {
                currentUser.CurrentUnitId = id;
                await DbService.UpdateAsync("users", currentUser);
            }
            await OnUnitSelected.InvokeAsync(id);
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", isDarkMode ? "dark" : "light");
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
