@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState

<MudDrawerHeader Class="d-flex flex-column align-center pa-6"
    Style="background-color: var(--mud-palette-background-grey);">
    <div class="cursor-pointer d-flex flex-column align-center profile-section"
        style="width: 100%; max-width: 200px; overflow: hidden;" @onclick="NavigateToProfile">
        <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mb-3 shadow-md border-white border-2 profile-avatar">
            @UserInitials
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-truncate" Style="max-width: 100%">@DisplayName
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-n1 text-truncate" Style="max-width: 100%">
            @EmailDisplay</MudText>
    </div>
</MudDrawerHeader>

<MudNavMenu>
    <div class="pa-4 d-flex flex-column gap-1">
        <MudText Typo="Typo.caption" Color="Color.Secondary">Sessão Atual</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@(appState.CurrentUO?.NomeUO ?? "Sessão não configurada")
        </MudText>
    </div>

    <MudDivider Class="my-2" />

    <div class="mud-nav-link mud-ripple py-3 px-4 d-flex align-center cursor-pointer" @onclick="ToggleTheme">
        <MudIcon Icon="@Icons.Material.Filled.BrightnessMedium" Color="Color.Default" Class="mr-3" />
        <MudText>Alternar Tema</MudText>
    </div>

    <MudNavLink Href="/tombamentos-sync" Class="mud-nav-link mud-ripple py-3 px-4 d-flex align-center" Match="NavLinkMatch.All">
        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Color="Color.Default" Class="mr-3" />
        <MudText>Sincronizar Tombamentos</MudText>
    </MudNavLink>

    <div class="mud-nav-link mud-ripple py-3 px-4 d-flex align-center cursor-pointer" @onclick="HandleLogout">
        <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Error" Class="mr-3" />
        <MudText>Sair</MudText>
    </div>
</MudNavMenu>

@code {
    [Parameter] public EventCallback<int> OnUnitSelected { get; set; }
    [Parameter] public EventCallback OnThemeToggle { get; set; }
    [Parameter] public EventCallback OnMenuItemClick { get; set; }

    private string UserInitials = "U";
    private string DisplayName = "Usuário";
    private string EmailDisplay = "";
    private Usuario? currentUser;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            EmailDisplay = currentUser.UsuarioNome;
            DisplayName = currentUser.NomeCompleto;

            if (!string.IsNullOrEmpty(currentUser.NomeCompleto))
            {
                var names = currentUser.NomeCompleto.Split(' ');
                UserInitials = names.Length > 1
                ? $"{names[0][0]}{names[^1][0]}".ToUpper()
                : names[0][0].ToString().ToUpper();
            }
            else
            {
                UserInitials = currentUser.UsuarioNome.Substring(0, 1).ToUpper();
            }
        }
        else
        {
            DisplayName = "Usuário";
            EmailDisplay = "";
        }
    }

    private async Task ToggleTheme()
    {
        await OnThemeToggle.InvokeAsync();
        await OnMenuItemClick.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task NavigateToProfile()
    {
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/profile");
    }
}
