@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState

<MudDrawerHeader Class="nav-header">
    <div class="profile-section cursor-pointer" tabindex="0" @onclick="NavigateToProfile" @onkeypress="@((e) => { if (e.Key == "Enter") NavigateToProfile(); })">
        <MudAvatar Color="Color.Primary" Size="Size.Large" Class="profile-avatar">
            @UserInitials
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-truncate-max">@DisplayName</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate-max">@EmailDisplay</MudText>
    </div>
</MudDrawerHeader>

<MudNavMenu>
    @if (units != null && units.Any())
    {
        <div class="nav-unit-selector">
            <MudSelect T="int" Label="Unidade Atual" Value="@selectedUnitId" ValueChanged="OnUnitChanged"
                Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="rounded-md">
                @foreach (var unit in units)
                {
                    <MudSelectItem Value="@unit.Id">@unit.Nome</MudSelectItem>
                }
            </MudSelect>
        </div>
    }

    <MudDivider Class="my-2" />
    
    <div class="nav-theme-toggle">
        <div class="nav-menu-item cursor-pointer" tabindex="0" @onclick="ToggleTheme" @onkeypress="@((e) => { if (e.Key == "Enter") ToggleTheme(); })">
            <MudIcon Icon="@Icons.Material.Filled.BrightnessMedium" Color="Color.Default" Class="mr-3" />
            <MudText>Alternar Tema</MudText>
        </div>
    </div>

    <div class="nav-logout">
        <div class="nav-menu-item cursor-pointer" tabindex="0" @onclick="HandleLogout" @onkeypress="@((e) => { if (e.Key == "Enter") HandleLogout(); })">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Error" Class="mr-3" />
            <MudText>Sair</MudText>
        </div>
    </div>

    <div class="version-info">
        <MudText Typo="Typo.caption" Color="Color.Secondary">Aspec Capture v1.5.0</MudText>
        <MudText Typo="Typo.caption">(UI/UX Overhaul)</MudText>
    </div>
</MudNavMenu>

@code {
    [Parameter] public EventCallback<int> OnUnitSelected { get; set; }
    [Parameter] public EventCallback OnThemeToggle { get; set; }
    [Parameter] public EventCallback OnMenuItemClick { get; set; }

    private string UserInitials = "U";
    private string DisplayName = "Usuário";
    private string EmailDisplay = "";
    private List<UnidadeGestora> units = new();
    private int selectedUnitId;
    private Usuario? currentUser;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        if (!DbService.IsInitialized) await DbService.InitAsync();
        
        // Ensure some basic data exists if DB is empty (e.g. for admin user)
        var existingStates = await DbService.GetAllAsync<Estado>("states");
        if (!existingStates.Any())
        {
            await SeedBasicData();
        }
        else 
        {
            // Even if states exist, ensure basic units are present (for existing users after updates)
            await EnsureUnitsExist();
        }

        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            EmailDisplay = currentUser.NomeUsuario;
            
            if (!string.IsNullOrEmpty(currentUser.PrimeiroNome))
            {
                DisplayName = $"{currentUser.PrimeiroNome} {currentUser.UltimoNome}";
                UserInitials = $"{currentUser.PrimeiroNome[0]}{(string.IsNullOrEmpty(currentUser.UltimoNome) ? "" : currentUser.UltimoNome[0].ToString())}".ToUpper();
            }
            else
            {
                DisplayName = "Usuário";
                UserInitials = currentUser.NomeUsuario.Substring(0, 1).ToUpper();
            }

            selectedUnitId = currentUser.UnidadeGestoraAtualId ?? 0;

            units.Clear();
            var distinctIds = currentUser.IdsUnidadesGestoras.Distinct().ToList();
            foreach (var id in distinctIds)
            {
                var unit = await DbService.GetAsync<UnidadeGestora>("units", id);
                if (unit != null) units.Add(unit);
            }

            // Fallback for ID only display problem if units are still missing
            if (selectedUnitId > 0 && !units.Any(u => u.Id == selectedUnitId))
            {
                var unit = await DbService.GetAsync<UnidadeGestora>("units", selectedUnitId);
                if (unit != null) 
                {
                    units.Add(unit);
                }
                else
                {
                    units.Add(new UnidadeGestora { Id = selectedUnitId, Nome = $"Unidade {selectedUnitId}" });
                }
            }
        }
        else
        {
            DisplayName = "Usuário";
            EmailDisplay = "";
            units.Clear();
            selectedUnitId = 0;
        }
    }

    private async Task SeedBasicData()
    {
        try {
            await EnsureUnitsExist();
        } catch { }
    }

    private async Task EnsureUnitsExist()
    {
        // States
        if (await DbService.GetAsync<Estado>("states", "CE") == null)
            await DbService.AddAsync("states", new Estado { Id = "CE", Nome = "Ceará" });
        if (await DbService.GetAsync<Estado>("states", "RN") == null)
            await DbService.AddAsync("states", new Estado { Id = "RN", Nome = "Rio Grande do Norte" });
        if (await DbService.GetAsync<Estado>("states", "PA") == null)
            await DbService.AddAsync("states", new Estado { Id = "PA", Nome = "Pará" });
        if (await DbService.GetAsync<Estado>("states", "MA") == null)
            await DbService.AddAsync("states", new Estado { Id = "MA", Nome = "Maranhão" });
        
        // Cities
        if (await DbService.GetAsync<Cidade>("cities", 5) == null)
            await DbService.AddAsync("cities", new Cidade { Id = 5, EstadoId = "CE", Nome = "Horizonte" });
        if (await DbService.GetAsync<Cidade>("cities", 4) == null)
            await DbService.AddAsync("cities", new Cidade { Id = 4, EstadoId = "MA", Nome = "São Luís" });
        
        // Units
        if (await DbService.GetAsync<UnidadeGestora>("units", 1) == null)
            await DbService.AddAsync("units", new UnidadeGestora { Id = 1, CidadeId = 5, Nome = "Prefeitura Municipal de Horizonte" });
        if (await DbService.GetAsync<UnidadeGestora>("units", 2) == null)
            await DbService.AddAsync("units", new UnidadeGestora { Id = 2, CidadeId = 5, Nome = "Fundo Municipal de Saúde" });
        if (await DbService.GetAsync<UnidadeGestora>("units", 6) == null)
            await DbService.AddAsync("units", new UnidadeGestora { Id = 6, CidadeId = 4, Nome = "Prefeitura de São Luís" });
    }

    private async Task OnUnitChanged(int id)
    {
        selectedUnitId = id;
        if (currentUser != null)
        {
            currentUser.UnidadeGestoraAtualId = id;
            await AuthService.UpdateUserAsync(currentUser);
        }
        await OnUnitSelected.InvokeAsync(id);
    }

    private async Task ToggleTheme()
    {
        await OnThemeToggle.InvokeAsync();
        await OnMenuItemClick.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.DesconectarAsync();
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task NavigateToProfile()
    {
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/profile");
    }
}
