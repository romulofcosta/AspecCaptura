@inject IAuthService AuthService
@inject pwa_camera_poc_blazor.Services.Storage.IIndexedDbService DbService

<div style="display: flex; flex-direction: column; padding: 24px; background-color: #f1f5f9; align-items: center; border-bottom: 1px solid #e2e8f0;">
    <div style="cursor: pointer; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 200px; overflow: hidden;" @onclick="NavigateToProfile">
        <div style="border-radius: 50%; background: #003366; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; width: 64px; height: 64px; margin-bottom: 12px; border: 2px solid white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            @UserInitials
        </div>
        <div style="font-weight: bold; font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">@DisplayName</div>
        <div style="font-size: 12px; color: #64748b; margin-top: -4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;">@EmailDisplay</div>
    </div>
</div>

<nav style="display: flex; flex-direction: column;">
    <div style="padding: 16px; display: flex; flex-direction: column; gap: 4px;">
        <span style="font-size: 12px; color: #64748b;">Sessão Atual</span>
        <span style="font-size: 14px; color: #475569;">@(appState.CurrentUO?.NomeUO ?? "Sessão não configurada")</span>
    </div>

    <hr style="margin: 8px 0; border: none; border-top: 1px solid #e2e8f0;" />

    <div style="padding: 12px 16px; display: flex; align-items: center; cursor: pointer; transition: background 0.2s;" class="hover-bg-gray-100" @onclick="ToggleTheme">
        <span class="material-symbols-outlined" style="margin-right: 12px; color: #475569;">brightness_medium</span>
        <span style="font-size: 14px; color: #1e293b;">Alternar Tema</span>
    </div>

    <a href="/tombamentos-sync" style="padding: 12px 16px; display: flex; align-items: center; text-decoration: none; transition: background 0.2s;" class="hover-bg-gray-100">
        <span class="material-symbols-outlined" style="margin-right: 12px; color: #475569;">cloud_download</span>
        <span style="font-size: 14px; color: #1e293b;">Sincronizar Tombamentos</span>
    </a>

    <div style="padding: 12px 16px; display: flex; align-items: center; cursor: pointer; transition: background 0.2s;" class="hover-bg-gray-100" @onclick="HandleLogout">
        <span class="material-symbols-outlined" style="margin-right: 12px; color: #ef4444;">logout</span>
        <span style="font-size: 14px; color: #1e293b;">Sair</span>
    </div>
</nav>

@code {
    [Parameter] public EventCallback<int> OnUnitSelected { get; set; }
    [Parameter] public EventCallback OnThemeToggle { get; set; }
    [Parameter] public EventCallback OnMenuItemClick { get; set; }

    private string UserInitials = "U";
    private string DisplayName = "Usuário";
    private string EmailDisplay = "";
    private pwa_camera_poc_blazor.Models.Usuario? currentUser;

    protected override async Task OnParametersSetAsync()
    {
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            EmailDisplay = currentUser.UsuarioNome;
            DisplayName = currentUser.NomeCompleto;

            if (!string.IsNullOrEmpty(currentUser.NomeCompleto))
            {
                var names = currentUser.NomeCompleto.Split(' ');
                UserInitials = names.Length > 1
                ? $"{names[0][0]}{names[^1][0]}".ToUpper()
                : names[0][0].ToString().ToUpper();
            }
            else
            {
                UserInitials = currentUser.UsuarioNome.Substring(0, 1).ToUpper();
            }
        }
        else
        {
            DisplayName = "Usuário";
            EmailDisplay = "";
        }
    }

    private async Task ToggleTheme()
    {
        await OnThemeToggle.InvokeAsync();
        await OnMenuItemClick.InvokeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task NavigateToProfile()
    {
        await OnMenuItemClick.InvokeAsync();
        Navigation.NavigateTo("/profile");
    }
}
