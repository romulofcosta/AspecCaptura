@inherits LayoutComponentBase
@implements IDisposable
@inject AspecCaptura.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject AppState appState
@inject IJSRuntime JSRuntime
@inject ILogger<MinimalLayout> Logger
@using System.Diagnostics.CodeAnalysis

<style>
    /* Global Minimal Styles */
    body {
        background: #FFFFFF;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        min-height: 100dvh;
        overflow-x: hidden;
    }
    
    .app-viewport {
        min-height: 100vh;
        min-height: 100dvh;
        background-color: #FFFFFF;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .mobile-frame {
        width: 100%;
        max-width: 480px;
        background: #FFFFFF;
        min-height: 100vh;
        min-height: 100dvh;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
    }

    .minimal-page {
        background: #F8FAFC;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding-bottom: calc(100px + env(safe-area-inset-bottom));
        width: 100%;
    }
    
    .minimal-header {
        background: white;
        padding: 56px 24px 24px;
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid #F1F5F9;
    }
    
    .minimal-card {
        border: 1px solid #E2E8F0;
        background: white;
        box-shadow: none;
        border-radius: 16px;
    }
    
    .stat-card {
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
    
    .stat-label {
        font-size: 10px;
        text-transform: uppercase;
        color: #94A3B8;
        font-weight: 700;
        letter-spacing: 0.1em;
        margin-bottom: 4px;
    }
    
    .stat-value {
        font-size: 20px;
        font-weight: 700;
    }
    
    .search-minimal {
        background: #F8FAFC;
        border: none;
        border-radius: 9999px;
        padding: 12px 20px 12px 44px;
        font-size: 14px;
        width: 100%;
    }
    
    .search-minimal:focus {
        outline: none;
        box-shadow: 0 0 0 1px rgba(0, 51, 102, 0.2);
    }
    
    .btn-primary-minimal {
        background: #003366;
        color: white;
        padding: 16px 24px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        border: none;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.05em;
        transition: transform 0.2s ease;
    }
    
    .btn-primary-minimal:active {
        transform: scale(0.98);
    }
    
    .btn-secondary-minimal {
        background: #F8FAFC;
        color: #003366;
        padding: 12px 20px;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        cursor: pointer;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    
    .btn-secondary-minimal:hover {
        background: #F1F5F9;
        border-color: #CBD5E1;
    }
    
    .item-card-minimal {
        border: 1px solid #E2E8F0;
        background: white;
        padding: 16px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .item-card-minimal:hover {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transform: translateY(-1px);
    }
    
    .section-title {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #1E293B;
        margin-bottom: 20px;
    }
    
    .icon-box {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: #F8FAFC;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .context-info {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 0;
    }
    
    .context-text {
        font-size: 12px;
        font-weight: 500;
        color: #64748B;
    }
    
    .btn-change {
        font-size: 10px;
        font-weight: 700;
        color: #003366;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: none;
        border: none;
        cursor: pointer;
    }
    
    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1E293B;
        margin-bottom: 8px;
    }
    
    .page-subtitle {
        font-size: 14px;
        color: #64748B;
        margin-bottom: 32px;
    }
    
    /* Bottom Navigation */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border-top: 1px solid #F1F5F9;
        padding: 16px 24px;
        padding-bottom: calc(16px + env(safe-area-inset-bottom, 24px));
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 50;
        gap: 16px;
    }
    
    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        color: #94A3B8;
        transition: color 0.2s ease;
        flex: 1;
        justify-content: center;
        padding: 8px 12px;
    }
    
    .nav-item.active {
        color: #003366;
    }
    
    .nav-label {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
    
    /* Universal Material Icon Styles */
    .material-symbols-outlined,
    .material-icons,
    .material-icons-outlined {
        font-family: 'Material Symbols Outlined', 'Material Icons Outlined', 'Material Icons' !important;
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        line-height: 1;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        -moz-osx-font-smoothing: grayscale;
        font-feature-settings: 'liga';
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    
    /* Form Styles */
    .form-group {
        margin-bottom: 20px;
    }
    
    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
        display: block;
    }
    
    .form-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 14px;
        background: white;
        transition: all 0.2s ease;
    }
    
    .form-input:focus {
        outline: none;
        border-color: #003366;
        box-shadow: 0 0 0 3px rgba(0, 51, 102, 0.1);
    }
    
    /* Responsive */
    @@media (max-width: 640px) {
        .minimal-header {
            padding: 48px 20px 20px;
        }
        
        .minimal-page {
            padding-bottom: calc(100px + env(safe-area-inset-bottom));
        }
        
        .bottom-nav {
            padding: 12px 20px;
            padding-bottom: calc(12px + env(safe-area-inset-bottom, 20px));
        }
    }
</style>

<!-- Main Content with Mobile Frame -->
<div class="app-viewport">
    <div class="mobile-frame">
        <div class="minimal-page">
            @Body
        </div>


    </div>
</div>

@code {
    // Construtor público explícito para evitar problemas com IL trimming
    public MinimalLayout()
    {
        // Construtor vazio necessário para instanciação do Blazor
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("MinimalLayout initialized");
            ToastService.OnShow += HandleToastShow;
            appState.OnChange += HandleAppStateChange;
            Navigation.LocationChanged += HandleLocationChanged;

            // Load saved app state
            await appState.LoadStateAsync();

            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
            Logger.LogInformation($"Theme loaded: {theme}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading theme, using default");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Logger.LogDebug($"Location changed to: {e.Location}");
        InvokeAsync(StateHasChanged);
    }

    private void HandleAppStateChange()
    {
        Logger.LogDebug("App state changed");
        InvokeAsync(StateHasChanged);
    }

    private void HandleToastShow(string message, string type)
    {
        Logger.LogInformation($"Toast shown: {type} - {message}");
        InvokeAsync(() => ShowToast(message, type));
    }

    private async Task ShowToast(string message, string type)
    {
        try
        {
            var colorClass = type switch
            {
                "success" => "bg-green-500",
                "error" => "bg-red-500",
                "warning" => "bg-yellow-500",
                "info" => "bg-blue-500",
                _ => "bg-gray-500"
            };
            
            await JSRuntime.InvokeVoidAsync("eval", $@"
                const container = document.getElementById('toast-container') || (() => {{
                    const c = document.createElement('div');
                    c.id = 'toast-container';
                    c.className = 'fixed top-20 right-4 z-50 space-y-2';
                    document.body.appendChild(c);
                    return c;
                }})();
                const toast = document.createElement('div');
                toast.className = '{colorClass} text-white px-4 py-3 rounded-lg shadow-lg flex items-center gap-2';
                toast.innerHTML = '<span>{message}</span>';
                container.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            ");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error showing toast");
        }
    }



    public void Dispose()
    {
        try
        {
            ToastService.OnShow -= HandleToastShow;
            appState.OnChange -= HandleAppStateChange;
            Navigation.LocationChanged -= HandleLocationChanged;
            Logger.LogInformation("MinimalLayout disposed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error disposing MinimalLayout");
        }
    }
}