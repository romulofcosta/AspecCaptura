@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject AppState appState
@implements IDisposable

<div class="min-h-screen bg-surface flex items-center justify-center p-4 sm:p-10">
    <div class="fixed top-4 right-6 z-50">
        <button @onclick="ToggleTheme" 
                class="p-2 rounded-full bg-surface-container border border-outline shadow-sm hover:bg-surface-container-high transition-colors"
                aria-label="Toggle theme">
            <span class="material-symbols-outlined text-on-surface">brightness_medium</span>
        </button>
    </div>
    
    <div class="w-full">
        @Body
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleAppStateChange;

        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading theme in AuthLayout: {ex.Message}");
        }
    }

    public void Dispose()
    {
        appState.OnChange -= HandleAppStateChange;
    }

    private void HandleAppStateChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        try
        {
            appState.IsDarkMode = !appState.IsDarkMode;
            await JSRuntime.InvokeVoidAsync("appInterop.setTheme", appState.IsDarkMode ? "dark" : "light");
        }
        catch { }
    }
}
