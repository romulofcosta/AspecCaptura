@namespace pwa_camera_poc_blazor.Components.Cards
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Services.Utils

<article class="item-card" @onclick="HandleClick" role="button" tabindex="0">
    <div class="card-accent @AccentClass"></div>
    <div class="card-body">
        <div class="card-row card-meta-row">
            <span class="code-tag">@Item.Nutomb</span>
            <span class="status-badge @BadgeClass">@StateLabel</span>
        </div>

        <p class="card-name">@Item.Deprod</p>

        <div class="card-location">
            <span class="material-symbols-outlined loc-icon">location_on</span>
            <span class="loc-text">@LocationText</span>
        </div>
    </div>

    <div class="card-chevron">
        <span class="material-symbols-outlined">chevron_right</span>
    </div>
</article>

<style>
    .item-card {
        display: flex;
        align-items: stretch;
        background: #fff;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: box-shadow 0.15s, transform 0.15s;
        user-select: none;
    }

    .item-card:active {
        transform: scale(0.985);
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .card-accent {
        width: 4px;
        flex-shrink: 0;
        border-radius: 12px 0 0 12px;
    }

    .card-accent.accent-green  { background: #10B981; }
    .card-accent.accent-yellow { background: #F59E0B; }
    .card-accent.accent-red    { background: #EF4444; }
    .card-accent.accent-gray   { background: #94A3B8; }

    .card-body {
        flex: 1;
        padding: 12px 10px 12px 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .card-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-meta-row {
        justify-content: space-between;
    }

    .code-tag {
        font-size: 10px;
        font-weight: 700;
        color: var(--primary-color);
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 4px;
        padding: 2px 6px;
        letter-spacing: 0.5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 60%;
    }

    .status-badge {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border-radius: 4px;
        padding: 2px 7px;
        white-space: nowrap;
    }

    .badge-green  { color: #065F46; background: #D1FAE5; }
    .badge-yellow { color: #92400E; background: #FEF3C7; }
    .badge-red    { color: #991B1B; background: #FEE2E2; }
    .badge-gray   { color: #374151; background: #F3F4F6; }

    .card-name {
        font-size: 13px;
        font-weight: 700;
        color: #1E293B;
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 1.35;
    }

    .card-location {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .loc-icon {
        font-size: 13px;
        color: #94A3B8;
    }

    .loc-text {
        font-size: 11px;
        font-weight: 500;
        color: #64748B;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-chevron {
        display: flex;
        align-items: center;
        padding: 0 10px 0 4px;
        color: #CBD5E1;
        flex-shrink: 0;
    }

    .card-chevron .material-symbols-outlined {
        font-size: 20px;
    }
</style>

@code {
    [Parameter] public required PatrimonioItem Item { get; set; }
    [Parameter] public InventoryItem? LocalItem { get; set; }
    [Parameter] public EventCallback<PatrimonioItem> OnView { get; set; }

    private string LocationText =>
        LocalItem?.Location
        ?? Item.Localizacao
        ?? "Sem localização";

    private string StateLabel
    {
        get
        {
            if (LocalItem == null) return "EM OPERAÇÃO";
            if (LocalItem.Status.HasValue) return LocalItem.Status.Value.ToDisplayText().ToUpper();
            return LocalItem.State switch
            {
                ConservationState.Bom or ConservationState.Novo => "EM OPERAÇÃO",
                ConservationState.Regular => "REGULAR",
                ConservationState.Pessimo => "PÉSSIMO",
                ConservationState.Inservivel => "INSERVÍVEL",
                _ => "EM OPERAÇÃO"
            };
        }
    }

    private string AccentClass => StateLabel switch
    {
        "EM OPERAÇÃO" => "accent-green",
        "MANUTENÇÃO" => "accent-yellow",
        "BAIXADO" or "INSERVÍVEL" => "accent-red",
        _ => "accent-gray"
    };

    private string BadgeClass => StateLabel switch
    {
        "EM OPERAÇÃO" => "badge-green",
        "MANUTENÇÃO" => "badge-yellow",
        "BAIXADO" or "INSERVÍVEL" => "badge-red",
        _ => "badge-gray"
    };

    private async Task HandleClick()
    {
        if (OnView.HasDelegate)
            await OnView.InvokeAsync(Item);
    }
}

