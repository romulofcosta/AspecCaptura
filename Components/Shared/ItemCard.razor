@using pwa_camera_poc_blazor.Models

<div class="gallery-item" @onclick="() => OnView.InvokeAsync(Item)">
    <div class="item-card">
        <div class="item-image">
            @if (!string.IsNullOrEmpty(Item.CoverImage))
            {
                <img src="@Item.CoverImage" alt="@Item.Name" loading="lazy">
            }
            else
            {
                <div class="no-image">📸</div>
            }
            @if (!Item.Synced)
            {
                <div class="sync-status pending" title="Pendente de sincronização">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" /></svg>
                </div>
            }
        </div>
        <div class="item-info">
            <h3 class="item-name">@Item.Name</h3>
            <p class="item-meta">
                <span class="item-category">@Item.Category</span>
                <span class="item-code">@Item.Code</span>
            </p>
            <p class="item-location">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 7.2c0 7.3-8 11.8-8 11.8z" /><circle cx="12" cy="9" r="3" /></svg>
                @Item.Location
            </p>
        </div>
        <div class="item-actions">
            <button class="btn-icon view-btn" @onclick:stopPropagation="true" @onclick="() => OnView.InvokeAsync(Item)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public InventoryItem Item { get; set; } = null!;
    [Parameter] public EventCallback<InventoryItem> OnView { get; set; }
}
