@using pwa_camera_poc_blazor.Models

<MudCard Elevation="3" Hover="true" @onclick="() => OnView.InvokeAsync(Item)"
    Style="@(IsListView ? "cursor: pointer; display: flex; flex-direction: row; height: 120px; width: 100%; overflow: hidden;" : "cursor: pointer; height: 100%; display: flex; flex-direction: column; overflow: hidden;")">

    <div
        style="@(IsListView ? "position: relative; width: 120px; height: 100%;" : "position: relative; height: 160px; width: 100%; background-color: var(--mud-palette-background-grey);")">
        <MudImage Src="@(string.IsNullOrEmpty(Item.CoverImage) ? "images/placeholder.svg" : Item.CoverImage)"
            Alt="@Item.Name" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />

        @if (!Item.Synced)
        {
            <MudTooltip Text="Pendente de sincronização" Arrow="true" Placement="Placement.Left">
                <div
                    style="position: absolute; top: 4px; right: 4px; background-color: var(--mud-palette-warning); border-radius: 50%; padding: 4px; display: flex;">
                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Color="Color.Surface" Size="Size.Small"
                        Style="font-size: 1rem;" />
                </div>
            </MudTooltip>
        }
    </div>

    <MudCardContent Class="d-flex flex-column flex-grow-1 py-2 px-3">
        <div class="d-flex justify-space-between align-start align-center gap-2">
            <MudText Typo="Typo.subtitle1" Class="text-truncate" Style="font-weight: 500;">@Item.Name</MudText>
            @if (IsListView)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                    Class="mr-0 ml-auto shrink-0">@Item.Code</MudChip>
            }
        </div>

        <div class="d-flex align-center gap-2 mt-1">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-0">
                @Item.Category</MudChip>
            @if (!IsListView)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-auto">@Item.Code</MudText>
            }
        </div>

        <div class="d-flex align-center mt-auto">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" Class="mr-1"
                Style="font-size: 1rem;" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@Item.Location</MudText>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public InventoryItem Item { get; set; } = null!;
    [Parameter] public EventCallback<InventoryItem> OnView { get; set; }
    [Parameter] public bool IsListView { get; set; } = false;
}
