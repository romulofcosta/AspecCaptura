@* Skeleton Loader Component - Provides visual feedback during content loading *@

<div class="skeleton-card" role="status" aria-label="Carregando conteúdo">
    <div class="skeleton-thumbnail" aria-hidden="true"></div>
    
    <div class="skeleton-content">
        <div class="skeleton-title" aria-hidden="true"></div>
        
        <div class="skeleton-chips" aria-hidden="true">
            <div class="skeleton-chip"></div>
            <div class="skeleton-chip"></div>
        </div>
        
        <div class="skeleton-text" aria-hidden="true"></div>
    </div>
    
    <span class="sr-only">Carregando itens do inventário...</span>
</div>

@code {
    // No code needed - pure presentational component
}
