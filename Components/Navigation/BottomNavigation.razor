@namespace pwa_camera_poc_blazor.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing

<nav class="bottom-navigation" role="navigation" aria-label="Navegação inferior">
    <NavLink class="bottom-navigation__item" href="/" Match="NavLinkMatch.All" ActiveClass="bottom-navigation__item--active" @onclick="@(async () => await HandleNavigateAsync("/"))">
        <span class="bottom-navigation__icon" aria-hidden="true">🏠</span>
        <span class="bottom-navigation__label">INÍCIO</span>
    </NavLink>

    <NavLink class="bottom-navigation__item" href="/history" Match="NavLinkMatch.Prefix" ActiveClass="bottom-navigation__item--active" @onclick="@(async () => await HandleNavigateAsync("/history"))">
        <span class="bottom-navigation__icon" aria-hidden="true">📋</span>
        <span class="bottom-navigation__label">Histórico</span>
    </NavLink>

    <NavLink class="bottom-navigation__item" href="/camera" Match="NavLinkMatch.Prefix" ActiveClass="bottom-navigation__item--active" @onclick="@(async () => await HandleNavigateAsync("/camera"))">
        <span class="bottom-navigation__icon" aria-hidden="true">📷</span>
        <span class="bottom-navigation__label">Câmera</span>
    </NavLink>

    <NavLink class="bottom-navigation__item" href="/sync" Match="NavLinkMatch.Prefix" ActiveClass="bottom-navigation__item--active" @onclick="@(async () => await HandleNavigateAsync("/sync"))">
        <span class="bottom-navigation__icon" aria-hidden="true">🔄</span>
        <span class="bottom-navigation__label">Sync</span>
    </NavLink>

    <NavLink class="bottom-navigation__item" href="/settings" Match="NavLinkMatch.Prefix" ActiveClass="bottom-navigation__item--active" @onclick="@(async () => await HandleNavigateAsync("/settings"))">
        <span class="bottom-navigation__icon" aria-hidden="true">⚙️</span>
        <span class="bottom-navigation__label">Config</span>
    </NavLink>
</nav>

@code {
    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private async Task HandleNavigateAsync(string href)
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync(href);
        }
    }
}
