@namespace pwa_camera_poc_blazor.Components.Navigation

<nav class="bottom-navigation">
    <div class="bottom-navigation__item @(IsActive("/") ? "bottom-navigation__item--active" : "")" 
         @onclick="@(() => OnNavigate.InvokeAsync("/"))">
        <span class="bottom-navigation__icon">🏠</span>
        <span class="bottom-navigation__label">INÍCIO</span>
    </div>
    
    <div class="bottom-navigation__item @(IsActive("/history") ? "bottom-navigation__item--active" : "")" 
         @onclick="@(() => OnNavigate.InvokeAsync("/history"))">
        <span class="bottom-navigation__icon">📋</span>
        <span class="bottom-navigation__label">Histórico</span>
    </div>
    
    <div class="bottom-navigation__item @(IsActive("/camera") ? "bottom-navigation__item--active" : "")" 
         @onclick="@(() => OnNavigate.InvokeAsync("/camera"))">
        <span class="bottom-navigation__icon">📷</span>
        <span class="bottom-navigation__label">Câmera</span>
    </div>
    
    <div class="bottom-navigation__item @(IsActive("/sync") ? "bottom-navigation__item--active" : "")" 
         @onclick="@(() => OnNavigate.InvokeAsync("/sync"))">
        <span class="bottom-navigation__icon">🔄</span>
        <span class="bottom-navigation__label">Sync</span>
    </div>
    
    <div class="bottom-navigation__item @(IsActive("/settings") ? "bottom-navigation__item--active" : "")" 
         @onclick="@(() => OnNavigate.InvokeAsync("/settings"))">
        <span class="bottom-navigation__icon">⚙️</span>
        <span class="bottom-navigation__label">Config</span>
    </div>
</nav>

@code {
    [Parameter]
    public string ActiveRoute { get; set; } = "/";
    
    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }
    
    private bool IsActive(string route)
    {
        return ActiveRoute.Contains(route, StringComparison.OrdinalIgnoreCase);
    }
}
