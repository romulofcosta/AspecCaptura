@*
    Checkbox Component
    
    An accessible checkbox component with proper touch targets and ARIA labels.
    
    Features:
    - Minimum 44x44px touch target
    - Proper ARIA labels and roles
    - Design token colors and spacing
    - Disabled state support
    
    Usage:
    <Checkbox 
        Label="Accept terms"
        @bind-Checked="accepted"
        Disabled="false" />
    
    Requirements: 2.4, 3.3, 8.1, 8.4
*@

@namespace AspecCaptura.Components.Forms

<label class="checkbox @(Disabled ? "checkbox--disabled" : "")">
    <input 
        type="checkbox"
        class="checkbox__input"
        checked="@Checked"
        disabled="@Disabled"
        aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : Label)"
        @onchange="HandleChange" />
    
    <span class="checkbox__box">
        @if (Checked)
        {
            <span class="checkbox__check material-symbols-outlined">check</span>
        }
    </span>
    
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="checkbox__label">@Label</span>
    }
</label>

@code {
    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (!Disabled)
        {
            Checked = (bool)(e.Value ?? false);
            await CheckedChanged.InvokeAsync(Checked);
        }
    }
}
