@*
    TextField Component
    
    A comprehensive text input component with floating label, validation, and mobile optimization.
    
    Features:
    - Floating label that moves above input when focused or filled
    - Inline validation feedback
    - Error message display with icon
    - Clear button for text inputs
    - Appropriate input types for mobile keyboards
    - Accessibility support
    
    Usage:
    <TextField 
        Label="Email"
        @bind-Value="email"
        Type="text"
        Required="true"
        Error="@errorMessage"
        HelperText="Enter your email address" />
    
    Requirements: 2.4, 11.1, 11.2, 11.3, 11.4, 11.5, 11.6, 11.10
*@

@namespace AspecCaptura.Components.Forms

<div class="text-field @(HasValue || IsFocused ? "text-field--filled" : "") @(!string.IsNullOrEmpty(Error) ? "text-field--error" : "") @(Disabled ? "text-field--disabled" : "")">
    
    <div class="text-field__container">
        <input 
            type="@Type"
            class="text-field__input"
            value="@Value"
            placeholder="@(IsFocused ? Placeholder : "")"
            disabled="@Disabled"
            required="@Required"
            autocomplete="@Autocomplete"
            aria-label="@Label"
            aria-invalid="@(!string.IsNullOrEmpty(Error))"
            aria-describedby="@(GetDescribedBy())"
            @oninput="HandleInput"
            @onfocus="HandleFocus"
            @onblur="HandleBlur" />
        
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="text-field__label">
                @Label@(Required ? " *" : "")
            </label>
        }
        
        @if (HasValue && !Disabled && Type != "password")
        {
            <button 
                type="button"
                class="text-field__clear"
                @onclick="HandleClear"
                aria-label="Clear @Label">
                <span class="material-symbols-outlined">close</span>
            </button>
        }
    </div>
    
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="text-field__error" id="@($"{GetId()}-error")">
            <span class="material-symbols-outlined">error</span>
            <span>@Error</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="text-field__helper" id="@($"{GetId()}-helper")">
            @HelperText
        </div>
    }
</div>

@code {
    private bool IsFocused { get; set; }
    private bool HasValue => !string.IsNullOrEmpty(Value);
    private string _id = Guid.NewGuid().ToString("N")[..8];

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? Autocomplete { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private void HandleFocus()
    {
        IsFocused = true;
    }

    private void HandleBlur()
    {
        IsFocused = false;
    }

    private async Task HandleClear()
    {
        Value = string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetId() => _id;

    private string GetDescribedBy()
    {
        if (!string.IsNullOrEmpty(Error))
            return $"{GetId()}-error";
        if (!string.IsNullOrEmpty(HelperText))
            return $"{GetId()}-helper";
        return string.Empty;
    }
}
