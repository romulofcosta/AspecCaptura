@page "/tombamentos-sync"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MudBlazor
@inject pwa_camera_poc_blazor.Services.Sync.SyncService SyncService
@inject pwa_camera_poc_blazor.Services.Auth.IAuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6 rounded-lg">
        <MudText Typo="Typo.h5" Class="mb-4 font-weight-bold">Baixando Lotes de Tombamentos</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Por favor aguarde, estamos atualizando a base local...</MudText>
        
        <div class="d-flex align-center justify-space-between mb-1">
            <MudText Typo="Typo.caption">Lote @current de @total</MudText>
            <MudText Typo="Typo.caption">@((int)ProgressValue)%</MudText>
        </div>
        <MudProgressLinear Value="@ProgressValue" Color="Color.Primary" Class="mb-4" Striped="true" Size="Size.Large" />
        
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="d-block">
            Processando e validando integridade dos dados...
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private int current = 0;
    private int total = 1;
    private bool IsRunning = false;
    private bool _autoTriggered = false;
    private double ProgressValue => total == 0 ? 0 : (double)current / total * 100;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_autoTriggered)
        {
            _autoTriggered = true;
            await RunSync();
        }
    }

    private async Task RunSync()
    {
        if (IsRunning) return;
        IsRunning = true;
        current = 0;
        total = 1;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null || string.IsNullOrEmpty(user.Prefixo))
            {
                Snackbar.Add("Usuário não autenticado.", Severity.Warning);
                Navigation.NavigateTo("/login");
                return;
            }

            var progress = new Progress<pwa_camera_poc_blazor.Services.Sync.SyncProgress>(p =>
            {
                // Incrementa localmente para UI
                if (p.Current > current) current = p.Current;
                total = p.Total;
                InvokeAsync(StateHasChanged);
                // Pequeno delay para dar tempo da UI renderizar
                Task.Delay(1); 
            });

            var result = await SyncService.SyncAsync(user.Prefixo, progress);
            if (result == pwa_camera_poc_blazor.Services.Sync.SyncResult.Success)
            {
                Snackbar.Add("Sincronização concluída.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Dados já sincronizados.", Severity.Info);
            }

            Navigation.NavigateTo("/configuracao-sessao");
        }
        catch (HttpRequestException ex)
        {
            Console.Error.WriteLine($"Erro de conexão: {ex.Message}");
            Snackbar.Add("Não foi possível conectar ao servidor. Verifique sua conexão e tente novamente.", Severity.Error);
            // Aguarda 2 segundos e redireciona para configuração de sessão (modo offline)
            await Task.Delay(2000);
            Navigation.NavigateTo("/configuracao-sessao");
        }
        catch (TaskCanceledException ex)
        {
            Console.Error.WriteLine($"Timeout na sincronização: {ex.Message}");
            Snackbar.Add("A sincronização demorou muito. Tente novamente mais tarde.", Severity.Warning);
            await Task.Delay(2000);
            Navigation.NavigateTo("/configuracao-sessao");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erro na sincronização: {ex.Message}");
            Snackbar.Add($"Erro ao sincronizar: {ex.Message}", Severity.Error);
            await Task.Delay(2000);
            Navigation.NavigateTo("/configuracao-sessao");
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }
}