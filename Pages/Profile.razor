@page "/profile"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Perfil - ASPEC Capture</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8 premium-card">
        <div class="d-flex flex-column align-center mb-6">
            <MudAvatar Color="Color.Primary" Style="height:120px; width:120px; font-size:3rem;"
                Class="mb-4 shadow-md border-white border-2">
                @UserInitials
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="font-weight-bold">@FullName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Email</MudText>
        </div>

        <MudDivider Class="my-6" />

        <EditForm Model="@profileModel" OnValidSubmit="HandleUpdateProfile">
            <DataAnnotationsValidator />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="profileModel.FirstName" Label="Nome" Variant="Variant.Outlined"
                        For="@(() => profileModel.FirstName)" Class="label-fix" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="profileModel.LastName" Label="Sobrenome" Variant="Variant.Outlined"
                        For="@(() => profileModel.LastName)" Class="label-fix" />
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="profileModel.Username" Label="E-mail" Variant="Variant.Outlined" Disabled="true"
                Class="mt-4 label-fix" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                Class="mt-8 py-3" Size="Size.Large">
                Salvar Alterações
            </MudButton>
        </EditForm>

        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-4"
            OnClick="@(() => Navigation.NavigateTo("/home"))">
            Voltar para Home
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private ProfileModel profileModel = new();
    private User? currentUser;
    private string UserInitials = "U";
    private string FullName = "";
    private string Email = "";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            profileModel.FirstName = currentUser.FirstName;
            profileModel.LastName = currentUser.LastName;
            profileModel.Username = currentUser.Username;

            Email = currentUser.Username;
            FullName = $"{currentUser.FirstName} {currentUser.LastName}";
            if (!string.IsNullOrEmpty(currentUser.FirstName) && !string.IsNullOrEmpty(currentUser.LastName))
            {
                UserInitials = $"{currentUser.FirstName[0]}{currentUser.LastName[0]}".ToUpper();
            }
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (currentUser != null)
        {
            currentUser.FirstName = profileModel.FirstName;
            currentUser.LastName = profileModel.LastName;

            await DbService.UpdateAsync("users", currentUser);
            // Updating the object in local storage since AuthService uses it as source of truth for current user
            await AuthService.RegisterAsync(currentUser.Username, "", currentUser.FirstName, currentUser.LastName,
            currentUser.UnitIds);
            // Note: RegisterAsync in current impl overwrites. Password hashing might be an issue if I pass empty.
            // Better to update AuthService to have an UpdateProfile method.

            Snackbar.Add("Perfil atualizado com sucesso!", Severity.Success);
            StateHasChanged();
        }
    }

    public class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string FirstName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string LastName { get; set; } = "";

        public string Username { get; set; } = "";
    }
}
