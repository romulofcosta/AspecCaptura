@page "/profile"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Perfil - Aspec Captura</PageTitle>

<MudContainer id="profile-container" MaxWidth="MaxWidth.Small" Class="mt-4 pb-20" Style="overflow-y: auto; height: 100%;">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg premium-card">
        <div class="d-flex flex-column align-center mb-6">
            <MudAvatar Color="Color.Primary" Size="Size.Large"
                Class="mb-4 shadow-md border-white border-2 profile-avatar-lg">
                @UserInitials
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="font-weight-bold">@FullName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Email</MudText>
        </div>

        <MudDivider Class="my-6" />

        <EditForm Model="@profileModel" OnValidSubmit="HandleUpdateProfile">
            <DataAnnotationsValidator />

            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Nome Completo</MudText>
                    <MudTextField @bind-Value="profileModel.NomeCompleto" Placeholder="Seu nome completo" Variant="Variant.Outlined"
                        For="@(() => profileModel.NomeCompleto)" FullWidth="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Usuário</MudText>
                    <MudTextField @bind-Value="profileModel.Usuario" Variant="Variant.Outlined" Disabled="true"
                        FullWidth="true" />
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        Class="py-3 shadow-md" Size="Size.Large">
                        Salvar Alterações
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>

        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-4"
            OnClick="@(() => Navigation.NavigateTo("/home"))">
            Voltar para Home
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private ProfileModel profileModel = new();
    private Usuario? currentUser;
    private string UserInitials = "U";
    private string FullName = "";
    private string Email = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#profile-container");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            profileModel.NomeCompleto = currentUser.NomeCompleto;
            profileModel.Usuario = currentUser.UsuarioNome;

            Email = currentUser.UsuarioNome;
            FullName = currentUser.NomeCompleto;
            if (!string.IsNullOrEmpty(currentUser.NomeCompleto))
            {
                var names = currentUser.NomeCompleto.Split(' ');
                UserInitials = names.Length > 1 
                    ? $"{names[0][0]}{names[^1][0]}".ToUpper() 
                    : names[0][0].ToString().ToUpper();
            }
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (currentUser != null)
        {
            currentUser.NomeCompleto = profileModel.NomeCompleto;

            await AuthService.UpdateUserAsync(currentUser);

            FullName = currentUser.NomeCompleto;
            var names = currentUser.NomeCompleto.Split(' ');
            UserInitials = names.Length > 1 
                ? $"{names[0][0]}{names[^1][0]}".ToUpper() 
                : names[0][0].ToString().ToUpper();

            Snackbar.Add("Perfil atualizado com sucesso!", Severity.Success);
            StateHasChanged();
        }
    }

    public class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string NomeCompleto { get; set; } = "";

        public string Usuario { get; set; } = "";
    }
}
