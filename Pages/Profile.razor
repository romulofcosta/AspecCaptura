@page "/profile"
@using AspecCaptura.Models
@inject IAuthService AuthService
@inject AspecCaptura.Services.Storage.IIndexedDbService DbService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Perfil - Aspec Captura</PageTitle>

<style>
    .profile-container {
        max-width: 500px;
        margin: 0 auto;
        padding: 32px 24px;
        padding-bottom: calc(120px + env(safe-area-inset-bottom));
    }

    .profile-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 24px;
    }

    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 24px;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        margin-bottom: 16px;
    }

    .profile-name {
        font-size: 18px;
        font-weight: 700;
        color: #1E293B;
        margin: 0;
    }

    .profile-email {
        font-size: 14px;
        color: #64748B;
        margin: 4px 0 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 14px;
        background: white;
        transition: all 0.2s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: #003366;
        box-shadow: 0 0 0 3px rgba(0, 51, 102, 0.1);
    }

    .btn-save {
        width: 100%;
        background: #003366;
        color: white;
        padding: 16px 24px;
        border-radius: 12px;
        border: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 24px;
    }

    .btn-save:hover {
        background: #002244;
    }

    .btn-back {
        width: 100%;
        background: transparent;
        color: #003366;
        padding: 12px 24px;
        border: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 16px;
    }

    .btn-back:hover {
        background: #F8FAFC;
    }

    .divider {
        height: 1px;
        background: #E2E8F0;
        margin: 24px 0;
    }
</style>

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar" style="border-radius: 50%; background: #003366; color: white; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: bold;">
                @UserInitials
            </div>
            <p class="profile-name">@FullName</p>
            <p class="profile-email">@Email</p>
        </div>

        <div class="divider"></div>

        <EditForm Model="@profileModel" OnValidSubmit="HandleUpdateProfile">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">Nome Completo</label>
                <input class="form-input" type="text" @bind="profileModel.NomeCompleto" placeholder="Seu nome completo" />
            </div>

            <div class="form-group">
                <label class="form-label">Usuário</label>
                <input class="form-input" type="text" @bind="profileModel.Usuario" disabled />
            </div>

            <button type="submit" class="btn-save">Salvar Alterações</button>
        </EditForm>

        <button class="btn-back" @onclick="@(() => Navigation.NavigateTo("/home"))">
            Voltar para Home
        </button>
    </div>
</div>

@code {
    private ProfileModel profileModel = new();
    private Usuario? currentUser;
    private string UserInitials = "U";
    private string FullName = "";
    private string Email = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#profile-container");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            profileModel.NomeCompleto = currentUser.NomeCompleto;
            profileModel.Usuario = currentUser.UsuarioNome;

            Email = currentUser.UsuarioNome;
            FullName = currentUser.NomeCompleto;
            if (!string.IsNullOrEmpty(currentUser.NomeCompleto))
            {
                var names = currentUser.NomeCompleto.Split(' ');
                UserInitials = names.Length > 1 
                    ? $"{names[0][0]}{names[^1][0]}".ToUpper() 
                    : names[0][0].ToString().ToUpper();
            }
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (currentUser != null)
        {
            currentUser.NomeCompleto = profileModel.NomeCompleto;

            await AuthService.UpdateUserAsync(currentUser);

            FullName = currentUser.NomeCompleto;
            var names = currentUser.NomeCompleto.Split(' ');
            UserInitials = names.Length > 1 
                ? $"{names[0][0]}{names[^1][0]}".ToUpper() 
                : names[0][0].ToString().ToUpper();

            ToastService.Show("Perfil atualizado com sucesso!", "success");
            StateHasChanged();
        }
    }

    public class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string NomeCompleto { get; set; } = "";

        public string Usuario { get; set; } = "";
    }
}
