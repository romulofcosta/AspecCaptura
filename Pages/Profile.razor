@page "/profile"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Perfil - ASPEC Capture</PageTitle>

<MudContainer id="profile-container" MaxWidth="MaxWidth.Small" Class="mt-4 pb-20 profile-container">
    <MudPaper Elevation="4" Class="pa-8 profile-card premium-card">
        <div class="d-flex flex-column align-center mb-6">
            <MudAvatar Color="Color.Primary" Class="profile-avatar mb-4">
                @UserInitials
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="font-weight-bold">@FullName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Email</MudText>
        </div>

        <MudDivider Class="my-6" />

        <EditForm Model="@profileModel" OnValidSubmit="HandleUpdateProfile">
            <DataAnnotationsValidator />

            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Nome</MudText>
                    <MudTextField @bind-Value="profileModel.PrimeiroNome" Placeholder="Seu nome" Variant="Variant.Outlined"
                        For="@(() => profileModel.PrimeiroNome)" FullWidth="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Sobrenome</MudText>
                    <MudTextField @bind-Value="profileModel.UltimoNome" Placeholder="Seu sobrenome" Variant="Variant.Outlined"
                        For="@(() => profileModel.UltimoNome)" FullWidth="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">E-mail</MudText>
                    <MudTextField @bind-Value="profileModel.NomeUsuario" Variant="Variant.Outlined" Disabled="true"
                        FullWidth="true" />
                </MudItem>

                <MudItem xs="12" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        Class="py-3 shadow-md" Size="Size.Large">
                        Salvar Alterações
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.subtitle1" Class="profile-section-title">Configurações</MudText>
        <MudDivider Class="mb-4" />

        <MudList T="string" Clickable="true" Class="rounded-lg">
            <MudListItem Text="Log de Atividades" Icon="@Icons.Material.Filled.History" OnClick="ShowHistory" />
            <MudListItem Text="Limpar Cache" Icon="@Icons.Material.Filled.DeleteSweep" OnClick="ConfirmClearCache" IconColor="Color.Error" />
            <MudListItem Text="Sair da Conta" Icon="@Icons.Material.Filled.Logout" OnClick="HandleLogout" IconColor="Color.Error" />
        </MudList>

        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Class="mt-4"
            OnClick="NavigateToHome">
            Voltar para Home
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private ProfileModel profileModel = new();
    private Usuario? currentUser;
    private string UserInitials = "U";
    private string FullName = "";
    private string Email = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#profile-container");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            profileModel.PrimeiroNome = currentUser.PrimeiroNome;
            profileModel.UltimoNome = currentUser.UltimoNome;
            profileModel.NomeUsuario = currentUser.NomeUsuario;

            Email = currentUser.NomeUsuario;
            FullName = $"{currentUser.PrimeiroNome} {currentUser.UltimoNome}";
            if (!string.IsNullOrEmpty(currentUser.PrimeiroNome))
            {
                UserInitials = $"{currentUser.PrimeiroNome[0]}{(string.IsNullOrEmpty(currentUser.UltimoNome) ? "" : currentUser.UltimoNome[0].ToString())}".ToUpper();
            }
        }
    }

    private void NavigateToHome() => Navigation.NavigateTo("/home");
    private void ShowHistory() => Snackbar.Add("Recurso em breve!", Severity.Info);
    private void ConfirmClearCache() => Snackbar.Add("Cache limpo!", Severity.Success);

    private async Task HandleLogout()
    {
        await AuthService.DesconectarAsync();
        Navigation.NavigateTo("/login");
    }

    private async Task HandleUpdateProfile()
    {
        if (currentUser != null)
        {
            currentUser.PrimeiroNome = profileModel.PrimeiroNome;
            currentUser.UltimoNome = profileModel.UltimoNome;

            await AuthService.UpdateUserAsync(currentUser);

            FullName = $"{currentUser.PrimeiroNome} {currentUser.UltimoNome}";
            UserInitials = $"{currentUser.PrimeiroNome[0]}{(string.IsNullOrEmpty(currentUser.UltimoNome) ? "" : currentUser.UltimoNome[0].ToString())}".ToUpper();

            Snackbar.Add("Perfil atualizado com sucesso!", Severity.Success);
            StateHasChanged();
        }
    }

    public class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string PrimeiroNome { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string UltimoNome { get; set; } = "";

        public string NomeUsuario { get; set; } = "";
    }
}
