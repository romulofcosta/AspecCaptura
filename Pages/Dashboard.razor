@page "/dashboard"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject pwa_camera_poc_blazor.Services.Storage.IIndexedDbService DbService
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inventário - Aspec Captura</PageTitle>

<div style="min-height: 100vh; background: #f5f7f8; font-family: 'Inter', sans-serif;">
    <!-- Header -->
    <header style="position: sticky; top: 0; z-index: 10; background: white; border-bottom: 1px solid #e2e8f0; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #e8eef7; display: flex; align-items: center; justify-content: center;">
                <span class="material-symbols-outlined" style="color: #94a3b8; font-size: 24px;">person</span>
            </div>
            <h1 style="font-size: 20px; font-weight: 700; color: #003366; margin: 0;">Inventário</h1>
        </div>
        <button @onclick="HandleLogout" style="padding: 8px; color: #64748b; background: none; border: none; cursor: pointer;">
            <span class="material-symbols-outlined">logout</span>
        </button>
    </header>

    <!-- Main Content -->
    <main style="flex: 1; overflow-y: auto;">
        <!-- Search Bar -->
        <div style="padding: 16px;">
            <div style="position: relative;">
                <div style="position: absolute; top: 50%; left: 12px; transform: translateY(-50%); pointer-events: none; color: #94a3b8;">
                    <span class="material-symbols-outlined">search</span>
                </div>
                <input type="text" 
                       placeholder="Pesquisar itens ou etiquetas..." 
                       @bind="searchQuery"
                       @bind:event="oninput"
                       style="display: block; width: 100%; padding: 12px 12px 12px 44px; background: white; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 14px; color: #1e293b; outline: none; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" />
            </div>
        </div>

        <!-- Filter Tabs -->
        <div style="display: flex; gap: 8px; padding: 0 16px 16px; overflow-x: auto;">
            <button @onclick="@(() => SetFilter("all"))" 
                    style="white-space: nowrap; padding: 6px 16px; border-radius: 9999px; font-size: 14px; font-weight: 500; border: none; cursor: pointer; @(currentFilter == "all" ? "background: #003366; color: white;" : "background: white; color: #64748b; border: 1px solid #e2e8f0;")">
                Todos
            </button>
            <button @onclick="@(() => SetFilter("pending"))" 
                    style="white-space: nowrap; padding: 6px 16px; border-radius: 9999px; font-size: 14px; font-weight: 500; border: none; cursor: pointer; @(currentFilter == "pending" ? "background: #003366; color: white;" : "background: white; color: #64748b; border: 1px solid #e2e8f0;")">
                Pendentes
            </button>
            <button @onclick="@(() => SetFilter("synced"))" 
                    style="white-space: nowrap; padding: 6px 16px; border-radius: 9999px; font-size: 14px; font-weight: 500; border: none; cursor: pointer; @(currentFilter == "synced" ? "background: #003366; color: white;" : "background: white; color: #64748b; border: 1px solid #e2e8f0;")">
                Sincronizados
            </button>
        </div>

        <!-- Items List -->
        <div style="padding: 0 16px; padding-bottom: calc(80px + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 12px;">
            @if (isLoading)
            {
                <div style="display: flex; justify-content: center; padding: 40px 0;">
                    <div class="spinner"></div>
                </div>
            }
            else if (!filteredItems.Any())
            {
                <div style="text-align: center; padding: 40px 24px; color: #94a3b8;">
                    <span class="material-symbols-outlined" style="opacity: 0.3; font-size: 64px;">inventory_2</span>
                    <p style="margin-top: 16px; font-size: 14px;">Nenhum item encontrado</p>
                </div>
            }
            else
            {
                @foreach (var item in filteredItems.Take(displayCount))
                {
                    <div @onclick="@(() => NavigateToItem(item))"
                         style="display: flex; align-items: center; justify-content: space-between; padding: 16px; background: white; border-radius: 12px; border: 1px solid #f1f5f9; box-shadow: 0 1px 2px rgba(0,0,0,0.05); cursor: pointer;">
                        <div style="display: flex; align-items: flex-start; gap: 16px; flex: 1;">
                            <div style="width: 48px; height: 48px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                <span class="material-symbols-outlined text-2xl">@GetItemIcon(item.Category)</span>
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <h3 style="font-weight: 600; color: #1e293b; font-size: 14px; margin: 0 0 4px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Name</h3>
                                <p style="font-size: 12px; color: #64748b; margin: 0;">@GetLocationText(item) • <span style="font-family: monospace;">#@item.Code</span></p>
                            </div>
                        </div>
                        <div style="flex-shrink: 0; margin-left: 12px; color: @(item.Synced ? "#22c55e" : "#cbd5e1");">
                            @if (item.Synced)
                            {
                                <span class="material-symbols-outlined text-green-500">cloud_done</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-gray-300">cloud_off</span>
                            }
                        </div>
                    </div>
                }

                @if (filteredItems.Count() > displayCount && displayCount < 200)
                {
                    <div style="display: flex; justify-content: center; margin-top: 24px;">
                        <button @onclick="LoadMore"
                                style="padding: 12px 24px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 14px; font-weight: 600; color: #003366; cursor: pointer;">
                            Carregar mais
                        </button>
                    </div>
                }
            }
        </div>
    </main>

    <!-- Floating Action Button -->
    <div class="dashboard-fab">
        <button @onclick="StartCapture"
                style="width: 56px; height: 56px; border-radius: 50%; background: #003366; color: white; border: none; box-shadow: 0 4px 12px rgba(0,51,102,0.3); display: flex; align-items: center; justify-content: center; cursor: pointer;">
            <span class="material-symbols-outlined">add</span>
        </button>
    </div>
</div>

@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private string currentFilter = "all";
    private bool isLoading = true;
    private int displayCount = 20;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Aguardar um pouco para garantir que o estado seja carregado pelo layout
            await Task.Delay(200);
            
            // Verificar sessão com retry se necessário
            int retries = 0;
            while (!appState.IsSessionConfigured() && retries < 3)
            {
                await Task.Delay(100);
                retries++;
            }
            
            if (!appState.IsSessionConfigured())
            {
                Navigation.NavigateTo("/configuracao-sessao");
                return;
            }
            
            appState.OnChange += HandleStateChange;
            await LoadItems();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard: Erro em OnInitializedAsync: {ex.Message}");
        }
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            string esfera = appState.EsferaAtual ?? user?.Esfera ?? string.Empty;
            
            if (appState.CurrentUO?.IdUO != null)
            {
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                
                if (esfera == "A")
                {
                    items = allItems.ToList();
                }
                else if (!string.IsNullOrEmpty(esfera))
                {
                    items = allItems.Where(i => i.Esfera == esfera).ToList();
                }
                else
                {
                    items = allItems.ToList();
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
        displayCount = 20;
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            result = currentFilter switch
            {
                "pending" => result.Where(i => !i.Synced),
                "synced" => result.Where(i => i.Synced),
                _ => result
            };

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                    i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            return result.OrderByDescending(i => i.UpdatedAt);
        }
    }

    private void LoadMore()
    {
        displayCount = Math.Min(displayCount + 20, 200);
    }

    private string GetLocationText(InventoryItem item)
    {
        return !string.IsNullOrEmpty(item.Location) ? item.Location : "Local não informado";
    }

    private string GetItemIcon(string category)
    {
        return category?.ToLower() switch
        {
            "móveis" or "moveis" => "chair",
            "eletrônicos" or "eletronicos" => "laptop_mac",
            "equipamentos" => "print",
            "ferramentas" => "build",
            "materiais" => "inventory_2",
            _ => "category"
        };
    }

    private void StartCapture()
    {
        Navigation.NavigateTo("/camera");
    }

    private void NavigateToItem(InventoryItem item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    private async Task HandleLogout()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Deseja realmente sair do sistema?");
        if (confirmed)
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}