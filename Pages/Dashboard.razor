@page "/dashboard"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Dashboard - Aspec Captura</PageTitle>

<div style="min-height: 100vh; background: #FFFFFF;">
    <!-- Header com Avatar e Botões -->
    <div style="padding: 24px; border-bottom: 1px solid #E2E8F0;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <!-- Esquerda: Avatar + Nome -->
            <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #E8EEF7; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Style="color: #94A3B8;" />
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <h1 style="font-size: 20px; font-weight: 700; color: #003366; margin: 0;">Olá, @GetFirstName()</h1>
                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Style="color: #0066CC;" />
                    </div>
                    <p style="font-size: 13px; color: #94A3B8; font-weight: 500; margin: 4px 0 0 0;">Aspec Captura</p>
                </div>
            </div>
            
            <!-- Direita: Botões -->
            <div style="display: flex; align-items: center; gap: 8px;">
                <button @onclick="@(() => Navigation.NavigateTo("/notifications"))"
                        style="background: #F8FAFC; border: none; border-radius: 8px; width: 40px; height: 40px; 
                               display: flex; align-items: center; justify-content: center; cursor: pointer;
                               box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.2s; padding: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Medium" Style="color: #64748B;" />
                </button>
                
                <button @onclick="HandleLogout"
                        style="background: #FEF2F2; border: none; border-radius: 8px; width: 40px; height: 40px; 
                               display: flex; align-items: center; justify-content: center; cursor: pointer;
                               box-shadow: 0 1px 2px rgba(220,38,38,0.1); transition: all 0.2s; padding: 0;">
                    <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Size="Size.Medium" Style="color: #DC2626;" />
                </button>
            </div>
        </div>

        <!-- Contexto: Órgão/Unidade -->
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Size="Size.Small" Style="color: #64748B;" />
                <span style="font-size: 13px; color: #64748B; font-weight: 500;">@GetContextName()</span>
            </div>
            <button class="btn-change" @onclick="ChangeContext" style="font-size: 12px; padding: 6px 12px;">Alterar</button>
        </div>
    </div>

    <!-- Conteúdo Principal -->
    <div style="padding: 24px;">
        
        <!-- Cards de Estatísticas -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 32px;">
            <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px; text-align: center;">
                <p style="font-size: 11px; color: #94A3B8; font-weight: 600; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Total</p>
                <p style="font-size: 28px; font-weight: 700; color: #003366; margin: 0;">@items.Count</p>
            </div>
            <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px; text-align: center;">
                <p style="font-size: 11px; color: #94A3B8; font-weight: 600; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Sincro.</p>
                <p style="font-size: 28px; font-weight: 700; color: #2e7d32; margin: 0;">@items.Count(i => i.Synced)</p>
            </div>
            <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px; text-align: center;">
                <p style="font-size: 11px; color: #94A3B8; font-weight: 600; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Pend.</p>
                <p style="font-size: 28px; font-weight: 700; color: #ed6c02; margin: 0;">@items.Count(i => !i.Synced)</p>
            </div>
        </div>

        <!-- Busca -->
        <div style="position: relative; margin-bottom: 16px;">
            <div style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #94A3B8;">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            </div>
            <input type="text" 
                   placeholder="Buscar patrimônio..." 
                   @bind="searchQuery"
                   @bind:event="oninput"
                   style="width: 100%; padding: 12px 16px 12px 44px; border: 1px solid #E2E8F0; border-radius: 8px; 
                          font-size: 14px; color: #1E293B; background: #F8FAFC; outline: none; transition: all 0.2s;" />
        </div>

        <!-- Botão Iniciar Captura -->
        <button @onclick="StartCapture"
                style="width: 100%; padding: 16px; background: #003366; color: white; border: none; border-radius: 12px; 
                       font-size: 16px; font-weight: 600; cursor: pointer; display: flex; align-items: center; 
                       justify-content: center; gap: 12px; margin-bottom: 32px; box-shadow: 0 2px 8px rgba(0,51,102,0.15); transition: all 0.2s;">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Medium" />
            <span>Iniciar Captura</span>
        </button>

        <!-- Itens Recentes -->
        <div style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 style="font-size: 16px; font-weight: 700; color: #1E293B; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">Itens Recentes</h2>
                <button class="btn-change" @onclick="ViewAll" style="font-size: 12px; padding: 6px 12px;">Ver todos</button>
            </div>

            @if (isLoading)
            {
                <div style="display: flex; justify-content: center; padding: 40px 0;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (!filteredItems.Any())
            {
                <div style="text-align: center; padding: 40px 24px; color: #94A3B8;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Style="opacity: 0.3; font-size: 64px;" />
                    <p style="margin-top: 16px; font-size: 14px;">Nenhum item encontrado</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var item in filteredItems.Take(displayCount))
                    {
                        <div @onclick="@(() => NavigateToItem(item))"
                             style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 16px; 
                                    display: flex; align-items: center; justify-content: space-between; cursor: pointer;
                                    transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                            <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
                                <div style="width: 40px; height: 40px; border-radius: 8px; background: #F1F5F9; 
                                           display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Style="color: #94A3B8;" />
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <p style="font-weight: 600; color: #1E293B; font-size: 14px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Name</p>
                                    <p style="font-size: 11px; color: #94A3B8; font-weight: 500; margin: 4px 0 0 0;">
                                        #@item.Code • @item.UpdatedAt.ToString("dd/MM HH:mm")
                                    </p>
                                </div>
                            </div>
                            <div style="flex-shrink: 0; margin-left: 12px;">
                                @if (item.Synced)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="color: #2e7d32;" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Style="color: #94A3B8; opacity: 0.5;" />
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (filteredItems.Count() > displayCount && displayCount < 200)
                {
                    <div style="display: flex; justify-content: center; margin-top: 24px;">
                        <button @onclick="LoadMore"
                                style="padding: 12px 24px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; 
                                       font-size: 14px; font-weight: 600; color: #003366; cursor: pointer; transition: all 0.2s;">
                            Carregar mais
                        </button>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Bottom Navigation -->
    <div style="position: fixed; bottom: 0; left: 0; right: 0; background: #FFFFFF; border-top: 1px solid #E2E8F0; 
               display: flex; justify-content: space-around; align-items: center; height: 64px; padding-bottom: env(safe-area-inset-bottom);">
        <button @onclick="@(() => Navigation.NavigateTo("/dashboard"))"
                style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; 
                       background: none; border: none; cursor: pointer; color: #003366; font-size: 11px; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            <span>INÍCIO</span>
        </button>
        <button @onclick="@(() => Navigation.NavigateTo("/home"))"
                style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; 
                       background: none; border: none; cursor: pointer; color: #94A3B8; font-size: 11px; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" />
            <span>LISTA</span>
        </button>
        <button @onclick="@(() => Navigation.NavigateTo("/sync"))"
                style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; 
                       background: none; border: none; cursor: pointer; color: #94A3B8; font-size: 11px; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" />
            <span>SINC</span>
        </button>
        <button @onclick="@(() => Navigation.NavigateTo("/settings"))"
                style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; 
                       background: none; border: none; cursor: pointer; color: #94A3B8; font-size: 11px; font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            <span>PERFIL</span>
        </button>
    </div>

    <!-- Espaço para Bottom Navigation -->
    <div style="height: 80px;"></div>
</div>

@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private bool isLoading = true;
    private int displayCount = 20;

    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            string esfera = appState.EsferaAtual ?? user?.Esfera ?? string.Empty;
            
            if (appState.CurrentUO?.IdUO != null)
            {
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                
                if (esfera == "A")
                {
                    items = allItems.ToList();
                }
                else if (!string.IsNullOrEmpty(esfera))
                {
                    items = allItems.Where(i => i.Esfera == esfera).ToList();
                }
                else
                {
                    items = allItems.ToList();
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                    i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            return result.OrderByDescending(i => i.UpdatedAt);
        }
    }

    private void LoadMore()
    {
        displayCount = Math.Min(displayCount + 20, 200);
    }

    private string GetFirstName()
    {
        if (appState.CurrentUser == null) return "Usuário";
        var parts = appState.CurrentUser.NomeCompleto?.Split(' ');
        return parts?.FirstOrDefault() ?? "Usuário";
    }

    private string GetContextName()
    {
        return appState.CurrentUO?.NomeUO ?? "Selecione uma unidade";
    }

    private void ChangeContext()
    {
        Navigation.NavigateTo("/configuracao-sessao");
    }

    private void StartCapture()
    {
        Navigation.NavigateTo("/camera");
    }

    private void ViewAll()
    {
        Navigation.NavigateTo("/home");
    }

    private void NavigateToItem(InventoryItem item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    private async Task HandleLogout()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Deseja realmente sair do sistema?");
        if (confirmed)
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}
