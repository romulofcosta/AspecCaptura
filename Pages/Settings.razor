@page "/settings"
@layout AspecCaptura.Components.Layout.AppLayout
@using AspecCaptura.Components.Configuration
@inject ILogger<Settings> Logger

<PageTitle>Ajustes - Aspec Captura</PageTitle>
<style>
    .settings-page {
        min-height: 100vh;
        background: var(--background-color);
        display: flex;
        flex-direction: column;
    }

    .settings-header {
        display: flex;
        align-items: center;
        padding: 48px 16px 16px; /* Aumentando padding top para iOS */
        background: var(--surface-color);
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: 1px;
        margin-left: 8px;
    }

    .back-btn {
        background: none;
        border: none;
        color: var(--color-primary);
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
    }

    .header-spacer { flex: 1; }

    .settings-content {
        padding: 24px 16px;
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .settings-hint {
        font-size: 12px;
        color: var(--color-text-secondary);
        margin-bottom: 32px;
    }

    .settings-section {
        margin-bottom: 32px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 700;
        color: var(--color-text-secondary);
        margin-bottom: 12px;
        letter-spacing: 1px;
    }

    .config-list {
        background: var(--surface-color);
        border-radius: 12px;
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    .config-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid var(--divider-color);
    }

    .config-item:last-child { border-bottom: none; }

    .config-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        opacity: 0.8;
    }

    .section-label .material-symbols-outlined {
        font-size: 16px;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .about-card {
        background: var(--surface-color);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid var(--color-border);
    }

    .about-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .about-logo {
        width: 40px;
        height: 40px;
        opacity: 0.4;
    }

    .about-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0;
    }

    .about-version {
        font-size: 10px;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        border-top: 1px solid var(--divider-color);
        padding-top: 16px;
    }

    .about-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .about-label {
        font-size: 8px;
        font-weight: 700;
        color: var(--color-text-secondary);
    }

    .about-value {
        font-size: 10px;
        font-weight: 700;
        color: var(--color-primary);
    }

    .status-ok { color: #10B981; }

    .logout-btn {
        width: 100%;
        height: 48px;
        background: var(--surface-color);
        border: 1px solid #fee2e2;
        color: #ef4444;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    /* Switch Styling */
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

    .switch input { opacity: 0; width: 0; height: 0; }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #ccc;
        transition: .4s;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 14px; width: 14px;
        left: 3px; bottom: 3px;
        background-color: white;
        transition: .4s;
    }

    input:checked + .slider { background-color: var(--color-primary); }
    input:checked + .slider:before { transform: translateX(20px); }
    .slider.round { border-radius: 20px; }
    .slider.round:before { border-radius: 50%; }
</style>

<!-- Settings Container -->
<div class="settings-page">
    <!-- Header -->
    <header class="settings-header">
        <button @onclick="@(() => Navigation.NavigateTo("/"))" class="back-btn">
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h1 class="header-title">AJUSTES</h1>
        <div class="header-spacer"></div>
    </header>

    <!-- Main Content -->
    <main class="settings-content">
        <p class="settings-hint">Gerencie as preferências de operação e sistema.</p>

        <!-- Configurações da Câmera -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">photo_camera</span>
                <span>CONFIGURAÇÕES DA CÂMERA</span>
            </div>
            <div class="config-list">
                @foreach (var config in cameraConfigs.Take(2))
                {
                    <div class="config-item">
                        <span class="config-label">@config.Label</span>
                        <label class="switch">
                            <input type="checkbox" checked="@config.Enabled" @onchange="() => config.Enabled = !config.Enabled">
                            <span class="slider round"></span>
                        </label>
                    </div>
                }
            </div>
        </section>

        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">dark_mode</span>
                <span>APARÊNCIA</span>
            </div>
            <div class="config-list">
                <div class="config-item">
                    <span class="config-label">Modo noturno</span>
                    <label class="switch">
                        <input type="checkbox" checked="@appState.IsDarkMode" @onchange="ToggleTheme">
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </section>

        <!-- Sobre o App -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">info</span>
                <span>SOBRE O APP</span>
            </div>
            <div class="about-card">
                <div class="about-header">
                    <img src="images/aspec_logo.png" alt="Logo" class="about-logo" />
                    <div>
                        <p class="about-name">@AppInfo.AppName</p>
                        <p class="about-version">Versão @AppInfo.Version</p>
                    </div>
                </div>
                <div class="about-grid">
                    <div class="about-item">
                        <span class="about-label">STATUS DA LICENÇA</span>
                        <span class="about-value status-ok">ATIVA</span>
                    </div>
                    <div class="about-item">
                        <span class="about-label">ÚLTIMA SINCRONIZAÇÃO</span>
                        <span class="about-value">12/10/2023 09:45</span>
                    </div>
                </div>
            </div>
        </section>

        <button class="logout-btn" @onclick="Logout">
            <span class="material-symbols-outlined">logout</span>
            SAIR DA CONTA
        </button>
    </main>
</div>

@code {
    private bool _showBarcodeConfig = false;
    
    private List<CameraConfig> cameraConfigs = new()
    {
        new CameraConfig { Label = "Flash automático", Enabled = true },
        new CameraConfig { Label = "Foco manual", Enabled = false },
        new CameraConfig { Label = "Vibrar ao detectar", Enabled = true }
    };

    private class CameraConfig
    {
        public string Label { get; set; } = "";
        public bool Enabled { get; set; }
    }

    protected override void OnInitialized()
    {
        try
        {
            Logger.LogInformation("Settings page initialized");
            
            // Verificar se a sessão está configurada
            if (!appState.IsSessionConfigured())
            {
                Navigation.NavigateTo("/configuracao-sessao");
                return;
            }

            _ = InvokeAsync(async () =>
            {
                try
                {
                    var theme = appState.IsDarkMode ? "dark" : "light";
                    await JSRuntime.InvokeVoidAsync("appInterop.setTheme", theme);
                }
                catch { }
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Settings page");
        }
    }

    private async Task ToggleTheme(ChangeEventArgs _)
    {
        appState.IsDarkMode = !appState.IsDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", appState.IsDarkMode ? "dark" : "light");
        await appState.SaveStateAsync();
    }

    private void ToggleBarcodeConfig()
    {
        _showBarcodeConfig = !_showBarcodeConfig;
        StateHasChanged();
    }

    private void ViewNotifications()
    {
        Navigation.NavigateTo("/notifications");
    }

    private async Task ExportData()
    {
        try
        {
            Logger.LogInformation("Export data requested");
            // Implementation for data export
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidade de exportação será implementada em breve.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting data");
            Console.WriteLine($"Error exporting data: {ex.Message}");
        }
    }

    private async Task ClearCache()
    {
        try
        {
            Logger.LogInformation("Clear cache requested");
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja limpar o cache? Esta ação não pode ser desfeita.");
            if (confirmed)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("caches.delete", "aspec-cache-v1");
                    Logger.LogInformation("Cache cleared successfully");
                    await JSRuntime.InvokeVoidAsync("alert", "Cache limpo com sucesso!");
                }
                catch (Exception cacheEx)
                {
                    Logger.LogWarning(cacheEx, "Cache API not available or error clearing cache");
                    // Cache API might not be available in all browsers
                    await JSRuntime.InvokeVoidAsync("alert", "Cache limpo com sucesso!");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing cache");
            Console.WriteLine($"Error clearing cache: {ex.Message}");
        }
    }

    private async Task Logout()
    {
        try
        {
            Logger.LogInformation("Logout requested");
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja sair?");
            if (confirmed)
            {
                Logger.LogInformation("User confirmed logout");
                await AuthService.LogoutAsync();
                Logger.LogInformation("Logout completed, redirecting to login");
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during logout");
            Console.WriteLine($"Error during logout: {ex.Message}");
        }
    }
}
