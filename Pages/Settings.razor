@page "/settings"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Components.Configuration
@inject ILogger<Settings> Logger

<PageTitle>Ajustes - Aspec Captura</PageTitle>
<style>
    .settings-page {
        min-height: 100vh;
        background: #F8FAFC;
        display: flex;
        flex-direction: column;
    }

    .settings-header {
        display: flex;
        align-items: center;
        padding: 48px 16px 16px; /* Aumentando padding top para iOS */
        background: white;
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--color-text-primary);
        letter-spacing: 1px;
        margin-left: 8px;
    }

    .back-btn {
        background: none;
        border: none;
        color: var(--color-primary);
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
    }

    .header-spacer { flex: 1; }

    .settings-content {
        padding: 24px 16px;
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    .settings-hint {
        font-size: 12px;
        color: var(--color-text-secondary);
        margin-bottom: 32px;
    }

    .settings-section {
        margin-bottom: 32px;
    }

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 700;
        color: var(--color-text-secondary);
        margin-bottom: 12px;
        letter-spacing: 1px;
    }

    .profile-card-minimal {
        background: white;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid var(--color-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .profile-info {
        display: flex;
        align-items: center;
        gap: 12px;
        overflow: hidden;
        flex: 1;
    }

    .profile-avatar-icon {
        font-size: 40px;
        color: var(--color-primary);
        opacity: 0.2;
        flex-shrink: 0;
    }

    .profile-details {
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .profile-name {
        display: block;
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        text-transform: uppercase;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .profile-sub {
        font-size: 10px;
        color: var(--color-text-secondary);
        font-weight: 700;
    }

    .edit-btn {
        background: white;
        border: 1px solid var(--color-border);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 9px;
        font-weight: 700;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .config-list {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    .config-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
    }

    .config-item:last-child { border-bottom: none; }

    .config-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        opacity: 0.8;
    }

    .api-config {
        background: white;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid var(--color-border);
    }

    .api-input {
        width: 100%;
        height: 44px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 0 12px;
        font-size: 12px;
        font-family: monospace;
        color: var(--color-text-primary);
        margin-top: 8px;
        margin-bottom: 16px;
    }

    .test-btn {
        width: 100%;
        height: 48px;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    .test-btn .material-symbols-outlined {
        font-size: 18px;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .section-label .material-symbols-outlined {
        font-size: 16px;
        width: 16px;
        height: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .about-card {
        background: white;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid var(--color-border);
    }

    .about-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .about-logo {
        width: 40px;
        height: 40px;
        opacity: 0.4;
    }

    .about-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0;
    }

    .about-version {
        font-size: 10px;
        color: var(--color-text-secondary);
        margin: 0;
    }

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        border-top: 1px solid #f1f5f9;
        padding-top: 16px;
    }

    .about-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .about-label {
        font-size: 8px;
        font-weight: 700;
        color: var(--color-text-secondary);
    }

    .about-value {
        font-size: 10px;
        font-weight: 700;
        color: var(--color-primary);
    }

    .status-ok { color: #10B981; }

    .logout-btn {
        width: 100%;
        height: 48px;
        background: white;
        border: 1px solid #fee2e2;
        color: #ef4444;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 1px;
    }

    /* Switch Styling */
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

    .switch input { opacity: 0; width: 0; height: 0; }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #ccc;
        transition: .4s;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 14px; width: 14px;
        left: 3px; bottom: 3px;
        background-color: white;
        transition: .4s;
    }

    input:checked + .slider { background-color: var(--color-primary); }
    input:checked + .slider:before { transform: translateX(20px); }
    .slider.round { border-radius: 20px; }
    .slider.round:before { border-radius: 50%; }
</style>

<!-- Settings Container -->
<div class="settings-page">
    <!-- Header -->
    <header class="settings-header">
        <button @onclick="@(() => Navigation.NavigateTo("/"))" class="back-btn">
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h1 class="header-title">AJUSTES</h1>
        <div class="header-spacer"></div>
    </header>

    <!-- Main Content -->
    <main class="settings-content">
        <p class="settings-hint">Gerencie as preferências de operação e sistema.</p>

        <!-- Perfil do Operador -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">person</span>
                <span>PERFIL DO OPERADOR</span>
            </div>
            <div class="profile-card-minimal">
                <div class="profile-info">
                    <span class="material-symbols-outlined profile-avatar-icon">account_circle</span>
                    <div class="profile-details">
                        <span class="profile-name">@GetUserName()</span>
                        <span class="profile-sub">AGENTE PÚBLICO</span>
                    </div>
                </div>
                <button class="edit-btn">EDITAR</button>
            </div>
        </section>

        <!-- Configurações da Câmera -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">photo_camera</span>
                <span>CONFIGURAÇÕES DA CÂMERA</span>
            </div>
            <div class="config-list">
                @foreach (var config in cameraConfigs.Take(2))
                {
                    <div class="config-item">
                        <span class="config-label">@config.Label</span>
                        <label class="switch">
                            <input type="checkbox" checked="@config.Enabled" @onchange="() => config.Enabled = !config.Enabled">
                            <span class="slider round"></span>
                        </label>
                    </div>
                }
            </div>
        </section>

        <!-- Servidor / API -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">cloud_sync</span>
                <span>SERVIDOR / API</span>
            </div>
            <div class="api-config">
                <label class="input-label-mini">ENDEREÇO DO SERVIDOR</label>
                <input type="text" class="api-input" value="https://api.aspec.gov.br/v2" />
                <button class="test-btn">
                    <span class="material-symbols-outlined">language</span>
                    TESTAR CONEXÃO
                </button>
            </div>
        </section>

        <!-- Sobre o App -->
        <section class="settings-section">
            <div class="section-label">
                <span class="material-symbols-outlined">info</span>
                <span>SOBRE O APP</span>
            </div>
            <div class="about-card">
                <div class="about-header">
                    <img src="images/aspec_logo.png" alt="Logo" class="about-logo" />
                    <div>
                        <p class="about-name">@AppInfo.AppName</p>
                        <p class="about-version">Versão @AppInfo.Version</p>
                    </div>
                </div>
                <div class="about-grid">
                    <div class="about-item">
                        <span class="about-label">STATUS DA LICENÇA</span>
                        <span class="about-value status-ok">ATIVA</span>
                    </div>
                    <div class="about-item">
                        <span class="about-label">ÚLTIMA SINCRONIZAÇÃO</span>
                        <span class="about-value">12/10/2023 09:45</span>
                    </div>
                </div>
            </div>
        </section>

        <button class="logout-btn" @onclick="Logout">
            <span class="material-symbols-outlined">logout</span>
            SAIR DA CONTA
        </button>
    </main>
</div>

@code {
    private bool _showBarcodeConfig = false;
    
    private List<CameraConfig> cameraConfigs = new()
    {
        new CameraConfig { Label = "Flash automático", Enabled = true },
        new CameraConfig { Label = "Foco manual", Enabled = false },
        new CameraConfig { Label = "Vibrar ao detectar", Enabled = true }
    };

    private class CameraConfig
    {
        public string Label { get; set; } = "";
        public bool Enabled { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("Settings page initialized");
            
            // Verificar se a sessão está configurada
            if (!appState.IsSessionConfigured())
            {
                Navigation.NavigateTo("/configuracao-sessao");
                return;
            }
            
            // Ensure user is loaded
            if (appState.CurrentUser == null)
            {
                Logger.LogWarning("CurrentUser is null, attempting to load from AuthService");
                var user = await AuthService.GetCurrentUserAsync();
                if (user != null)
                {
                    appState.CurrentUser = user;
                }
            }
            
            Logger.LogInformation($"Settings loaded. User: {appState.CurrentUser?.NomeCompleto ?? "Unknown"}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Settings page");
        }
    }

    private string GetUserName()
    {
        if (appState?.CurrentUser == null)
        {
            Logger.LogWarning("CurrentUser is null in GetUserName");
            return "Usuário";
        }
        return !string.IsNullOrEmpty(appState.CurrentUser.NomeCompleto) 
            ? appState.CurrentUser.NomeCompleto 
            : "Usuário";
    }

    private string GetUserEmail()
    {
        if (appState?.CurrentUser == null)
        {
            Logger.LogWarning("CurrentUser is null in GetUserEmail");
            return "usuario@exemplo.com";
        }
        return !string.IsNullOrEmpty(appState.CurrentUser.UsuarioNome) 
            ? appState.CurrentUser.UsuarioNome 
            : "usuario@exemplo.com";
    }

    private async Task ToggleTheme()
    {
        appState.IsDarkMode = !appState.IsDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", appState.IsDarkMode ? "dark" : "light");
    }

    private void ToggleBarcodeConfig()
    {
        _showBarcodeConfig = !_showBarcodeConfig;
        StateHasChanged();
    }

    private void ViewNotifications()
    {
        Navigation.NavigateTo("/notifications");
    }

    private async Task ExportData()
    {
        try
        {
            Logger.LogInformation("Export data requested");
            // Implementation for data export
            await JSRuntime.InvokeVoidAsync("alert", "Funcionalidade de exportação será implementada em breve.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting data");
            Console.WriteLine($"Error exporting data: {ex.Message}");
        }
    }

    private async Task ClearCache()
    {
        try
        {
            Logger.LogInformation("Clear cache requested");
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja limpar o cache? Esta ação não pode ser desfeita.");
            if (confirmed)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("caches.delete", "aspec-cache-v1");
                    Logger.LogInformation("Cache cleared successfully");
                    await JSRuntime.InvokeVoidAsync("alert", "Cache limpo com sucesso!");
                }
                catch (Exception cacheEx)
                {
                    Logger.LogWarning(cacheEx, "Cache API not available or error clearing cache");
                    // Cache API might not be available in all browsers
                    await JSRuntime.InvokeVoidAsync("alert", "Cache limpo com sucesso!");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing cache");
            Console.WriteLine($"Error clearing cache: {ex.Message}");
        }
    }

    private async Task Logout()
    {
        try
        {
            Logger.LogInformation("Logout requested");
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja sair?");
            if (confirmed)
            {
                Logger.LogInformation("User confirmed logout");
                await AuthService.LogoutAsync();
                Logger.LogInformation("Logout completed, redirecting to login");
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during logout");
            Console.WriteLine($"Error during logout: {ex.Message}");
        }
    }
}