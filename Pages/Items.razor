@page "/"
@page "/bens"
@layout pwa_camera_poc_blazor.Components.Layout.AppLayout
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Components.Cards
@using pwa_camera_poc_blazor.Services.Utils

@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Bens - Aspec Captura</PageTitle>

@* ── App Header ── *@
<header class="app-header">
    <div class="header-brand">
        <img src="images/aspec_logo.png" alt="Aspec" class="brand-logo" />
        <span class="brand-name">Aspec Captura</span>
    </div>
    <div class="header-actions">
        <button class="header-action" title="Sincronização" @onclick='() => Navigation.NavigateTo("/sync")'>
            <span class="material-symbols-outlined">sync</span>
        </button>
        <button class="header-action" title="Ajustes" @onclick='() => Navigation.NavigateTo("/settings")'>
            <span class="material-symbols-outlined">settings</span>
        </button>
    </div>
</header>

@* ── Sticky Search ── *@
<div class="search-bar">
    <div class="search-row">
        <span class="material-symbols-outlined search-icon">search</span>
        <input type="search"
               class="search-input"
               placeholder="Buscar bem ou descrição..."
               value="@searchQuery"
               @oninput="OnSearchChanged" />
    </div>
    <button class="scan-cta" title="Nova Captura" @onclick='() => Navigation.NavigateTo("/camera")'>
        <span class="material-symbols-outlined">qr_code_scanner</span>
        <span class="scan-cta-text">ESCANEAR BEM</span>
    </button>
</div>

@* ── Horizontal Filter Tabs ── *@
<div class="filter-tabs-wrapper">
    <div class="filter-tabs">
        <button class="filter-tab @(selectedStatus == null ? "active" : "")" @onclick='() => SetStatus(null)'>TODOS</button>
        @foreach (var status in Enum.GetValues<BemStatus>())
        {
            <button class="filter-tab @(selectedStatus == status ? "active" : "")" @onclick='() => SetStatus(status)'>
                @status.ToDisplayText().ToUpper()
            </button>
        }
    </div>
</div>

@* ── Summary Bar ── *@
<div class="summary-bar">
    <span class="summary-count">
        <span class="summary-number">@filteredBens.Count()</span>
        BENS
    </span>
    <span class="summary-divider">|</span>
    <span class="summary-uo">@(appState.CurrentUO?.NomeUO ?? "Unidade não selecionada")</span>
</div>

@* ── Bens List ── *@
<div class="bens-list">
    @if (isLoading)
    {
        <div class="state-container">
            <div class="spinner-ring"></div>
            <span class="state-label">Carregando bens...</span>
        </div>
    }
    else if (!filteredBens.Any())
    {
        <div class="state-container">
            <span class="material-symbols-outlined state-icon">inventory_2</span>
            <span class="state-label">Nenhum bem encontrado</span>
            <span class="state-hint">Tente outro filtro ou termo de busca</span>
        </div>
    }
    else
    {
        @foreach (var bem in pagedBens)
        {
            <PatrimonioCard Item="@bem" LocalItem="@TryGetLocal(bem)" OnView="NavigateToBem" />
        }

        @if (totalPages > 1)
        {
            <div class="pagination">
                <button class="pag-btn" disabled="@(currentPage == 1)" @onclick="PrevPage">
                    <span class="material-symbols-outlined">chevron_left</span>
                    ANTERIOR
                </button>
                <span class="pag-info">@currentPage / @totalPages</span>
                <button class="pag-btn" disabled="@(currentPage == totalPages)" @onclick="NextPage">
                    PRÓXIMA
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        }
    }
</div>



<style>
