</style>

@code {
    private List<PatrimonioItem> items = new();
    private Dictionary<string, InventoryItem> _localByNutomb = new(StringComparer.OrdinalIgnoreCase);
    private string searchQuery = "";
    private string selectedStatus = "todos";
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }

        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var versionKey = $"versao:{user.Prefixo?.Trim().ToUpperInvariant()}";
        var baseVersion = await DbService.GetMetadataAsync(versionKey);
        if (string.IsNullOrWhiteSpace(baseVersion))
        {
            Navigation.NavigateTo("/tombamentos-sync");
            return;
        }

        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange() => await InvokeAsync(StateHasChanged);

    private async Task LoadItems()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            if (appState.CurrentUO != null)
            {
                var localItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                _localByNutomb = localItems
                    .Where(i => !string.IsNullOrWhiteSpace(i.Code))
                    .GroupBy(i => i.Code, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.UpdatedAt).First(), StringComparer.OrdinalIgnoreCase);

                var allPatrimonio = await DbService.GetPatrimonioByUOAsync(appState.CurrentUO.IdUO);
                var esfera = appState.EsferaAtual ?? user.Esfera;

                items = (!string.IsNullOrEmpty(esfera) && esfera != "A")
                    ? allPatrimonio.Where(i => string.Equals(i.Esfera, esfera, StringComparison.OrdinalIgnoreCase)).ToList()
                    : allPatrimonio.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading items: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetStatus(string status)
    {
        selectedStatus = status;
        currentPage = 1;
    }

    private InventoryItem? TryGetLocal(PatrimonioItem p)
        => _localByNutomb.TryGetValue(p.Nutomb, out var local) ? local : null;

    private IEnumerable<PatrimonioItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            result = selectedStatus switch
            {
                "operacao" => result.Where(p =>
                {
                    var local = TryGetLocal(p);
                    if (local == null) return true;
                    if (local.Status == "baixado") return false;
                    return local.State == ConservationState.Good || local.State == ConservationState.New;
                }),
                "manutencao" => result.Where(p =>
                {
                    var local = TryGetLocal(p);
                    if (local == null) return false;
                    if (local.Status == "baixado") return false;
                    return local.State == ConservationState.Regular || local.State == ConservationState.Recoverable;
                }),
                "baixado" => result.Where(p =>
                {
                    var local = TryGetLocal(p);
                    return local?.Status == "baixado";
                }),
                "inativos" => result.Where(p =>
                {
                    var local = TryGetLocal(p);
                    return local?.State == ConservationState.Unrecoverable;
                }),
                _ => result
            };

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(p =>
                {
                    if (p.Deprod.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) return true;
                    if (p.Nutomb.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) return true;
                    var local = TryGetLocal(p);
                    return local?.Location?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true;
                });
            }

            return result.OrderByDescending(p => TryGetLocal(p)?.UpdatedAt ?? DateTime.MinValue)
                .ThenBy(p => p.Nutomb);
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / PageSize);
    private IEnumerable<PatrimonioItem> pagedItems => filteredItems.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItem(PatrimonioItem item) => Navigation.NavigateTo($"/item/{item.Nutomb}");

    public void Dispose() => appState.OnChange -= HandleStateChange;
}
