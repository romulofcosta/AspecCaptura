</style>

@code {
    private List<PatrimonioItem> bens = new();
    private List<PatrimonioItem> filteredBens = new();
    private Dictionary<string, InventoryItem> _localByNutomb = new(StringComparer.OrdinalIgnoreCase);
    private string searchQuery = "";
    private BemStatus? selectedStatus = null;
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }

        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var versionKey = $"versao:{user.Prefixo?.Trim().ToUpperInvariant()}";
        var baseVersion = await DbService.GetMetadataAsync(versionKey);
        if (string.IsNullOrWhiteSpace(baseVersion))
        {
            Navigation.NavigateTo("/tombamentos-sync");
            return;
        }

        appState.OnChange += HandleStateChange;
        await LoadBens();
    }

    private async void HandleStateChange()
    {
        await LoadBens();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBens()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            if (appState.CurrentUO != null)
            {
                var localBens = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                _localByNutomb = localBens
                    .Where(b => !string.IsNullOrWhiteSpace(b.Code))
                    .GroupBy(b => b.Code, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.UpdatedAt).First(), StringComparer.OrdinalIgnoreCase);

                Console.WriteLine($"[Bens.LoadBens] Local bens loaded: {localBens.Count}");

                // Carrega patrimônio filtrado por subárea (se configurada)
                var allPatrimonio = await DbService.GetPatrimonioBySubareaAsync(
                    appState.CurrentUO.IdUO,
                    appState.CurrentArea?.IdArea,
                    appState.CurrentSubarea?.IdSubarea
                );
                
                Console.WriteLine($"[Bens.LoadBens] Patrimonio loaded from DB: {allPatrimonio.Count}");
                Console.WriteLine($"[Bens.LoadBens] UO: {appState.CurrentUO.IdUO}, Area: {appState.CurrentArea?.IdArea}, Subarea: {appState.CurrentSubarea?.IdSubarea}");
                
                // Debug: verificar valores de esfera nos dados
                if (allPatrimonio.Count > 0)
                {
                    var esferasDistintas = allPatrimonio.Select(b => b.Esfera).Distinct().ToList();
                    Console.WriteLine($"[Bens.LoadBens] Esferas distintas no DB: {string.Join(", ", esferasDistintas.Select(e => $"'{e}'"))}");
                }
                
                var esfera = appState.EsferaAtual ?? user.Esfera;
                Console.WriteLine($"[Bens.LoadBens] Esfera do filtro: '{esfera}' (EsferaAtual: '{appState.EsferaAtual}', user.Esfera: '{user.Esfera}')");

                bens = (!string.IsNullOrEmpty(esfera) && esfera != "A")
                    ? allPatrimonio.Where(b => string.Equals(b.Esfera, esfera, StringComparison.OrdinalIgnoreCase)).ToList()
                    : allPatrimonio.ToList();
                
                Console.WriteLine($"[Bens.LoadBens] Bens after esfera filter ({esfera}): {bens.Count}");
                
                // Aplica filtros após carregar
                ApplyFilters();
            }
            else
            {
                Console.WriteLine("[Bens.LoadBens] CurrentUO is null!");
                bens = new List<PatrimonioItem>();
                filteredBens = new List<PatrimonioItem>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading bens: {ex.Message}");
            Console.Error.WriteLine($"Stack trace: {ex.StackTrace}");
            bens = new List<PatrimonioItem>();
            filteredBens = new List<PatrimonioItem>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyFilters()
    {
        Console.WriteLine($"[Bens.ApplyFilters] Starting with {bens.Count} bens");
        Console.WriteLine($"[Bens.ApplyFilters] Selected status: {selectedStatus?.ToString() ?? "null (TODOS)"}");
        Console.WriteLine($"[Bens.ApplyFilters] Local items count: {_localByNutomb.Count}");
        
        var result = bens.AsEnumerable();

        // Filtro por situação (BemStatus)
        // IMPORTANTE: Quando selectedStatus é null (aba "TODOS"), NENHUM filtro é aplicado
        // Todos os bens da localização são exibidos, independente de terem captura local
        if (selectedStatus.HasValue)
        {
            var beforeFilter = result.Count();
            result = FilterByStatus(result, selectedStatus.Value);
            var afterFilter = result.Count();
            Console.WriteLine($"[Bens.ApplyFilters] After status filter ({selectedStatus.Value.ToDisplayText()}): {afterFilter} (removed {beforeFilter - afterFilter})");
        }
        else
        {
            Console.WriteLine($"[Bens.ApplyFilters] No status filter applied (showing all {result.Count()} bens)");
        }

        // Filtro por busca (termo de pesquisa)
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var beforeSearch = result.Count();
            result = FilterBySearchQuery(result, searchQuery);
            var afterSearch = result.Count();
            Console.WriteLine($"[Bens.ApplyFilters] After search filter: {afterSearch} (removed {beforeSearch - afterSearch})");
        }

        // Ordena e materializa a lista
        // Bens com captura local mais recente aparecem primeiro
        filteredBens = result
            .OrderByDescending(b => TryGetLocal(b)?.UpdatedAt ?? DateTime.MinValue)
            .ThenBy(b => b.Nutomb)
            .ToList();
        
        Console.WriteLine($"[Bens.ApplyFilters] Final filtered bens: {filteredBens.Count}");
        
        // Reset para primeira página quando filtros mudam
        currentPage = 1;
    }

    /// <summary>
    /// Filtra bens por situação (BemStatus).
    /// Retorna apenas bens que possuem captura local E o status correspondente.
    /// Bens sem captura local são automaticamente excluídos deste filtro.
    /// </summary>
    private IEnumerable<PatrimonioItem> FilterByStatus(IEnumerable<PatrimonioItem> bens, BemStatus status)
    {
        return bens.Where(b =>
        {
            var local = TryGetLocal(b);
            // Apenas bens com captura local (local != null) E status correspondente
            return local != null && local.Status == status;
        });
    }

    /// <summary>
    /// Filtra bens por termo de busca.
    /// Busca em: código (nutomb), descrição (deprod) e localização.
    /// </summary>
    private IEnumerable<PatrimonioItem> FilterBySearchQuery(IEnumerable<PatrimonioItem> bens, string query)
    {
        return bens.Where(b =>
        {
            if (b.Deprod.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
            if (b.Nutomb.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
            var local = TryGetLocal(b);
            return local?.Location?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
        });
    }

    private void SetStatus(BemStatus? status)
    {
        selectedStatus = status;
        ApplyFilters();
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
        StateHasChanged();
    }

    private InventoryItem? TryGetLocal(PatrimonioItem p)
        => _localByNutomb.TryGetValue(p.Nutomb, out var local) ? local : null;

    private int totalPages => filteredBens.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredBens.Count / PageSize);
    private IEnumerable<PatrimonioItem> pagedBens => filteredBens.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private void PrevPage() 
    { 
        if (currentPage > 1) 
        {
            currentPage--;
            StateHasChanged();
        }
    }
    
    private void NextPage() 
    { 
        if (currentPage < totalPages) 
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private void NavigateToBem(PatrimonioItem bem) => Navigation.NavigateTo($"/bem/{bem.Nutomb}");

    public void Dispose() => appState.OnChange -= HandleStateChange;
}
