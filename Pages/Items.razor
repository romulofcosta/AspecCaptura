@page "/"
@page "/items"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Components.Cards

@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Itens - Aspec Captura</PageTitle>

@* ── App Header ── *@
<header class="app-header">
    <div class="header-brand">
        <img src="images/aspec_logo.png" alt="Aspec" class="brand-logo" />
        <span class="brand-name">Aspec Captura</span>
    </div>
    <div class="header-actions">
        <button class="header-action" title="Sincronização" @onclick='() => Navigation.NavigateTo("/sync")'>
            <span class="material-symbols-outlined">sync</span>
        </button>
        <button class="header-action" title="Ajustes" @onclick='() => Navigation.NavigateTo("/settings")'>
            <span class="material-symbols-outlined">settings</span>
        </button>
    </div>
</header>

@* ── Sticky Search ── *@
<div class="search-bar">
    <span class="material-symbols-outlined search-icon">search</span>
    <input type="search"
           class="search-input"
           placeholder="Buscar patrimônio ou descrição..."
           @bind="searchQuery"
           @bind:event="oninput" />
    <button class="scan-btn-top" title="Nova Captura" @onclick='() => Navigation.NavigateTo("/camera")'>
        <span class="material-symbols-outlined">qr_code_scanner</span>
        <span class="scan-btn-text">SCAN</span>
    </button>
</div>

@* ── Horizontal Filter Tabs ── *@
<div class="filter-tabs-wrapper">
    <div class="filter-tabs">
        <button class="filter-tab @(selectedStatus == "todos" ? "active" : "")" @onclick='() => SetStatus("todos")'>TODOS</button>
        <button class="filter-tab @(selectedStatus == "operacao" ? "active" : "")" @onclick='() => SetStatus("operacao")'>EM OPERAÇÃO</button>
        <button class="filter-tab @(selectedStatus == "manutencao" ? "active" : "")" @onclick='() => SetStatus("manutencao")'>MANUTENÇÃO</button>
        <button class="filter-tab @(selectedStatus == "baixado" ? "active" : "")" @onclick='() => SetStatus("baixado")'>BAIXADO</button>
        <button class="filter-tab @(selectedStatus == "inativos" ? "active" : "")" @onclick='() => SetStatus("inativos")'>EM BAIXA</button>
    </div>
</div>

@* ── Summary Bar ── *@
<div class="summary-bar">
    <span class="summary-count">
        <span class="summary-number">@filteredItems.Count()</span>
        BENS
    </span>
    <span class="summary-divider">|</span>
    <span class="summary-uo">@(appState.CurrentUO?.NomeUO ?? "Unidade não selecionada")</span>
</div>

@* ── Items List ── *@
<div class="items-list">
    @if (isLoading)
    {
        <div class="state-container">
            <div class="spinner-ring"></div>
            <span class="state-label">Carregando bens...</span>
        </div>
    }
    else if (!filteredItems.Any())
    {
        <div class="state-container">
            <span class="material-symbols-outlined state-icon">inventory_2</span>
            <span class="state-label">Nenhum bem encontrado</span>
            <span class="state-hint">Tente outro filtro ou termo de busca</span>
        </div>
    }
    else
    {
        @foreach (var item in pagedItems)
        {
            <ItemCard Item="@item" OnView="NavigateToItem" />
        }

        @if (totalPages > 1)
        {
            <div class="pagination">
                <button class="pag-btn" disabled="@(currentPage == 1)" @onclick="PrevPage">
                    <span class="material-symbols-outlined">chevron_left</span>
                    ANTERIOR
                </button>
                <span class="pag-info">@currentPage / @totalPages</span>
                <button class="pag-btn" disabled="@(currentPage == totalPages)" @onclick="NextPage">
                    PRÓXIMA
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        }
    }
</div>



