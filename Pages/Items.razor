@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private string selectedStatus = "todos";
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }

        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange() => await InvokeAsync(StateHasChanged);

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            if (appState.CurrentUO != null)
            {
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                var esfera = appState.EsferaAtual ?? user.Esfera;
                items = (!string.IsNullOrEmpty(esfera) && esfera != "A")
                    ? allItems.Where(i => i.Esfera == esfera).ToList()
                    : allItems.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading items: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetStatus(string status)
    {
        selectedStatus = status;
        currentPage = 1;
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            result = selectedStatus switch
            {
                "operacao" => result.Where(i => i.Status != "baixado" && (i.State == ConservationState.Good || i.State == ConservationState.New)),
                "manutencao" => result.Where(i => i.Status != "baixado" && (i.State == ConservationState.Regular || i.State == ConservationState.Recoverable)),
                "baixado" => result.Where(i => i.Status == "baixado"),
                "inativos" => result.Where(i => i.State == ConservationState.Unrecoverable),
                _ => result
            };

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                    i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Location.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            return result.OrderByDescending(i => i.UpdatedAt);
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / PageSize);
    private IEnumerable<InventoryItem> pagedItems => filteredItems.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItem(InventoryItem item) => Navigation.NavigateTo($"/item/{item.Id}");

    public void Dispose() => appState.OnChange -= HandleStateChange;
}