@page "/captura"
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Services.Camera
@using pwa_camera_poc_blazor.Services.Ocr
@using pwa_camera_poc_blazor.Services.Scanning
@inject IJSRuntime JSRuntime
@inject pwa_camera_poc_blazor.Services.Scanning.ScanOrchestrator _scanOrchestratorService
@inject pwa_camera_poc_blazor.Services.UnidadesGestoras.UGStateService _ugStateService
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject OcrService _ocrService
@inject CameraService _cameraService
@inject HttpClient HttpClient
@inject AppState appState
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Capturar - ASPEC Capture</PageTitle>

@if (isFormVisible)
{
    <div class="d-flex flex-column" style="height: 100%; position: relative;">
        <!-- Scrollable Content Area -->
        <div class="flex-grow-1 overflow-y-auto pa-4" style="padding-bottom: 120px !important;">
            <MudCard Elevation="4" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Adicionar Informações</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelForm" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudPaper id="photo-preview-container" Class="mb-4 d-flex justify-center align-center grey lighten-3" Elevation="0"
                        Style="height: 250px; overflow: hidden; position: relative; user-select: none;">
                        @if (capturedPhotos.Any())
                        {
                            <MudImage Src="@capturedPhotos[currentPreviewIndex]" ObjectFit="ObjectFit.Cover"
                                Style="width:100%; height:100%;" Class="fade-in" />
                            
                            <!-- Swipe Indicators -->
                            @if (currentPreviewIndex > 0)
                            {
                                <div style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; padding: 8px; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                                </div>
                            }
                            @if (currentPreviewIndex < capturedPhotos.Count - 1)
                            {
                                <div style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.4); color: white; padding: 8px; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                </div>
                            }
                            
                            <!-- Photo Counter -->
                            <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.6); color: white; padding: 4px 12px; border-radius: 16px; font-size: 12px; font-weight: 500;">
                                @(currentPreviewIndex + 1) / @capturedPhotos.Count
                            </div>
                        }
                    </MudPaper>

                    <div class="d-flex gap-2 mb-4 overflow-x-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto"
                            OnClick="OpenAddPhotoModal" Class="pa-4" Style="height: 60px;">
                            ADICIONAR FOTOS
                        </MudButton>
                        @for (int i = 0; i < capturedPhotos.Count; i++)
                        {
                            int index = i;
                            <div style="position: relative; width: 60px; height: 60px; flex-shrink: 0; cursor: pointer;"
                            @onclick="() => currentPreviewIndex = index">
                                <MudImage Src="@capturedPhotos[index]" ObjectFit="ObjectFit.Cover"
                                    Style="@($"width:100%; height:100%; border-radius: 4px; border: {(currentPreviewIndex == index ? "2px solid var(--mud-palette-primary)" : "none")}")" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                    Style="position: absolute; top: -5px; right: -5px; background: white;"
                                    OnClick="@((e) => RemovePhoto(index))" />
                            </div>
                        }
                    </div>

                    <EditForm EditContext="@editContext" OnValidSubmit="HandleSave" id="camera-form">
                        <DataAnnotationsValidator />
                        <MudGrid Spacing="2">
                            <!-- Section: Identificação -->
                            <MudItem xs="12">
                                <div class="d-flex align-center gap-2 mb-2 mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Identificação do Patrimônio</MudText>
                                </div>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Codigo" Label="Código/ID *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Codigo)" Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Nome" Label="Nome do Item *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Nome)" Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Categoria *</MudText>
                                <div class="mud-input-control mud-input-input-control">
                                    <div class="mud-input-control-input-container">
                                        <div class="mud-input mud-input-outlined" style="position: relative;">
                                            <select @bind="itemModel.Category" class="mud-input-slot mud-input-root mud-input-root-outlined" 
                                                    style="height: 40px; padding: 8px 14px; width: 100%; -webkit-appearance: none; appearance: none; background: transparent; z-index: 10; font-size: 0.875rem; color: var(--mud-palette-text-primary);">
                                                <option value="">Selecione a categoria</option>
                                                <option value="Móveis">Móveis</option>
                                                <option value="Eletrônicos">Eletrônicos</option>
                                                <option value="Equipamentos">Equipamentos</option>
                                                <option value="Ferramentas">Ferramentas</option>
                                                <option value="Materiais">Materiais</option>
                                                <option value="Outros">Outros</option>
                                            </select>
                                            <div class="mud-input-outlined-border"></div>
                                            <div style="position: absolute; right: 14px; top: 8px; pointer-events: none;">
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Secondary" Size="Size.Small" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </MudItem>

                            <!-- Section: Detalhes -->
                            <MudItem xs="12" Class="mt-4">
                                <div class="d-flex align-center gap-2 mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Localização e Detalhes</MudText>
                                </div>
                                <MudDivider Class="mb-4" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Localizacao" Label="Localização *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Localizacao)" Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Observacoes" Label="Observações"
                                    Variant="Variant.Outlined" Lines="2" For="@(() => itemModel.Observacoes)" Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" Class="d-flex justify-end gap-2 mt-6 pb-4">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelForm" Class="rounded-lg">
                                    Cancelar
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                    Disabled="@isSaving" StartIcon="@Icons.Material.Filled.Save" Class="rounded-lg px-6">
                                    @(isSaving ? "Salvando..." : "Salvar")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </div>

        <!-- Fixed Action Bar at Bottom -->
        <!-- Fixed Action Bar at Bottom Removed -->
    </div>
}
else
{
    <div class="camera-page-container">
        <div class="camera-viewport">
            <video id="camera-feed" autoplay playsinline 
                aria-label="Visualização da câmera para captura de patrimônio"
                role="img"></video>
            <canvas id="camera-canvas" class="d-none" aria-hidden="true"></canvas>
        </div>

        <!-- Interface da Câmera -->
        <div class="camera-overlay">
            <!-- Header Actions -->
            <div class="camera-header-actions">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                    Color="Color.Inherit" 
                    Href="/home" 
                    Class="back-btn-blur text-white"
                    aria-label="Voltar para página inicial" />
                
                <MudIconButton Icon="@(isFlashOn ? Icons.Material.Filled.FlashOn : Icons.Material.Filled.FlashOff)" 
                    Color="Color.Inherit" 
                    OnClick="ToggleFlash" 
                    Class="back-btn-blur text-white"
                    aria-label="@(isFlashOn ? "Desativar flash da câmera" : "Ativar flash da câmera")"
                    aria-pressed="@isFlashOn" />
            </div>

            <!-- ROI Guide -->
            <div class="camera-roi-guide">
                <div class="roi-scrim roi-scrim-top"></div>
                <div class="roi-center-row">
                    <div class="roi-scrim roi-scrim-side"></div>
                    <div class="roi-window @(processingStatus == "Analisando..." ? "active" : "")">
                        <div class="roi-corner roi-corner-tl"></div>
                        <div class="roi-corner roi-corner-tr"></div>
                        <div class="roi-corner roi-corner-bl"></div>
                        <div class="roi-corner roi-corner-br"></div>
                    </div>
                    <div class="roi-scrim roi-scrim-side"></div>
                </div>
                <div class="roi-scrim roi-scrim-bottom"></div>
            </div>

            <!-- Bottom Controls -->
            <div class="camera-controls-bottom">
                @if (!string.IsNullOrEmpty(processingStatus))
                {
                    <MudText Typo="Typo.h6" 
                        Class="text-white font-weight-bold animate-pulse"
                        role="status"
                        aria-live="polite"
                        aria-atomic="true">@processingStatus</MudText>
                }

                <div class="mode-toggle-pill d-flex">
                    <MudButton Variant="Variant.Text" 
                        Class="@($"mode-btn {(useOcrFlow ? "" : "active")}")"
                        OnClick="SetPhotoMode"
                        aria-label="Modo foto - capturar imagem do patrimônio"
                        aria-pressed="@(!useOcrFlow)">FOTO</MudButton>
                    <MudButton Variant="Variant.Text" 
                        Class="@($"mode-btn {(useOcrFlow ? "active" : "")}")"
                        OnClick="SetScanMode"
                        aria-label="Modo scan - escanear código do patrimônio"
                        aria-pressed="@useOcrFlow">SCAN</MudButton>
                </div>

                @if (useOcrFlow)
                {
                    <MudButton Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        FullWidth="true" 
                        Class="scan-btn" 
                        OnClick="CaptureAndProcess"
                        aria-label="Escanear código do patrimônio agora">
                        ESCANEAR AGORA
                    </MudButton>
                }
                else
                {
                    <button class="capture-btn-inner" 
                        @onclick="CaptureAndProcess"
                        aria-label="Capturar foto do patrimônio">
                        <div style="width: 60px; height: 60px; border: 2px solid #000; border-radius: 50%;"></div>
                    </button>
                }
            </div>
        </div>
    </div>
}

<MudOverlay @bind-Visible="isPhotoModalOpen" DarkBackground="true" ZIndex="2500" AutoClose="true">
    <MudPaper Class="pa-6 rounded-lg" Style="width: 320px; max-width: 90vw;">
        <MudText Typo="Typo.h6" Class="mb-4">Adicionar Fotos</MudText>
        
        <div class="d-flex flex-column gap-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Camera"
                FullWidth="true" OnClick="TakePhotoFromModal" Style="height: 56px;">
                Tirar Foto
            </MudButton>
            
            <div style="position: relative; width: 100%;">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                    FullWidth="true" Style="height: 56px;">
                    Fazer Upload
                </MudButton>
                <InputFile OnChange="HandleFileUpload" 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
            </div>

            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="ClosePhotoModal" FullWidth="true" Class="mt-2">
                Cancelar
            </MudButton>
        </div>
    </MudPaper>
</MudOverlay>

@if (isCameraInModalActive)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100dvh; background: black; z-index: 3000; display: flex; flex-direction: column;">
        <video id="modal-camera-feed" autoplay playsinline style="width: 100%; flex: 1; object-fit: cover;"></video>
        <MudPaper Class="d-flex justify-center align-center px-8 py-6" Style="background: rgba(0,0,0,0.8);">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Surface" Size="Size.Large" OnClick="StopModalCamera" Class="mr-8" />
            <div class="capture-btn-container">
                <MudIconButton Icon="@Icons.Material.Filled.Camera" 
                    Class="capture-btn"
                    Style="width: 64px !important; height: 64px !important;"
                    OnClick="CapturePhotoFromModal" />
            </div>
        </MudPaper>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery] public string? mode { get; set; }
    private bool isFormVisible = false;
    private List<string> capturedPhotos = new();
    private int currentPreviewIndex = 0;
    private ItemPatrimonio itemModel = new();
    private bool isSaving = false;
    private Usuario? currentUser;
    private EditContext? editContext;
    private bool isScanning = false;
    private System.Threading.CancellationTokenSource? scanCts;
    private string lastDetectedCode = "";
    private bool isManualScanTriggered = false;
    private bool isPhotoModalOpen = false;
    private bool isCameraInModalActive = false;
    private DotNetObjectReference<Camera>? dotNetHelper;
    
    // New properties for the updated camera UI
    private bool isFlashOn = false;
    private bool useOcrFlow = true; // Controls between photo and scan mode
    private string processingStatus = ""; // Status message for OCR/Barcode processing

    protected override async Task OnInitializedAsync()
    {
        appState.IsCameraActive = true;
        currentUser = await AuthService.GetCurrentUserAsync();

        // GATEKEEPER UG: Validação obrigatória antes de iniciar qualquer recurso
        try 
        {
            await _ugStateService.ValidateAndLoadAsync();
            // Se chegou aqui, a UG está válida e carregada.
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Bloqueio de Segurança: {ex.Message}");
            Navigation.NavigateTo("/home");
            return;
        }

        await _ocrService.InitializeAsync();
        
        // Reset item for new capture
        itemModel = new ItemPatrimonio();
        capturedPhotos.Clear();

        // Handle mode parameter from query string
        if (mode == "manual")
        {
            isFormVisible = true;
            editContext = new EditContext(itemModel);
        }
        else if (mode == "photo")
        {
            isFormVisible = false;
            useOcrFlow = false; // Start in photo mode
        }
        else if (mode == "scan")
        {
            isFormVisible = false;
            useOcrFlow = true; // Start in scan mode
        }
        else
        {
            // Default behavior - start in scan mode
            isFormVisible = false;
            useOcrFlow = true;
        }
    }
    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isFormVisible)
        {
            // Fix: Start camera regardless of mode if form is not visible
            // Added small delay to ensure video element is ready in DOM
            await Task.Delay(300);
            await StartCamera();

            if (useOcrFlow) // Only start scanning if in OCR/Scan mode
            {
                StartScanning();
            }
        }
        
        // Initialize swipe gestures when form becomes visible and has photos
        if (isFormVisible && capturedPhotos.Any() && dotNetHelper == null)
        {
            try
            {
                dotNetHelper = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("gestureHandler.initSwipeGestures", "photo-preview-container", dotNetHelper);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing gestures: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public void OnSwipeLeft()
    {
        if (capturedPhotos.Any() && currentPreviewIndex < capturedPhotos.Count - 1)
        {
            currentPreviewIndex++;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSwipeRight()
    {
        if (capturedPhotos.Any() && currentPreviewIndex > 0)
        {
            currentPreviewIndex--;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSwipeUp() { }

    [JSInvokable]
    public void OnSwipeDown() { }

    private void StartScanning()
    {
        if (isScanning || !useOcrFlow) return; // Use useOcrFlow to check if scanning is allowed
        isScanning = true;
        scanCts = new System.Threading.CancellationTokenSource();
        _ = ScanLoop(scanCts.Token);
    }

    private async Task ScanLoop(System.Threading.CancellationToken token)
    {
        while (!token.IsCancellationRequested && !isFormVisible && useOcrFlow) // Add useOcrFlow condition
        {
            try
            {
                // ROI centralizada (80% largura, 150px altura aproximada em percentual)
                var roi = new { x = 0.1, y = 0.4, width = 0.8, height = 0.2 };
                var frame = await _cameraService.CaptureFrameForOcrAsync("camera-feed", roi);
                
                if (!string.IsNullOrEmpty(frame))
                {
                    var result = await _ocrService.ReconhecerTextoAsync(frame);
                    
                    // Lógica de Feedback Visual (Scan Contínuo)
                    if (!string.IsNullOrEmpty(result.Text) && result.Confidence > 60)
                    {
                        // Validação leve apenas para feedback visual (Regex inline)
                        var match = System.Text.RegularExpressions.Regex.Match(result.Text, @"[0-9A-Z\-\.\/]{4,}");
                        if (match.Success)
                        {
                            var potentialCode = match.Value;
                            lastDetectedCode = potentialCode;
                            processingStatus = $"Detectado: {potentialCode}"; // Update processing status
                            StateHasChanged();
                        }
                    }

                    // If manual scan was triggered, process the found code
                    if (isManualScanTriggered)
                    {
                        await ProcessFoundCode(result.Text, result.Confidence);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro no ScanLoop: {ex.Message}");
            }
            
            await Task.Delay(1000, token); // Intervalo entre leituras
        }
    }

    private void SetScanningStatus()
    {
        if (!isManualScanTriggered)
        {
            processingStatus = ""; // Clear processing status
        }
    }

    private void ManualScanTrigger()
    {
        isManualScanTriggered = true;
        processingStatus = "Analisando..."; // Update processing status
        StateHasChanged();
    }

    private async Task CaptureAndProcess()
    {
        if (useOcrFlow)
        {
            // Trigger manual scan for OCR
            ManualScanTrigger();
        }
        else
        {
            // Capture photo
            var photoData = await _cameraService.CapturarImagemAsync("camera-feed");
            if (!string.IsNullOrEmpty(photoData))
            {
                capturedPhotos.Add(photoData);
                currentPreviewIndex = capturedPhotos.Count - 1;
                await _cameraService.PararCameraAsync("camera-feed");
                
                // Initialize EditContext
                editContext = new EditContext(itemModel);
                
                isFormVisible = true;
            }
        }
    }

    /// <summary>
    /// Processa código extraído delegando a decisão para o ScanOrchestrator.
    /// </summary>
    private async Task ProcessFoundCode(string rawText, double confidence)
    {
        isManualScanTriggered = false;
        
        // Delega decisão complexa para o orquestrador (ScanOrchestratorService)
        var decision = await _scanOrchestratorService.ProcessScanAsync(rawText, confidence);
        
        switch (decision.ResultType)
        {
            case ScanResultType.Success:
                // Preenche formulário com dados oficiais
                itemModel.Codigo = decision.ExtractedCode;
                itemModel.Nome = decision.OfficialItem!.Nome;
                itemModel.Category = decision.OfficialItem!.Category;
                itemModel.Localizacao = decision.OfficialItem!.Localizacao;
                
                ToastService.ShowInfo(decision.Message);
                await StopScanningAndShowForm();
                break;
            case ScanResultType.AlreadyRegistered:
                // Já existe localmente
                itemModel = decision.LocalItem!;
                ToastService.ShowSuccess(decision.Message);
                await StopScanningAndShowForm();
                break;
            case ScanResultType.ItemNotFoundInUg:
            case ScanResultType.ValidationFailed:
            case ScanResultType.ReadError:
            default:
                // Feedback de erro visual na área de scan
                processingStatus = decision.Message; // Update processing status
                
                // Se for erro crítico de UG, mostra toast também
                if (decision.ResultType == ScanResultType.ItemNotFoundInUg)
                {
                    ToastService.ShowInfo(decision.Message); 
                }
                
                StateHasChanged();
                await Task.Delay(2000); 
                SetScanningStatus();
                break;
        }
    }

    private async Task StopScanningAndShowForm()
    {
        isScanning = false;
        scanCts?.Cancel();
        await _cameraService.PararCameraAsync("camera-feed");
        
        editContext = new EditContext(itemModel);
        isFormVisible = true;
        StateHasChanged();
    }

    private async Task SetFlow(bool ocrFlow)
    {
        if (useOcrFlow == ocrFlow) return;

        // Stop current flow
        if (useOcrFlow) // Was in OCR/Scan mode
        {
            scanCts?.Cancel();
            isScanning = false;
            processingStatus = "";
        }
        else // Was in Photo mode
        {
            // No specific stop needed for photo mode, camera is always on
        }

        useOcrFlow = ocrFlow;
        StateHasChanged();
        await Task.Delay(100); // Allow UI to update

        // Start new flow
        if (useOcrFlow) // Transitioning to OCR/Scan mode
        {
            StartScanning();
        }
        else // Transitioning to Photo mode
        {
            // No specific start needed, camera is already on
        }
    }

    private async Task ToggleFlash()
    {
        isFlashOn = !isFlashOn;
        // In a real implementation, we would call a JS interop to toggle the camera flash
        // For this POC, we just toggle the state for UI feedback
        try 
        {
            await JSRuntime.InvokeVoidAsync("cameraInterop.toggleFlash", "camera-feed", isFlashOn);
        }
        catch { /* Flash might not be supported on all devices */ }
    }

    private void SetPhotoMode() => SetFlow(false);
    private void SetScanMode() => SetFlow(true);

    private async Task OnBarcodeDetected(string barcode)
    {
        // ZXing detectou algo! Passamos para o orquestrador com confiança 100
        await ProcessFoundCode(barcode, 100);
    }

    private async Task StartCamera()
    {
        try
        {
            await _cameraService.IniciarCameraAsync("camera-feed", false);
            appState.IsCameraActive = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private void OpenAddPhotoModal() => isPhotoModalOpen = true;
    private void ClosePhotoModal() => isPhotoModalOpen = false;

    private async Task TakePhotoFromModal()
    {
        isPhotoModalOpen = false;
        isCameraInModalActive = true;
        await Task.Delay(100);
        await _cameraService.IniciarCameraAsync("modal-camera-feed", false);
    }

    private async Task StopModalCamera()
    {
        await _cameraService.PararCameraAsync("modal-camera-feed");
        isCameraInModalActive = false;
        isPhotoModalOpen = true;
    }

    private async Task CapturePhotoFromModal()
    {
        var photoData = await _cameraService.CapturarImagemAsync("modal-camera-feed");
        if (!string.IsNullOrEmpty(photoData))
        {
            capturedPhotos.Add(photoData);
            currentPreviewIndex = capturedPhotos.Count - 1;
            await StopModalCamera();
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5).ReadAsync(buffer);
            var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            capturedPhotos.Add(base64);
            currentPreviewIndex = capturedPhotos.Count - 1;
            ClosePhotoModal();
        }
    }

    private async Task CapturePhoto()
    {
        var photoData = await _cameraService.CapturarImagemAsync("camera-feed");
        if (!string.IsNullOrEmpty(photoData))
        {
            capturedPhotos.Add(photoData);
            currentPreviewIndex = capturedPhotos.Count - 1;
            await _cameraService.PararCameraAsync("camera-feed");
            
            // Initialize EditContext
            editContext = new EditContext(itemModel);
            
            isFormVisible = true;
        }
    }

    private async Task AddMorePhoto()
    {
        isFormVisible = false;
        await Task.Delay(100);
        await StartCamera();
    }

    private void RemovePhoto(int index)
    {
        capturedPhotos.RemoveAt(index);
        if (currentPreviewIndex >= capturedPhotos.Count) currentPreviewIndex = Math.Max(0, capturedPhotos.Count - 1);
        if (capturedPhotos.Count == 0) CancelForm();
    }

    private async Task HandleSave()
    {
        if (isSaving) return;
        isSaving = true;
        try
        {
            itemModel.Photos = capturedPhotos;
            itemModel.UnidadeGestoraId = currentUser?.UnidadeGestoraAtualId;
            itemModel.CriadoPor = currentUser?.NomeUsuario ?? string.Empty; // Define o criador
            itemModel.DataHora = DateTime.Now;
            itemModel.Sincronizado = false;
            await DbService.AddAsync("items", itemModel);
            appState.PendingSyncCount++;
            ToastService.ShowSuccess("Item salvo com sucesso!");
            Navigation.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar item: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelForm()
    {
        isFormVisible = false;
        capturedPhotos.Clear();
        itemModel = new ItemPatrimonio();
        Navigation.NavigateTo("/home");
    }

    private void CloseCamera()
    {
        Navigation.NavigateTo("/home");
    }
    
    public async ValueTask DisposeAsync()
    {
        scanCts?.Cancel();
        await _cameraService.PararCameraAsync("camera-feed");
        appState.IsCameraActive = false;
        
        // Cleanup gesture handlers
        if (dotNetHelper != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("gestureHandler.cleanup", "photo-preview-container");
            }
            catch { /* Ignore cleanup errors */ }
            dotNetHelper.Dispose();
        }
        
        // Garante liberação de memória do worker OCR ao sair da tela
        if (_ocrService != null)
        {
            await _ocrService.DisposeAsync();
        }
    }
}
