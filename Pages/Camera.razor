@page "/camera"
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Services.Camera
@inject CameraService CameraService
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService
@inject AppState appState
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Capturar - ASPEC Capture</PageTitle>

<div class="main-content">
    @if (isFormVisible)
    {
        <!-- Metadata Form -->
        <div id="metadata-form" class="metadata-form">
            <div class="form-container">
                <div class="form-header">
                    <h2>Adicionar Informações do Item</h2>
                    <button id="cancel-form-btn" class="icon-btn" @onclick="CancelForm">✕</button>
                </div>

                <div class="captured-preview">
                    @if (capturedPhotos.Any())
                    {
                        <img id="preview-image" src="@capturedPhotos[currentPreviewIndex]" alt="Foto capturada">
                    }
                </div>

                <div class="photo-tools">
                    <button id="add-photo-btn" class="icon-btn" @onclick="AddMorePhoto" title="Adicionar foto">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="7" width="18" height="14" rx="2" />
                            <path d="M9 7l1.5-2h3L15 7" />
                            <circle cx="12" cy="14" r="3" />
                        </svg>
                    </button>
                    <!-- File input logic could go here too -->
                </div>

                @if (capturedPhotos.Count > 1)
                {
                    <div class="photo-thumbs">
                        @for (int i = 0; i < capturedPhotos.Count; i++)
                        {
                            int index = i;
                            <div class="thumb @(currentPreviewIndex == index ? "active" : "")"
                            @onclick="() => currentPreviewIndex = index">
                                <img src="@capturedPhotos[index]" />
                                <button class="remove-thumb" @onclick:stopPropagation="true"
                                @onclick="() => RemovePhoto(index)">✕</button>
                            </div>
                        }
                    </div>
                }

                <EditForm Model="@itemModel" OnValidSubmit="HandleSave" id="item-form">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label for="item-name">Nome do Item *</label>
                        <InputText id="item-name" class="form-input" @bind-Value="itemModel.Name"
                            placeholder="Ex: Cadeira de escritório" required />
                    </div>

                    <div class="form-group">
                        <label for="item-code">Código/ID *</label>
                        <InputText id="item-code" class="form-input" @bind-Value="itemModel.Code" placeholder="Ex: CAD-001"
                            required />
                    </div>

                    <div class="form-group">
                        <label for="item-category">Categoria *</label>
                        <select id="item-category" @bind="itemModel.Category" required>
                            <option value="">Selecione uma categoria</option>
                            <option value="Móveis">Móveis</option>
                            <option value="Eletrônicos">Eletrônicos</option>
                            <option value="Equipamentos">Equipamentos</option>
                            <option value="Ferramentas">Ferramentas</option>
                            <option value="Materiais">Materiais</option>
                            <option value="Outros">Outros</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="item-location">Localização</label>
                        <InputText id="item-location" class="form-input" @bind-Value="itemModel.Location"
                            placeholder="Ex: Sala 201, Prateleira A" />
                    </div>

                    <div class="form-group">
                        <label for="item-observations">Observações</label>
                        <InputTextArea id="item-observations" class="form-input" @bind-Value="itemModel.Observations"
                            rows="3" placeholder="Informações adicionais sobre o item" />
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            <span>💾 @(isSaving ? "Salvando..." : "Salvar no Inventário")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
    else
    {
        <!-- Camera View -->
        <div id="camera-section" class="camera-section">
            <div class="camera-view">
                <video id="camera-feed" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                <div class="camera-controls">
                    <button id="close-camera-btn" class="icon-btn secondary" @onclick="CloseCamera">✕</button>
                    <button id="capture-btn" class="capture-btn" @onclick="CapturePhoto">
                        <div class="inner-circle"></div>
                    </button>
                    <button id="switch-camera-btn" class="icon-btn secondary" @onclick="SwitchCamera">🔄</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isFormVisible = false;
    private bool useFrontCamera = false;
    private List<string> capturedPhotos = new();
    private int currentPreviewIndex = 0;
    private InventoryItem itemModel = new();
    private bool isSaving = false;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isFormVisible)
        {
            await StartCamera();
        }
    }

    private async Task StartCamera()
    {
        try
        {
            await CameraService.StartCameraAsync("camera-feed", useFrontCamera);
        }
        catch (Exception)
        {
            ToastService.ShowError("Não foi possível acessar a câmera.");
        }
    }

    private async Task SwitchCamera()
    {
        useFrontCamera = !useFrontCamera;
        await CameraService.StopCameraAsync("camera-feed");
        await StartCamera();
    }

    private async Task CapturePhoto()
    {
        var photoData = await CameraService.TakePhotoAsync("camera-feed");
        if (!string.IsNullOrEmpty(photoData))
        {
            capturedPhotos.Add(photoData);
            currentPreviewIndex = capturedPhotos.Count - 1;
            await CameraService.StopCameraAsync("camera-feed");
            isFormVisible = true;
        }
    }

    private async Task AddMorePhoto()
    {
        isFormVisible = false;
        await Task.Delay(100); // Give UI time to update
        await StartCamera();
    }

    private void RemovePhoto(int index)
    {
        capturedPhotos.RemoveAt(index);
        if (currentPreviewIndex >= capturedPhotos.Count) currentPreviewIndex = Math.Max(0, capturedPhotos.Count - 1);
        if (capturedPhotos.Count == 0) CancelForm();
    }

    private async Task HandleSave()
    {
        if (isSaving) return;
        isSaving = true;

        try
        {
            itemModel.Photos = capturedPhotos;
            itemModel.UnitId = currentUser?.CurrentUnitId;
            itemModel.Timestamp = DateTime.Now;
            itemModel.Synced = false;

            await DbService.AddAsync("items", itemModel);
            appState.PendingSyncCount++; // Update global badge
            ToastService.ShowSuccess("Item salvo com sucesso!");
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar item: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelForm()
    {
        isFormVisible = false;
        capturedPhotos.Clear();
        itemModel = new InventoryItem();
        // Camera will restart via OnAfterRender/re-render logic if handled or explicit call
        Navigation.NavigateTo("/"); // safer to go back for now or restart
    }

    private void CloseCamera()
    {
        Navigation.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        await CameraService.StopCameraAsync("camera-feed");
    }
}
