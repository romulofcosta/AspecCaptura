@page "/camera"
@layout AspecCaptura.Components.Layout.AppLayout
@using AspecCaptura.Components.Common
@using AspecCaptura.Components.Layout
@inject ICameraService CameraService
@inject IRecognitionService RecognitionService
@inject AspecCaptura.Services.Storage.IIndexedDbService DbService
@inject IAuthService AuthService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<PageTitle>Capturar - Aspec Captura</PageTitle>

<div class="camera-page">
    @if (!isFormVisible)
    {
        @* Camera Viewfinder *@
        <div class="viewfinder-container">
            <video id="camera-feed" autoplay playsinline class="video-feed"></video>
            
            @* Top Action Bar *@
            <div class="viewfinder-top">
                <button class="icon-btn" @onclick="CloseCamera">
                    <span class="material-symbols-outlined">close</span>
                </button>
                <div class="viewfinder-title">CAPTURA PWA</div>
                <button class="icon-btn" @onclick="SwitchCamera">
                    <span class="material-symbols-outlined">cameraswitch</span>
                </button>
            </div>
            @* Top Mode Tabs *@
            <div class="recognition-tabs">
                <div class="tab-item @(selectedMode == RecognitionMode.OCR ? "active" : "")" @onclick="() => SelectMode(RecognitionMode.OCR)">OCR</div>
                <div class="tab-item @(selectedMode == RecognitionMode.Barcode ? "active" : "")" @onclick="() => SelectMode(RecognitionMode.Barcode)">BARCODE</div>
                <div class="tab-item @(selectedMode == RecognitionMode.QR ? "active" : "")" @onclick="() => SelectMode(RecognitionMode.QR)">QR CODE</div>
            </div>

            @* Scan Boundary Overlay *@
            <div class="scan-boundary-layer">
                <div class="scan-frame @scanFrameClass">
                    <div class="corner top-left"></div>
                    <div class="corner top-right"></div>
                    <div class="corner bottom-left"></div>
                    <div class="corner bottom-right"></div>
                </div>
                <p class="scan-hint">@scanHint</p>
                <div class="status-indicator-badge @scanBadgeClass">@scanBadgeText</div>
            </div>

            @* Side Controls *@
            <div class="side-controls">
                <button class="side-btn"><span class="material-symbols-outlined">flash_on</span></button>
                <button class="side-btn"><span class="material-symbols-outlined">zoom_in</span></button>
            </div>

            @* Result Overlay (Bottom) *@
            <div class="last-capture-overlay">
                <div class="capture-info">
                    <span class="capture-label">ÚLTIMA CAPTURA</span>
                    <span class="capture-value">@lastDetectedCode</span>
                </div>
                <div class="capture-status-line">
                    <span class="status-dot @statusDotClass"></span>
                    <span class="status-msg">@lastDetectionStatus</span>
                </div>
            </div>
        </div>

        @* Capture Controls *@
        <div class="capture-controls">
            <div class="photo-thumbnails">
                @foreach (var photo in capturedPhotos)
                {
                    <div class="mini-thumb">
                        <img src="@photo" />
                    </div>
                }
            </div>
            <button class="capture-trigger" @onclick="CapturePhoto">
                <div class="trigger-inner"></div>
            </button>
            <div class="controls-right">
                @if (capturedPhotos.Any())
                {
                    <button class="finish-btn" @onclick="ShowForm">
                        CONCLUIR (@capturedPhotos.Count)
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        @* Item Details Form *@
        <div class="details-form-container">
            <PrimaryCard Class="details-card">
                <div class="details-header">
                    <h2 class="details-title">DETALHES DO BEM</h2>
                    <p class="details-subtitle">Complete as informações do patrimônio</p>
                </div>

                <div class="photo-strip">
                    @for (int i = 0; i < capturedPhotos.Count; i++)
                    {
                        int index = i;
                        <div class="strip-item @(currentPreviewIndex == index ? "active" : "")" @onclick="() => currentPreviewIndex = index">
                            <img src="@capturedPhotos[index]" />
                        </div>
                    }
                    <button class="add-photo-btn" @onclick="AddMorePhoto">
                        <span class="material-symbols-outlined">add_a_photo</span>
                    </button>
                </div>

                <div class="form-fields">
                    <div class="form-group">
                        <label class="input-label">NOME DO ITEM *</label>
                        <input type="text" class="form-input" @bind="itemModel.Name" placeholder="Ex: Cadeira de Escritório" />
                    </div>

                    <div class="form-group">
                        <label class="input-label">NÚMERO DO PATRIMÔNIO *</label>
                        <div class="input-with-icon">
                            <span class="material-symbols-outlined">qr_code_scanner</span>
                            <input type="text" class="form-input" @bind="itemModel.Code" placeholder="Ex: 012345" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="input-label">LOCALIZAÇÃO / SETOR *</label>
                        <input type="text" class="form-input" @bind="itemModel.Location" placeholder="Ex: Bloco A - Sala 102" />
                    </div>

                    <div class="form-group">
                        <label class="input-label">ESTADO DE CONSERVAÇÃO</label>
                        <select class="form-input" @bind="itemModel.State">
                            <option value="@ConservationState.Novo">NOVO</option>
                            <option value="@ConservationState.Bom">BOM</option>
                            <option value="@ConservationState.Regular">REGULAR</option>
                            <option value="@ConservationState.Pessimo">PÉSSIMO</option>
                            <option value="@ConservationState.Inservivel">INSERVÍVEL</option>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <PrimaryButton FullWidth="true" Disabled="@isSaving" OnClick="HandleSave">
                        @(isSaving ? "SALVANDO..." : "SALVAR PATRIMÔNIO")
                    </PrimaryButton>
                    <button class="cancel-btn" @onclick="CancelForm">CANCELAR</button>
                </div>
            </PrimaryCard>
        </div>
    }
</div>

<style>
    .camera-page {
        position: fixed;
        inset: 0;
        background-color: black;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        color: white;
    }

    .viewfinder-container {
        flex: 1;
        position: relative;
        overflow: hidden;
    }

    .video-feed {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .viewfinder-top {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
        z-index: 10;
    }

    .viewfinder-title {
        font-size: 12px;
        font-weight: var(--font-weight-bold);
        letter-spacing: 1px;
    }

    .icon-btn {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .recognition-tabs {
        position: absolute;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        background: rgba(0,0,0,0.4);
        border-radius: 12px;
        padding: 4px;
        gap: 4px;
        backdrop-filter: blur(8px);
        z-index: 20;
    }

    .tab-item {
        padding: 8px 16px;
        font-size: 10px;
        font-weight: var(--font-weight-bold);
        color: rgba(255,255,255,0.6);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .tab-item.active {
        background: var(--color-primary);
        color: white;
    }

    .scan-boundary-layer {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 10;
    }

    .scan-frame {
        width: 250px;
        height: 250px;
        position: relative;
        border: 1px solid rgba(255,255,255,0.1);
        transition: border-color 0.3s;
    }

    .scan-frame.detecting .corner { border-color: #F59E0B; }
    .scan-frame.found .corner     { border-color: #10B981; }
    .scan-frame.error .corner     { border-color: #EF4444; }

    .corner {
        position: absolute;
        width: 24px;
        height: 24px;
        border: 3px solid var(--color-primary);
    }

    .top-left { top: -2px; left: -2px; border-right: none; border-bottom: none; border-top-left-radius: 12px; }
    .top-right { top: -2px; right: -2px; border-left: none; border-bottom: none; border-top-right-radius: 12px; }
    .bottom-left { bottom: -2px; left: -2px; border-right: none; border-top: none; border-bottom-left-radius: 12px; }
    .bottom-right { bottom: -2px; right: -2px; border-left: none; border-top: none; border-bottom-right-radius: 12px; }

    .scan-hint {
        margin-top: 24px;
        font-size: 12px;
        font-weight: 500;
        color: white;
        text-align: center;
        max-width: 200px;
    }

    .status-indicator-badge {
        margin-top: 8px;
        font-size: 9px;
        font-weight: 700;
        padding: 4px 12px;
        background: rgba(0,0,0,0.5);
        border-radius: 4px;
        color: #94a3b8;
        transition: background 0.3s, color 0.3s;
    }

    .status-indicator-badge.scanning  { color: #94a3b8; }
    .status-indicator-badge.detecting { background: rgba(245,158,11,0.3); color: #F59E0B; }
    .status-indicator-badge.found     { background: rgba(16,185,129,0.3); color: #10B981; }
    .status-indicator-badge.error     { background: rgba(239,68,68,0.3);  color: #EF4444; }

    .status-dot { transition: background-color 0.3s, box-shadow 0.3s; }
    .status-dot.scanning  { background-color: #94a3b8; box-shadow: none; }
    .status-dot.detecting { background-color: #F59E0B; box-shadow: 0 0 8px #F59E0B; }
    .status-dot.found     { background-color: #10B981; box-shadow: 0 0 8px #10B981; }
    .status-dot.error     { background-color: #EF4444; box-shadow: 0 0 8px #EF4444; }

    .side-controls {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        gap: 16px;
        z-index: 20;
    }

    .side-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .last-capture-overlay {
        position: absolute;
        bottom: 24px;
        left: 20px;
        right: 20px;
        background: rgba(15, 23, 42, 0.9);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.1);
        z-index: 20;
    }

    .capture-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .capture-label {
        font-size: 9px;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.5px;
    }

    .capture-value {
        font-size: 16px;
        font-weight: 800;
        color: white;
        letter-spacing: 1px;
    }

    .capture-status-line {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--color-success);
        box-shadow: 0 0 8px var(--color-success);
    }

    .status-msg {
        font-size: 9px;
        font-weight: 700;
        color: var(--color-success);
    }

    .capture-controls {
        height: 160px;
        background-color: black;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 20px;
        padding-bottom: env(safe-area-inset-bottom);
    }

    .capture-trigger {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background-color: rgba(255,255,255,0.2);
        border: 3px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .trigger-inner {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: white;
    }

    .capture-trigger:active .trigger-inner {
        transform: scale(0.9);
    }

    .photo-thumbnails {
        display: flex;
        gap: 8px;
        overflow-x: auto;
    }

    .mini-thumb {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.5);
    }

    .mini-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .finish-btn {
        background-color: var(--color-success);
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: var(--font-weight-bold);
        font-size: 12px;
    }

    .details-form-container {
        padding: 16px;
        overflow-y: auto;
        background-color: var(--color-background);
        min-height: 100vh;
    }

    .details-header {
        text-align: center;
        margin-bottom: 20px;
    }

    .details-title {
        font-size: var(--font-size-title-md);
        color: var(--color-primary);
        font-weight: var(--font-weight-bold);
    }

    .details-subtitle {
        font-size: var(--font-size-small);
        color: var(--color-text-secondary);
    }

    .photo-strip {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        overflow-x: auto;
        padding: 4px;
    }

    .strip-item {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid transparent;
        flex-shrink: 0;
    }

    .strip-item.active {
        border-color: var(--color-primary);
    }

    .strip-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .add-photo-btn {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        background-color: #F1F5F9;
        border: 2px dashed var(--color-border);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-fields {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 32px;
    }

    .input-with-icon {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-with-icon .material-symbols-outlined {
        position: absolute;
        left: 12px;
        color: var(--color-text-secondary);
    }

    .input-with-icon .form-input {
        padding-left: 44px;
    }

    .form-input {
        width: 100%;
        height: 48px;
        padding: 0 16px;
        background-color: #F8FAFC;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-input);
        font-size: var(--font-size-body);
        color: var(--color-text-primary);
    }

    .form-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .cancel-btn {
        background: none;
        border: none;
        color: var(--color-text-secondary);
        font-weight: var(--font-weight-bold);
        padding: 12px;
        cursor: pointer;
    }

    .controls-right {
        display: flex;
        justify-content: flex-end;
    }
</style>

@code {
    private bool isFormVisible = false;
    private bool useFrontCamera = false;
    private List<string> capturedPhotos = new();
    private int currentPreviewIndex = 0;
    private InventoryItem itemModel = new();
    private bool isSaving = false;
    private Usuario? currentUser;

    // Scan state
    private string lastDetectedCode = "---";
    private string lastDetectionStatus = "AGUARDANDO...";
    private string scanFrameClass = "";
    private string scanBadgeClass = "scanning";
    private string scanBadgeText = "PROCURANDO...";
    private string scanHint = "Aponte para a placa de patrimônio";
    private string statusDotClass = "scanning";

    // Timeout: avisa o usuário após 15s sem detecção
    private CancellationTokenSource? _timeoutCts;
    private const int ScanTimeoutSeconds = 15;

    private enum RecognitionMode { All, QR, Barcode, OCR }
    private RecognitionMode selectedMode = RecognitionMode.All;

    private void SelectMode(RecognitionMode mode)
    {
        selectedMode = mode;
        if (RecognitionService.Settings != null)
        {
            RecognitionService.Settings.QREnabled  = mode is RecognitionMode.All or RecognitionMode.QR;
            RecognitionService.Settings.BarcodeEnabled = mode is RecognitionMode.All or RecognitionMode.Barcode;
            RecognitionService.Settings.OCREnabled = mode is RecognitionMode.All or RecognitionMode.OCR;
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }
        currentUser = await AuthService.GetCurrentUserAsync();
        appState.IsCameraActive = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isFormVisible)
            await StartCamera();
    }

    private async Task StartCamera()
    {
        try
        {
            await CameraService.StartCameraAsync("camera-feed", useFrontCamera);
            await StartRecognitionLoop();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao iniciar câmera: " + ex.Message);
        }
    }

    private async Task StartRecognitionLoop()
    {
        // Inscreve nos eventos antes de iniciar
        RecognitionService.CodeDetected    += OnCodeDetected;
        RecognitionService.PatrimonioFound += OnPatrimonioFound;
        RecognitionService.RecognitionError += OnRecognitionError;

        var started = await RecognitionService.StartRecognitionAsync("camera-feed");
        if (!started)
        {
            SetScanState("error", "FALHA AO INICIAR", "Reconhecimento indisponível", "error");
            return;
        }

        SetScanState("", "PROCURANDO...", "Aponte para a placa de patrimônio", "scanning");
        StartTimeoutTimer();
    }

    private void StartTimeoutTimer()
    {
        _timeoutCts?.Cancel();
        _timeoutCts = new CancellationTokenSource();
        var token = _timeoutCts.Token;

        _ = Task.Delay(TimeSpan.FromSeconds(ScanTimeoutSeconds), token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            InvokeAsync(() =>
            {
                SetScanState("error", "SEM DETECÇÃO", "Tente aproximar mais ou melhorar a iluminação", "error");
                StateHasChanged();
            });
        });
    }

    private void OnCodeDetected(object? sender, RecognitionEventArgs e)
    {
        _timeoutCts?.Cancel(); // Cancela o timeout
        InvokeAsync(() =>
        {
            lastDetectedCode = e.Result.DetectedCode ?? "---";
            SetScanState("detecting", $"CÓDIGO: {lastDetectedCode}", "Verificando patrimônio...", "detecting");
            StateHasChanged();
        });
    }

    private void OnPatrimonioFound(object? sender, PatrimonioFoundEventArgs e)
    {
        _timeoutCts?.Cancel();
        InvokeAsync(() =>
        {
            lastDetectedCode = e.Patrimonio.Nutomb;
            lastDetectionStatus = $"ENCONTRADO: {e.Patrimonio.Deprod}";
            SetScanState("found", "PATRIMÔNIO ENCONTRADO", e.Patrimonio.Deprod, "found");
            StateHasChanged();
        });
    }

    private void OnRecognitionError(object? sender, RecognitionErrorEventArgs e)
    {
        InvokeAsync(() =>
        {
            SetScanState("error", "ERRO", e.ErrorMessage, "error");
            StateHasChanged();
        });
    }

    private void SetScanState(string frameClass, string badgeText, string hint, string dotClass)
    {
        scanFrameClass  = frameClass;
        scanBadgeText   = badgeText;
        scanBadgeClass  = dotClass;
        scanHint        = hint;
        statusDotClass  = dotClass;
        lastDetectionStatus = badgeText;
    }

    private async Task SwitchCamera()
    {
        useFrontCamera = !useFrontCamera;
        await StopRecognitionLoop();
        await CameraService.StopCameraAsync("camera-feed");
        await StartCamera();
    }

    private async Task CapturePhoto()
    {
        try
        {
            var photoData = await CameraService.TakePhotoAsync("camera-feed");
            if (!string.IsNullOrEmpty(photoData))
            {
                capturedPhotos.Add(photoData);
                currentPreviewIndex = capturedPhotos.Count - 1;
                await StopRecognitionLoop();
                await CameraService.StopCameraAsync("camera-feed");
                isFormVisible = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao capturar foto: " + ex.Message);
        }
    }

    private async Task StopRecognitionLoop()
    {
        _timeoutCts?.Cancel();
        RecognitionService.CodeDetected    -= OnCodeDetected;
        RecognitionService.PatrimonioFound -= OnPatrimonioFound;
        RecognitionService.RecognitionError -= OnRecognitionError;
        await RecognitionService.StopRecognitionAsync();
    }

    private void ShowForm() => isFormVisible = true;

    private async Task AddMorePhoto()
    {
        isFormVisible = false;
        await Task.Delay(100);
        await StartCamera();
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(itemModel.Name) || string.IsNullOrWhiteSpace(itemModel.Code))
        {
            ToastService.ShowError("Preencha o nome e o código do item.");
            return;
        }

        isSaving = true;
        try
        {
            itemModel.Photos      = capturedPhotos;
            itemModel.IdOrgao     = appState.CurrentOrgao?.IdOrgao;
            itemModel.IdUO        = appState.CurrentUO?.IdUO;
            itemModel.IdArea      = appState.CurrentArea?.IdArea;
            itemModel.IdSubarea   = appState.CurrentSubarea?.IdSubarea;
            itemModel.CreatedBy   = currentUser?.UsuarioNome ?? "desconhecido";
            itemModel.Esfera      = appState.EsferaAtual ?? currentUser?.Esfera ?? string.Empty;
            itemModel.Timestamp   = DateTime.Now;
            itemModel.UpdatedAt   = DateTime.Now;
            itemModel.Synced      = false;

            await DbService.AddAsync("items", itemModel);
            await appState.UpdateStatisticsAsync();

            ToastService.ShowSuccess("Item salvo com sucesso!");
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelForm()
    {
        isFormVisible = false;
        capturedPhotos.Clear();
        itemModel = new InventoryItem();
        Navigation.NavigateTo("/");
    }

    private void CloseCamera() => Navigation.NavigateTo("/");

    public async ValueTask DisposeAsync()
    {
        try
        {
            await StopRecognitionLoop();
            await CameraService.StopCameraAsync("camera-feed");
            appState.IsCameraActive = false;
        }
        catch { }
        finally
        {
            _timeoutCts?.Dispose();
        }
    }
}
