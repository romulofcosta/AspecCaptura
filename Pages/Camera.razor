@page "/camera"
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Services.Camera
@using pwa_camera_poc_blazor.Services.Ocr
@inject CameraService CameraService
@inject OcrService OcrService
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject AppState appState
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Capturar - ASPEC Capture</PageTitle>

@if (isFormVisible)
{
    <div class="d-flex flex-column" style="height: 100%; position: relative;">
        <!-- Scrollable Content Area -->
        <div class="flex-grow-1 overflow-y-auto pa-4" style="padding-bottom: 120px !important;">
            <MudCard Elevation="4" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Adicionar Informações</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CancelForm" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudPaper Class="mb-4 d-flex justify-center align-center grey lighten-3" Elevation="0"
                        Style="height: 250px; overflow: hidden; position: relative;">
                        @if (capturedPhotos.Any())
                        {
                            <MudImage Src="@capturedPhotos[currentPreviewIndex]" ObjectFit="ObjectFit.Cover"
                                Style="width:100%; height:100%;" />
                        }
                    </MudPaper>

                    <div class="d-flex gap-2 mb-4 overflow-x-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto"
                            OnClick="OpenAddPhotoModal" Class="pa-4" Style="height: 60px;">
                            ADICIONAR FOTOS
                        </MudButton>
                        @for (int i = 0; i < capturedPhotos.Count; i++)
                        {
                            int index = i;
                            <div style="position: relative; width: 60px; height: 60px; flex-shrink: 0; cursor: pointer;"
                            @onclick="() => currentPreviewIndex = index">
                                <MudImage Src="@capturedPhotos[index]" ObjectFit="ObjectFit.Cover"
                                    Style="@($"width:100%; height:100%; border-radius: 4px; border: {(currentPreviewIndex == index ? "2px solid var(--mud-palette-primary)" : "none")}")" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                    Style="position: absolute; top: -5px; right: -5px; background: white;"
                                    OnClick="@((e) => RemovePhoto(index))" />
                            </div>
                        }
                    </div>

                    <EditForm EditContext="@editContext" OnValidSubmit="HandleSave" id="camera-form">
                        <DataAnnotationsValidator />
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Name" Label="Nome do Item *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Name)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Code" Label="Código/ID *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Code)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Categoria *</MudText>
                                <div class="mud-input-control mud-input-input-control">
                                    <div class="mud-input-control-input-container">
                                        <div class="mud-input mud-input-outlined" style="position: relative;">
                                            <select @bind="itemModel.Category" class="mud-input-slot mud-input-root mud-input-root-outlined" 
                                                    style="height: 56px; padding: 18.5px 14px; width: 100%; -webkit-appearance: none; appearance: none; background: transparent; z-index: 10; font-size: 1rem; color: var(--mud-palette-text-primary);">
                                                <option value="">Selecione a categoria</option>
                                                <option value="Móveis">Móveis</option>
                                                <option value="Eletrônicos">Eletrônicos</option>
                                                <option value="Equipamentos">Equipamentos</option>
                                                <option value="Ferramentas">Ferramentas</option>
                                                <option value="Materiais">Materiais</option>
                                                <option value="Outros">Outros</option>
                                            </select>
                                            <div class="mud-input-outlined-border"></div>
                                            <div style="position: absolute; right: 14px; top: 16px; pointer-events: none;">
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Color="Color.Secondary" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Location" Label="Localização *" Variant="Variant.Outlined"
                                    For="@(() => itemModel.Location)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="itemModel.Observations" Label="Observações"
                                    Variant="Variant.Outlined" Lines="3" For="@(() => itemModel.Observations)" />
                            </MudItem>
                            <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4">
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelForm">Cancelar
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                    Disabled="@isSaving" StartIcon="@Icons.Material.Filled.Save">
                                    @(isSaving ? "Salvando..." : "Salvar")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </div>

        <!-- Fixed Action Bar at Bottom -->
        <!-- Fixed Action Bar at Bottom Removed -->
    </div>
}
else
{
    <div
        style="position: fixed; top: 0; left: 0; width: 100%; height: 100dvh; background: black; z-index: 2000; display: flex; flex-direction: column;">
        <div style="position: relative; flex: 1; overflow: hidden;">
            <video id="camera-feed" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
            
            <!-- Scanner ROI Guide -->
            <div class="scanner-guide" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; height: 150px; border: 2px solid #00c853; border-radius: 8px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.5); pointer-events: none;">
                <div style="position: absolute; top: -30px; left: 0; width: 100%; text-align: center;">
                    <MudText Typo="Typo.caption" Style="color: #00c853; font-weight: bold; text-transform: uppercase;">Posicione a placa aqui</MudText>
                </div>
                <div class="scanner-line" style="position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: #00c853; opacity: 0.5; animation: scan 2s infinite ease-in-out;"></div>
            </div>

            @if (isScanning)
            {
                <div style="position: absolute; bottom: 20px; left: 0; width: 100%; text-align: center; display: flex; flex-direction: column; align-center; gap: 8px;">
                    <MudChip T="string" Color="@scanStatusColor" Variant="Variant.Filled" Icon="@scanStatusIcon">@scanStatusText</MudChip>
                    @if (!string.IsNullOrEmpty(lastDetectedCode))
                    {
                        <MudText Typo="Typo.h6" Style="color: white; text-shadow: 1px 1px 2px black;">Última leitura: @lastDetectedCode</MudText>
                    }
                </div>
            }
        </div>

        <style>
            @@keyframes scan {
                0% { top: 0; }
                50% { top: 100%; }
                100% { top: 0; }
            }
        </style>

        <MudPaper Class="d-flex justify-space-between align-center px-8 py-6"
            Style="background: rgba(0,0,0,0.8); width: 100%; padding-bottom: calc(24px + env(safe-area-inset-bottom)) !important;">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Surface" Size="Size.Large"
                OnClick="CloseCamera" />

            <div class="d-flex justify-center align-center" style="flex: 1;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                    Style="width: 80%; height: 56px; border-radius: 28px; font-weight: bold; font-size: 1.1rem;"
                    StartIcon="@Icons.Material.Filled.QrCodeScanner"
                    OnClick="ManualScanTrigger">
                    ESCANEAR PLACA
                </MudButton>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.FlipCameraIos" Color="Color.Surface" Size="Size.Large"
                OnClick="SwitchCamera" />
        </MudPaper>
    </div>
}

<MudDialog @bind-IsVisible="isPhotoModalOpen" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Adicionar Fotos</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Camera"
                FullWidth="true" OnClick="TakePhotoFromModal" Style="height: 56px;">
                Tirar Foto
            </MudButton>
            
            <div style="position: relative;">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                    FullWidth="true" Style="height: 56px;">
                    Fazer Upload
                </MudButton>
                <InputFile OnChange="HandleFileUpload" 
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePhotoModal">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@if (isCameraInModalActive)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100dvh; background: black; z-index: 3000; display: flex; flex-direction: column;">
        <video id="modal-camera-feed" autoplay playsinline style="width: 100%; flex: 1; object-fit: cover;"></video>
        <MudPaper Class="d-flex justify-center align-center px-8 py-6" Style="background: rgba(0,0,0,0.8);">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Surface" Size="Size.Large" OnClick="StopModalCamera" Class="mr-8" />
            <MudIconButton Icon="@Icons.Material.Filled.Camera" Color="Color.Surface"
                Style="width: 72px; height: 72px; border: 4px solid white; border-radius: 50%; padding: 0;"
                OnClick="CapturePhotoFromModal" />
            <MudIconButton Icon="@Icons.Material.Filled.FlipCameraIos" Color="Color.Surface" Size="Size.Large" OnClick="SwitchModalCamera" Class="ml-8" />
        </MudPaper>
    </div>
}

@code {
    private bool isFormVisible = false;
    private bool useFrontCamera = false;
    private List<string> capturedPhotos = new();
    private int currentPreviewIndex = 0;
    private InventoryItem itemModel = new();
    private bool isSaving = false;
    private User? currentUser;
    private EditContext? editContext;
    private bool isScanning = false;
    private System.Threading.CancellationTokenSource? scanCts;
    private string scanStatusText = "Buscando patrimônio...";
    private string scanStatusIcon = Icons.Material.Filled.Search;
    private Color scanStatusColor = Color.Info;
    private string lastDetectedCode = "";
    private bool isManualScanTriggered = false;
    private bool isPhotoModalOpen = false;
    private bool isCameraInModalActive = false;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        appState.IsCameraActive = true;
        currentUser = await AuthService.GetCurrentUserAsync();
        await OcrService.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isFormVisible)
        {
            await StartCamera();
            StartScanning();
        }
    }

    private void StartScanning()
    {
        if (isScanning) return;
        isScanning = true;
        scanCts = new System.Threading.CancellationTokenSource();
        _ = ScanLoop(scanCts.Token);
    }

    private async Task ScanLoop(System.Threading.CancellationToken token)
    {
        while (!token.IsCancellationRequested && !isFormVisible)
        {
            try
            {
                // ROI centralizada (80% largura, 150px altura aproximada em percentual)
                var roi = new { x = 0.1, y = 0.4, width = 0.8, height = 0.2 };
                var frame = await CameraService.CaptureFrameForOcrAsync("camera-feed", roi);
                
                if (!string.IsNullOrEmpty(frame))
                {
                    var result = await OcrService.RecognizeAsync(frame);
                    if (result.Confidence > 60)
                    {
                        var cleanedCode = NormalizeCode(result.Text);
                        if (!string.IsNullOrEmpty(cleanedCode))
                        {
                            lastDetectedCode = cleanedCode;
                            scanStatusText = $"Código detectado: {cleanedCode}";
                            scanStatusColor = Color.Success;
                            scanStatusIcon = Icons.Material.Filled.CheckCircle;
                            StateHasChanged();

                            if (isManualScanTriggered)
                            {
                                await ProcessFoundCode(cleanedCode);
                            }
                        }
                        else
                        {
                            SetScanningStatus();
                        }
                    }
                    else
                    {
                        if (isManualScanTriggered)
                        {
                            scanStatusText = "Não foi possível ler, tente novamente";
                            scanStatusColor = Color.Error;
                            scanStatusIcon = Icons.Material.Filled.Error;
                            isManualScanTriggered = false;
                            StateHasChanged();
                            await Task.Delay(2000, token);
                        }
                        SetScanningStatus();
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro no ScanLoop: {ex.Message}");
            }
            
            await Task.Delay(1000, token); // Intervalo entre leituras
        }
    }

    private void SetScanningStatus()
    {
        if (!isManualScanTriggered)
        {
            scanStatusText = "Buscando patrimônio...";
            scanStatusColor = Color.Info;
            scanStatusIcon = Icons.Material.Filled.Search;
        }
    }

    private void ManualScanTrigger()
    {
        isManualScanTriggered = true;
        scanStatusText = "Processando leitura...";
        scanStatusColor = Color.Warning;
        scanStatusIcon = Icons.Material.Filled.Sync;
        StateHasChanged();
    }

    private string NormalizeCode(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        // Regex para extrair apenas números e caracteres permitidos
        var match = System.Text.RegularExpressions.Regex.Match(text, @"[0-9A-Z\-\.\/]{4,}");
        return match.Success ? match.Value : string.Empty;
    }

    private async Task ProcessFoundCode(string code)
    {
        isManualScanTriggered = false;
        // Busca no IndexedDB
        var items = await DbService.GetAllAsync<InventoryItem>("items");
        var existingItem = items.FirstOrDefault(i => i.Code == code);

        if (existingItem != null)
        {
            itemModel = existingItem;
            ToastService.ShowSuccess($"Patrimônio {code} encontrado!");
        }
        else
        {
            itemModel.Code = code;
            ToastService.ShowInfo($"Novo patrimônio detectado: {code}");
        }

        await StopScanningAndShowForm();
    }

    private async Task StopScanningAndShowForm()
    {
        isScanning = false;
        scanCts?.Cancel();
        await CameraService.StopCameraAsync("camera-feed");
        
        editContext = new EditContext(itemModel);
        isFormVisible = true;
        StateHasChanged();
    }

    private async Task StartCamera()
    {
        try
        {
            await CameraService.StartCameraAsync("camera-feed", useFrontCamera);
            appState.IsCameraActive = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task SwitchCamera()
    {
        useFrontCamera = !useFrontCamera;
        if (isCameraInModalActive)
        {
            await CameraService.StopCameraAsync("modal-camera-feed");
            await CameraService.StartCameraAsync("modal-camera-feed", useFrontCamera);
        }
        else
        {
            await CameraService.StopCameraAsync("camera-feed");
            await StartCamera();
        }
    }

    private void OpenAddPhotoModal() => isPhotoModalOpen = true;
    private void ClosePhotoModal() => isPhotoModalOpen = false;

    private async Task TakePhotoFromModal()
    {
        isPhotoModalOpen = false;
        isCameraInModalActive = true;
        await Task.Delay(100);
        await CameraService.StartCameraAsync("modal-camera-feed", useFrontCamera);
    }

    private async Task StopModalCamera()
    {
        await CameraService.StopCameraAsync("modal-camera-feed");
        isCameraInModalActive = false;
        isPhotoModalOpen = true;
    }

    private async Task CapturePhotoFromModal()
    {
        var photoData = await CameraService.TakePhotoAsync("modal-camera-feed");
        if (!string.IsNullOrEmpty(photoData))
        {
            capturedPhotos.Add(photoData);
            currentPreviewIndex = capturedPhotos.Count - 1;
            await StopModalCamera();
        }
    }

    private async Task SwitchModalCamera()
    {
        useFrontCamera = !useFrontCamera;
        await CameraService.StopCameraAsync("modal-camera-feed");
        await CameraService.StartCameraAsync("modal-camera-feed", useFrontCamera);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5).ReadAsync(buffer);
            var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            capturedPhotos.Add(base64);
            currentPreviewIndex = capturedPhotos.Count - 1;
            ClosePhotoModal();
        }
    }

    private async Task CapturePhoto()
    {
        var photoData = await CameraService.TakePhotoAsync("camera-feed");
        if (!string.IsNullOrEmpty(photoData))
        {
            capturedPhotos.Add(photoData);
            currentPreviewIndex = capturedPhotos.Count - 1;
            await CameraService.StopCameraAsync("camera-feed");
            
            // Initialize EditContext
            editContext = new EditContext(itemModel);
            
            isFormVisible = true;
        }
    }

    private async Task AddMorePhoto()
    {
        isFormVisible = false;
        await Task.Delay(100);
        await StartCamera();
    }

    private void RemovePhoto(int index)
    {
        capturedPhotos.RemoveAt(index);
        if (currentPreviewIndex >= capturedPhotos.Count) currentPreviewIndex = Math.Max(0, capturedPhotos.Count - 1);
        if (capturedPhotos.Count == 0) CancelForm();
    }

    private async Task HandleSave()
    {
        if (isSaving) return;
        isSaving = true;
        try
        {
            itemModel.Photos = capturedPhotos;
            itemModel.UnitId = currentUser?.CurrentUnitId;
            itemModel.CreatedBy = currentUser?.Username ?? string.Empty; // Define o criador
            itemModel.Timestamp = DateTime.Now;
            itemModel.Synced = false;
            await DbService.AddAsync("items", itemModel);
            appState.PendingSyncCount++;
            ToastService.ShowSuccess("Item salvo com sucesso!");
            Navigation.NavigateTo("/home");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar item: " + ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelForm()
    {
        isFormVisible = false;
        capturedPhotos.Clear();
        itemModel = new InventoryItem();
        Navigation.NavigateTo("/home");
    }

    private void CloseCamera()
    {
        Navigation.NavigateTo("/home");
    }
    
    public async ValueTask DisposeAsync()
    {
        scanCts?.Cancel();
        await CameraService.StopCameraAsync("camera-feed");
        appState.IsCameraActive = false;
    }
}
