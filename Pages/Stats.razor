@page "/stats"
@using AspecCaptura.Models
@inject AspecCaptura.Services.Storage.IIndexedDbService DbService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Estatísticas - Aspec Captura</PageTitle>

<div id="stats-container" class="minimal-page" style="padding: 24px;">
    <h1 class="page-title">Visão Geral do Inventário</h1>
    <p class="page-subtitle">Acompanhe o progresso das capturas e distribuição por categoria.</p>

    <div style="display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px;">
        <!-- Total Items Card -->
        <div class="minimal-card" style="padding: 24px; display: flex; align-items: center; gap: 16px; border-left: 4px solid #003366;">
            <div style="background: #e8eef7; padding: 12px; border-radius: 12px; color: #003366;">
                <span class="material-symbols-outlined text-2xl">inventory_2</span>
            </div>
            <div>
                <h2 style="font-size: 28px; font-weight: 700; color: #1e293b; margin: 0;">@items.Count</h2>
                <p style="font-size: 14px; color: #64748b; margin: 0;">Total de Itens</p>
            </div>
        </div>

        <!-- Captured Today Card -->
        <div class="minimal-card" style="padding: 24px; display: flex; align-items: center; gap: 16px; border-left: 4px solid #64748b;">
            <div style="background: #f1f5f9; padding: 12px; border-radius: 12px; color: #64748b;">
                <span class="material-symbols-outlined text-2xl">today</span>
            </div>
            <div>
                <h2 style="font-size: 28px; font-weight: 700; color: #1e293b; margin: 0;">@todayCount</h2>
                <p style="font-size: 14px; color: #64748b; margin: 0;">Capturados Hoje</p>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 24px;">
        <div class="minimal-card" style="padding: 24px;">
            <h3 class="section-title">Por Categoria</h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var cat in categoryStats)
                {
                    <div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span style="font-size: 14px; font-weight: 500; color: #1e293b;">@cat.Key</span>
                            <span style="font-size: 14px; color: #64748b;">@cat.Value</span>
                        </div>
                        <div style="width: 100%; background: #f1f5f9; border-radius: 9999px; height: 8px;">
                            <div style="background: #003366; height: 100%; border-radius: 9999px; width: @(CalculatePercentage(cat.Value))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="minimal-card" style="padding: 24px;">
            <h3 class="section-title">Últimas Atividades</h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                @foreach (var item in items.OrderByDescending(i => i.Timestamp).Take(5))
                {
                    <div style="display: flex; gap: 16px; align-items: flex-start;">
                        <div style="display: flex; flex-direction: column; align-items: center;">
                            <div style="width: 12px; height: 12px; border-radius: 50%; background: #003366; margin-top: 4px;"></div>
                            <div style="width: 2px; height: 100%; background: #e2e8f0; margin-top: 4px;"></div>
                        </div>
                        <div style="padding-bottom: 16px;">
                            <span style="font-size: 12px; font-weight: 700; color: #003366;">@item.Timestamp.ToString("HH:mm")</span>
                            <p style="font-size: 14px; font-weight: 500; color: #1e293b; margin: 4px 0 0 0;">@item.Name</p>
                            <p style="font-size: 12px; color: #64748b; margin: 2px 0 0 0;">@item.Category • @item.Code</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<InventoryItem> items = new();
    private int todayCount = 0;
    private Dictionary<string, int> categoryStats = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#stats-container");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Verificar se a sessão está configurada
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }
        
        items = await DbService.GetAllAsync<InventoryItem>("items");
        todayCount = items.Count(i => i.Timestamp.Date == DateTime.Today);

        categoryStats = items.GroupBy(i => i.Category)
        .ToDictionary(g => g.Key, g => g.Count())
        .OrderByDescending(x => x.Value)
        .ToDictionary(x => x.Key, x => x.Value);
    }

    private double CalculatePercentage(int count)
    {
        if (items.Count == 0) return 0;
        return (double)count / items.Count * 100;
    }
}
