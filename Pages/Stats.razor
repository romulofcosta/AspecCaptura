@page "/stats"
@using pwa_camera_poc_blazor.Models
@inject IIndexedDbService DbService
@inject IJSRuntime JSRuntime
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Estatísticas - Aspec Captura</PageTitle>

<MudContainer id="stats-container" MaxWidth="MaxWidth.Large" Class="mt-4 pb-20"
    Style="overflow-y: auto; height: 100%;">
    <MudText Typo="Typo.h4" Class="mb-2 font-weight-bold">Visão Geral do Inventário</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">Acompanhe o progresso das capturas e distribuição
        por categoria.</MudText>

    <MudGrid Spacing="3">
        <!-- Total Items Card -->
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="1" Class="pa-6 d-flex align-center gap-4 rounded-lg"
                Style="background: linear-gradient(135deg, var(--mud-palette-surface) 0%, rgba(var(--mud-palette-primary-rgb), 0.05) 100%); border-left: 6px solid var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">@items.Count</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Total de Itens</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Captured Today Card -->
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="1" Class="pa-6 d-flex align-center gap-4 rounded-lg">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Color="Color.Secondary" />
                <div>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">@todayCount</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Capturados Hoje</MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudCard Elevation="1" Class="rounded-lg h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Por Categoria</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex flex-column gap-6">
                        @foreach (var cat in categoryStats)
                        {
                            <div>
                                <div class="d-flex justify-space-between mb-1">
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">@cat.Key</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@cat.Value</MudText>
                                </div>
                                <MudProgressLinear Color="Color.Primary" Value="@CalculatePercentage(cat.Value)"
                                    Class="rounded-pill" Size="Size.Medium" />
                            </div>
                        }
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="1" Class="rounded-lg h-100">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Últimas Atividades</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @foreach (var item in items.OrderByDescending(i => i.Timestamp).Take(5))
                        {
                            <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                <ItemContent>
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-weight-bold">
                                            @item.Timestamp.ToString("HH:mm")</MudText>
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">@item.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Category • @item.Code
                                        </MudText>
                                    </div>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<InventoryItem> items = new();
    private int todayCount = 0;
    private Dictionary<string, int> categoryStats = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#stats-container");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        items = await DbService.GetAllAsync<InventoryItem>("items");
        todayCount = items.Count(i => i.Timestamp.Date == DateTime.Today);

        categoryStats = items.GroupBy(i => i.Category)
        .ToDictionary(g => g.Key, g => g.Count())
        .OrderByDescending(x => x.Value)
        .ToDictionary(x => x.Key, x => x.Value);
    }

    private double CalculatePercentage(int count)
    {
        if (items.Count == 0) return 0;
        return (double)count / items.Count * 100;
    }
}
