@page "/"
@page "/bens"
@layout AspecCaptura.Components.Layout.AppLayout
@using AspecCaptura.Models
@using AspecCaptura.Components.Cards
@using AspecCaptura.Components.Forms
@using AspecCaptura.Components.Feedback
@using AspecCaptura.Services.Utils

@inject NavigationManager Navigation
@inject AspecCaptura.Services.Auth.IAuthService AuthService
@inject AspecCaptura.Services.Storage.IIndexedDbService DbService
@inject AspecCaptura.Services.AppState appState

@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Bens - Aspec Captura</PageTitle>

@* ── App Header ── *@
<header class="app-header">
    <div class="header-brand">
        <img src="images/aspec_logo.png" alt="Aspec" class="brand-logo" />
        <span class="brand-name">Aspec Captura</span>
    </div>
    <div class="header-actions">
        <button class="header-action" title="Sincronização" @onclick='() => Navigation.NavigateTo("/sync")'>
            <span class="material-symbols-outlined">sync</span>
        </button>
        <button class="header-action" title="Ajustes" @onclick='() => Navigation.NavigateTo("/settings")'>
            <span class="material-symbols-outlined">settings</span>
        </button>
    </div>
</header>

@* ── Search Field ── *@
<div class="search-section">
    <SearchBar 
        Placeholder="Buscar bem ou descrição..."
        @bind-Value="searchQuery"
        OnSearch="HandleSearch" />
</div>

@* ── Primary CTA Button ── *@
<div class="cta-section">
    <button class="primary-cta" @onclick='() => Navigation.NavigateTo("/camera")'>
        <span class="material-symbols-outlined">qr_code_scanner</span>
        <span class="primary-cta-text">ESCANEAR BEM</span>
    </button>
</div>

@* ── Filter Chips Section ── *@
@if (selectedConservationState.HasValue || selectedStatus.HasValue)
{
    <div class="filter-chips-section">
        @if (selectedConservationState.HasValue)
        {
            <FilterChip 
                Label="@selectedConservationState.Value.ToDisplayText()"
                Active="true"
                Removable="true"
                OnRemove="@(() => HandleConservationStateFilter(null))" />
        }
        @if (selectedStatus.HasValue)
        {
            <FilterChip 
                Label="@selectedStatus.Value.ToDisplayText()"
                Active="true"
                Removable="true"
                OnRemove="@(() => HandleStatusFilter(null))" />
        }
        <button class="clear-filters-btn" @onclick="HandleClearFilters">
            <span class="material-symbols-outlined">filter_alt_off</span>
            Limpar
        </button>
    </div>
}

@* ── Results Summary Bar ── *@
<div class="summary-bar">
    <span class="summary-count">@filteredBens.Count() BENS</span>
    <span class="summary-divider">|</span>
    <span class="summary-uo">@(appState.CurrentUO?.NomeUO ?? "Unidade não selecionada")</span>
</div>

@* ── Content Area ── *@
<div class="content-area">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-ring"></div>
            <span class="loading-text">Carregando bens...</span>
        </div>
    }
    else if (!filteredBens.Any())
    {
        <EmptyState 
            Icon="📦"
            Title="Nenhum bem encontrado"
            Subtitle="Tente outro filtro ou termo de busca" />
    }
    else
    {
        @foreach (var bem in pagedBens)
        {
            <PatrimonioCard Item="@bem" LocalItem="@TryGetLocal(bem)" OnView="NavigateToBem" />
        }

        @if (totalPages > 1)
        {
            <div class="pagination">
                <button class="pag-btn" disabled="@(currentPage == 1)" @onclick="PrevPage">
                    <span class="material-symbols-outlined">chevron_left</span>
                    ANTERIOR
                </button>
                <span class="pag-info">@currentPage / @totalPages</span>
                <button class="pag-btn" disabled="@(currentPage == totalPages)" @onclick="NextPage">
                    PRÓXIMA
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        }
    }
</div>



<style>
    /* ============================================
       BENS PAGE STYLES - Mobile-First Design
       Using Design Tokens from design-tokens.css
       Requirements: 26.1-26.25
       ============================================ */

    /* ── Header Section ── */
    .app-header {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3, 12px) var(--space-4, 16px);
        background: var(--color-surface, #FFFFFF);
        border-bottom: 1px solid var(--color-border, #E5E7EB);
        box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
    }

    .header-brand {
        display: flex;
        align-items: center;
        gap: var(--space-2, 8px);
    }

    .brand-logo {
        width: 24px;
        height: 24px;
        object-fit: contain;
    }

    .brand-name {
        font-size: var(--font-size-sm, 13px);
        font-weight: var(--font-weight-bold, 700);
        color: var(--color-primary, #2F6FED);
        letter-spacing: 0.3px;
    }

    .header-actions {
        display: flex;
        gap: var(--space-2, 8px);
    }

    .header-action {
        background: none;
        border: none;
        color: var(--color-text-secondary, #6B7280);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full, 9999px);
        cursor: pointer;
        transition: background var(--transition-base, 200ms) var(--easing-ease-in-out, cubic-bezier(0.4, 0, 0.2, 1));
        -webkit-tap-highlight-color: transparent;
    }

    .header-action:active {
        background: var(--color-primary-light, #EEF2FF);
    }

    /* ── Search Section ── */
    .search-section {
        padding: var(--space-3, 12px) var(--space-4, 16px);
        background: var(--color-surface, #FFFFFF);
    }

    /* ── Primary CTA Section ── */
    .cta-section {
        padding: 0 var(--space-4, 16px) var(--space-3, 12px);
        background: var(--color-surface, #FFFFFF);
    }

    .primary-cta {
        width: 100%;
        padding: var(--space-3, 12px) var(--space-4, 16px);
        background: var(--color-primary, #2F6FED);
        color: #FFFFFF;
        border: none;
        border-radius: var(--radius-xl, 16px);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2, 8px);
        box-shadow: 0 4px 12px rgba(47, 111, 237, 0.25);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: transform var(--transition-fast, 150ms) var(--easing-ease-out, cubic-bezier(0, 0, 0.2, 1)),
                    box-shadow var(--transition-fast, 150ms) var(--easing-ease-out, cubic-bezier(0, 0, 0.2, 1));
        font-family: var(--font-family-base, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
        min-height: var(--touch-target-min, 44px);
    }

    .primary-cta:active {
        transform: scale(0.98);
        box-shadow: 0 2px 8px rgba(47, 111, 237, 0.2);
    }

    .primary-cta .material-symbols-outlined {
        font-size: 20px;
    }

    .primary-cta-text {
        font-size: var(--font-size-sm, 13px);
        font-weight: var(--font-weight-bold, 700);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    /* ── Filter Chips Section ── */
    .filter-chips-section {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2, 8px);
        padding: var(--space-3, 12px) var(--space-4, 16px);
        background: var(--color-bg, #F8FAFC);
    }

    .clear-filters-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1, 4px);
        padding: var(--space-2, 8px) var(--space-3, 12px);
        border: 1px solid var(--color-border, #E5E7EB);
        border-radius: var(--radius-full, 9999px);
        background: var(--color-surface, #FFFFFF);
        color: var(--color-text-secondary, #6B7280);
        font-size: var(--font-size-sm, 13px);
        font-weight: var(--font-weight-medium, 500);
        cursor: pointer;
        transition: all var(--transition-fast, 150ms) var(--easing-ease-in-out, cubic-bezier(0.4, 0, 0.2, 1));
        -webkit-tap-highlight-color: transparent;
        min-height: var(--touch-target-min, 44px);
    }

    .clear-filters-btn:hover {
        background: var(--color-neutral-50, #F9FAFB);
        border-color: var(--color-neutral-300, #D1D5DB);
    }

    .clear-filters-btn:active {
        transform: scale(0.97);
    }

    .clear-filters-btn .material-symbols-outlined {
        font-size: 16px;
    }

    /* ── Results Summary Bar ── */
    .summary-bar {
        display: flex;
        align-items: center;
        gap: var(--space-2, 8px);
        padding: var(--space-2, 8px) var(--space-4, 16px);
        background: var(--color-bg, #F8FAFC);
    }

    .summary-count {
        font-size: var(--font-size-base, 14px);
        font-weight: var(--font-weight-bold, 700);
        color: var(--color-primary, #2F6FED);
    }

    .summary-divider {
        color: var(--color-border, #E5E7EB);
        font-size: var(--font-size-sm, 13px);
    }

    .summary-uo {
        font-size: var(--font-size-sm, 13px);
        color: var(--color-text-secondary, #6B7280);
        font-weight: var(--font-weight-medium, 500);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    /* ── Content Area ── */
    .content-area {
        flex: 1;
        padding: var(--space-3, 12px) var(--space-3, 12px) 120px;
        display: flex;
        flex-direction: column;
        gap: var(--space-2, 8px);
        background: var(--color-bg, #F8FAFC);
    }

    /* ── Loading State ── */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-8, 32px) var(--space-6, 24px);
        text-align: center;
        gap: var(--space-3, 12px);
        min-height: 300px;
    }

    .spinner-ring {
        width: 36px;
        height: 36px;
        border: 3px solid var(--color-border, #E5E7EB);
        border-top-color: var(--color-primary, #2F6FED);
        border-radius: var(--radius-full, 9999px);
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .loading-text {
        font-size: var(--font-size-sm, 13px);
        font-weight: var(--font-weight-semibold, 600);
        color: var(--color-text-secondary, #6B7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* ── Pagination ── */
    .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-4, 16px) 0;
        margin-top: var(--space-2, 8px);
    }

    .pag-btn {
        display: flex;
        align-items: center;
        gap: var(--space-1, 4px);
        padding: var(--space-2, 8px) var(--space-3, 12px);
        border: 1px solid var(--color-border, #E5E7EB);
        border-radius: var(--radius-md, 12px);
        background: var(--color-surface, #FFFFFF);
        font-size: var(--font-size-xs, 12px);
        font-weight: var(--font-weight-bold, 700);
        color: var(--color-primary, #2F6FED);
        cursor: pointer;
        transition: all var(--transition-base, 200ms) var(--easing-ease-in-out, cubic-bezier(0.4, 0, 0.2, 1));
        -webkit-tap-highlight-color: transparent;
        min-height: var(--touch-target-min, 44px);
    }

    .pag-btn:hover:not(:disabled) {
        background: var(--color-neutral-50, #F9FAFB);
        box-shadow: var(--shadow-sm, 0 1px 2px 0 rgba(0, 0, 0, 0.05));
    }

    .pag-btn:active:not(:disabled) {
        transform: scale(0.97);
    }

    .pag-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .pag-btn .material-symbols-outlined {
        font-size: 16px;
    }

    .pag-info {
        font-size: var(--font-size-sm, 13px);
        font-weight: var(--font-weight-semibold, 600);
        color: var(--color-text-secondary, #6B7280);
    }

    /* ── Accessibility - Reduced Motion ── */
    @@media (prefers-reduced-motion: reduce) {
        .primary-cta,
        .clear-filters-btn,
        .pag-btn,
        .header-action {
            transition: none;
        }

        .primary-cta:active,
        .clear-filters-btn:active,
        .pag-btn:active {
            transform: none;
        }

        .spinner-ring {
            animation: none;
            border-top-color: var(--color-border, #E5E7EB);
        }
    }

    /* ── Responsive Adjustments ── */
    @@media (min-width: 768px) {
        .content-area {
            padding: var(--space-4, 16px) var(--space-4, 16px) 120px;
        }

        .filter-chips-section {
            padding: var(--space-4, 16px);
        }
    }
</style>

@code {
    private List<PatrimonioItem> bens = new();
    private List<PatrimonioItem> filteredBens = new();
    private Dictionary<string, InventoryItem> _localByNutomb = new(StringComparer.OrdinalIgnoreCase);
    private string searchQuery = "";
    private BemStatus? selectedStatus = null;
    private ConservationState? selectedConservationState = null;
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Verifica autenticação primeiro
        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verifica se a base de dados foi sincronizada
        var versionKey = $"versao:{user.Prefixo?.Trim().ToUpperInvariant()}";
        var baseVersion = await DbService.GetMetadataAsync(versionKey);
        if (string.IsNullOrWhiteSpace(baseVersion))
        {
            // Base não sincronizada, redireciona para sincronização
            Navigation.NavigateTo("/tombamentos-sync");
            return;
        }

        // Verifica se a sessão está configurada
        if (!appState.IsSessionConfigured())
        {
            // Sessão não configurada, redireciona para configuração
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }

        // Tudo OK, carrega os dados
        appState.OnChange += HandleStateChange;
        await LoadBens();
    }

    private async void HandleStateChange()
    {
        await LoadBens();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBens()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            if (appState.CurrentUO != null)
            {
                var localBens = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                _localByNutomb = localBens
                    .Where(b => !string.IsNullOrWhiteSpace(b.Code))
                    .GroupBy(b => b.Code, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.UpdatedAt).First(), StringComparer.OrdinalIgnoreCase);

                Console.WriteLine($"[Bens.LoadBens] Local bens loaded: {localBens.Count}");

                // Carrega patrimônio filtrado por subárea (se configurada)
                var allPatrimonio = await DbService.GetPatrimonioBySubareaAsync(
                    appState.CurrentUO.IdUO,
                    appState.CurrentArea?.IdArea,
                    appState.CurrentSubarea?.IdSubarea
                );
                
                Console.WriteLine($"[Bens.LoadBens] Patrimonio loaded from DB: {allPatrimonio.Count}");
                Console.WriteLine($"[Bens.LoadBens] UO: {appState.CurrentUO.IdUO}, Area: {appState.CurrentArea?.IdArea}, Subarea: {appState.CurrentSubarea?.IdSubarea}");
                
                // Debug: verificar valores de esfera nos dados
                if (allPatrimonio.Count > 0)
                {
                    var esferasDistintas = allPatrimonio.Select(b => b.Esfera).Distinct().ToList();
                    Console.WriteLine($"[Bens.LoadBens] Esferas distintas no DB: {string.Join(", ", esferasDistintas.Select(e => $"'{e}'"))}");
                }
                
                var esfera = appState.EsferaAtual ?? user.Esfera;
                Console.WriteLine($"[Bens.LoadBens] Esfera do filtro: '{esfera}' (EsferaAtual: '{appState.EsferaAtual}', user.Esfera: '{user.Esfera}')");

                bens = (!string.IsNullOrEmpty(esfera) && esfera != "A")
                    ? allPatrimonio.Where(b => string.Equals(b.Esfera, esfera, StringComparison.OrdinalIgnoreCase)).ToList()
                    : allPatrimonio.ToList();
                
                Console.WriteLine($"[Bens.LoadBens] Bens after esfera filter ({esfera}): {bens.Count}");
                
                // Aplica filtros após carregar
                ApplyFilters();
            }
            else
            {
                Console.WriteLine("[Bens.LoadBens] CurrentUO is null!");
                bens = new List<PatrimonioItem>();
                filteredBens = new List<PatrimonioItem>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading bens: {ex.Message}");
            Console.Error.WriteLine($"Stack trace: {ex.StackTrace}");
            bens = new List<PatrimonioItem>();
            filteredBens = new List<PatrimonioItem>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyFilters()
    {
        Console.WriteLine($"[Bens.ApplyFilters] Starting with {bens.Count} bens");
        Console.WriteLine($"[Bens.ApplyFilters] Selected status: {selectedStatus?.ToString() ?? "null"}");
        Console.WriteLine($"[Bens.ApplyFilters] Selected conservation state: {selectedConservationState?.ToString() ?? "null"}");
        Console.WriteLine($"[Bens.ApplyFilters] Local items count: {_localByNutomb.Count}");
        
        var result = bens.AsEnumerable();

        // Filtro por situação (BemStatus)
        if (selectedStatus.HasValue)
        {
            var beforeFilter = result.Count();
            result = FilterByStatus(result, selectedStatus.Value);
            var afterFilter = result.Count();
            Console.WriteLine($"[Bens.ApplyFilters] After status filter ({selectedStatus.Value.ToDisplayText()}): {afterFilter} (removed {beforeFilter - afterFilter})");
        }

        // Filtro por estado de conservação (ConservationState)
        if (selectedConservationState.HasValue)
        {
            var beforeFilter = result.Count();
            result = FilterByConservationState(result, selectedConservationState.Value);
            var afterFilter = result.Count();
            Console.WriteLine($"[Bens.ApplyFilters] After conservation state filter ({selectedConservationState.Value.ToDisplayText()}): {afterFilter} (removed {beforeFilter - afterFilter})");
        }

        // Filtro por busca (termo de pesquisa)
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var beforeSearch = result.Count();
            result = FilterBySearchQuery(result, searchQuery);
            var afterSearch = result.Count();
            Console.WriteLine($"[Bens.ApplyFilters] After search filter: {afterSearch} (removed {beforeSearch - afterSearch})");
        }

        // Ordena e materializa a lista
        // Bens com captura local mais recente aparecem primeiro
        filteredBens = result
            .OrderByDescending(b => TryGetLocal(b)?.UpdatedAt ?? DateTime.MinValue)
            .ThenBy(b => b.Nutomb)
            .ToList();
        
        Console.WriteLine($"[Bens.ApplyFilters] Final filtered bens: {filteredBens.Count}");
        
        // Reset para primeira página quando filtros mudam
        currentPage = 1;
    }

    /// <summary>
    /// Filtra bens por situação (BemStatus).
    /// Retorna apenas bens que possuem captura local E o status correspondente.
    /// Bens sem captura local são automaticamente excluídos deste filtro.
    /// </summary>
    private IEnumerable<PatrimonioItem> FilterByStatus(IEnumerable<PatrimonioItem> bens, BemStatus status)
    {
        return bens.Where(b =>
        {
            var local = TryGetLocal(b);
            // Apenas bens com captura local (local != null) E status correspondente
            return local != null && local.Status == status;
        });
    }

    /// <summary>
    /// Filtra bens por estado de conservação (ConservationState).
    /// Retorna apenas bens que possuem captura local E o estado correspondente.
    /// </summary>
    private IEnumerable<PatrimonioItem> FilterByConservationState(IEnumerable<PatrimonioItem> bens, ConservationState state)
    {
        return bens.Where(b =>
        {
            var local = TryGetLocal(b);
            return local != null && local.State == state;
        });
    }

    /// <summary>
    /// Filtra bens por termo de busca.
    /// Busca em: código (nutomb), descrição (deprod) e localização.
    /// </summary>
    private IEnumerable<PatrimonioItem> FilterBySearchQuery(IEnumerable<PatrimonioItem> bens, string query)
    {
        return bens.Where(b =>
        {
            if (b.Deprod.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
            if (b.Nutomb.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
            var local = TryGetLocal(b);
            return local?.Location?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
        });
    }

    private void SetStatus(BemStatus? status)
    {
        selectedStatus = status;
        ApplyFilters();
        StateHasChanged();
    }

    private async Task HandleConservationStateFilter(ConservationState? state)
    {
        selectedConservationState = state;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleStatusFilter(BemStatus? status)
    {
        selectedStatus = status;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleClearFilters()
    {
        selectedConservationState = null;
        selectedStatus = null;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearch(string query)
    {
        searchQuery = query;
        ApplyFilters();
        await InvokeAsync(StateHasChanged);
    }

    private InventoryItem? TryGetLocal(PatrimonioItem p)
        => _localByNutomb.TryGetValue(p.Nutomb, out var local) ? local : null;

    private int totalPages => filteredBens.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredBens.Count / PageSize);
    private IEnumerable<PatrimonioItem> pagedBens => filteredBens.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private void PrevPage() 
    { 
        if (currentPage > 1) 
        {
            currentPage--;
            StateHasChanged();
        }
    }
    
    private void NextPage() 
    { 
        if (currentPage < totalPages) 
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private void NavigateToBem(PatrimonioItem bem) => Navigation.NavigateTo($"/bem/{bem.Nutomb}");

    public void Dispose() => appState.OnChange -= HandleStateChange;
}
