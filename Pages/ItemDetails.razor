@page "/item/{Id}"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Services.Storage
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject IJSRuntime JSRuntime
@using MudBlazor
@inject AppState appState
@inject IAuthService AuthService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Detalhes - Aspec Captura</PageTitle>

<style>
    .details-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        overflow: hidden;
    }

    .details-header {
        display: flex;
        align-items: center;
        padding: 48px 24px 24px;
        flex-shrink: 0;
        background: white;
        border-bottom: 1px solid #f1f5f9;
    }

    .details-header-back {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        margin-left: -8px;
        cursor: pointer;
        color: #1e293b;
        font-size: 24px;
    }

    .details-header-content {
        flex: 1;
        padding: 0 16px;
    }

    .details-header-title {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: #1e293b;
    }

    .details-header-subtitle {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-weight: 500;
        color: #94a3b8;
        margin-top: 4px;
    }

    .details-header-user {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .details-header-user-info {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .details-header-user-name {
        font-size: 11px;
        font-weight: 600;
        color: #1e293b;
    }

    .details-header-user-status {
        font-size: 9px;
        color: #22c55e;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .details-header-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .details-main {
        flex: 1;
        overflow-y: auto;
        padding-bottom: 120px;
    }

    .details-image-container {
        position: relative;
        margin: 24px;
    }

    .details-image {
        aspect-ratio: 16 / 10;
        width: 100%;
        overflow: hidden;
        background: #f1f5f9;
        border-radius: 0 0 24px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .details-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .details-image-dots {
        position: absolute;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
    }

    .details-image-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: white;
    }

    .details-image-dot.inactive {
        opacity: 0.4;
    }

    .details-image-btn {
        position: absolute;
        bottom: 16px;
        right: 16px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: white;
    }

    .details-content {
        padding: 24px;
        space-y: 32px;
    }

    .details-section {
        margin-bottom: 32px;
    }

    .field-container {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 8px;
        margin-bottom: 24px;
    }

    .field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #94a3b8;
        margin-bottom: 8px;
        display: block;
    }

    .field-value {
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
    }

    .field-input {
        width: 100%;
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
        background: transparent;
        border: none;
        padding: 0;
        resize: none;
    }

    .field-input:focus {
        outline: none;
    }

    .field-select {
        width: 100%;
        font-size: 16px;
        font-weight: 500;
        color: #1e293b;
        background: transparent;
        border: none;
        padding: 0;
    }

    .field-select:focus {
        outline: none;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
    }

    .conservation-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .conservation-btn {
        padding: 8px 20px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .conservation-btn.new {
        background: #f0fdf4;
        color: #16a34a;
        border-color: #dcfce7;
    }

    .conservation-btn.good {
        background: #eff6ff;
        color: #2563eb;
        border-color: #dbeafe;
    }

    .conservation-btn.regular {
        background: #fffbeb;
        color: #d97706;
        border-color: #fef3c7;
    }

    .conservation-btn.recoverable {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fee2e2;
    }

    .conservation-btn.active {
        font-weight: 700;
        box-shadow: 0 0 0 2px rgba(0, 51, 102, 0.2);
    }

    .history-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: white;
        color: #64748b;
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .history-btn:hover {
        background: #f8fafc;
    }

    .save-btn {
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        background: #003366;
        color: white;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform 0.2s ease;
        box-shadow: 0 4px 12px rgba(0, 51, 102, 0.2);
    }

    .save-btn:active {
        transform: scale(0.98);
    }

    .save-btn-container {
        position: fixed;
        bottom: 80px;
        left: 24px;
        right: 24px;
        z-index: 30;
        max-width: calc(100% - 48px);
    }

    .loading-spinner {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 50vh;
    }

    .error-message {
        padding: 16px;
        background: #fee2e2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        color: #dc2626;
        margin: 24px;
    }
</style>

@if (isLoading)
{
    <div class="loading-spinner">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-message">
        @errorMessage
    </div>
    <div style="padding: 24px;">
        <button class="history-btn" @onclick="GoBack">
            ← Voltar
        </button>
    </div>
}
else if (item == null)
{
    <div class="error-message">
        Item não encontrado ou removido.
    </div>
    <div style="padding: 24px;">
        <button class="history-btn" @onclick="GoBack">
            ← Voltar
        </button>
    </div>
}
else
{
    <div class="details-container">
        <!-- Header -->
        <header class="details-header">
            <button class="details-header-back" @onclick="GoBack" title="Voltar">
                ←
            </button>
            <div class="details-header-content">
                <h1 class="details-header-title">Detalhes</h1>
                <p class="details-header-subtitle">Patrimônio #@item.Code</p>
            </div>
            <div class="details-header-user">
                <div class="details-header-user-info">
                    <span class="details-header-user-name">Aspec Avatar</span>
                    <span class="details-header-user-status">Online</span>
                </div>
                <div class="details-header-avatar">
                    <span class="material-symbols-outlined">account_circle</span>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="details-main">
            <!-- Image Section -->
            <div class="details-image-container">
                <div class="details-image">
                    @if (!string.IsNullOrEmpty(item.CoverImage))
                    {
                        <img src="@item.CoverImage" alt="@item.Name" />
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 48px; color: #cbd5e1;">image</span>
                    }
                </div>
                <div class="details-image-dots">
                    <div class="details-image-dot"></div>
                    <div class="details-image-dot inactive"></div>
                    <div class="details-image-dot inactive"></div>
                </div>
                <button class="details-image-btn" @onclick="AddPhotos">
                    <span class="material-symbols-outlined">add_a_photo</span>
                </button>
            </div>

            <!-- Content Section -->
            <div class="details-content">
                <div class="details-section">
                    <!-- Description -->
                    <div class="field-container">
                        <label class="field-label">Descrição</label>
                        <textarea class="field-input" placeholder="Descreva o item..." rows="4">@item.Name</textarea>
                    </div>

                    <!-- Value and Location Row -->
                    <div class="field-row">
                        <div class="field-container">
                            <label class="field-label">Valor Estimado</label>
                            <div style="display: flex; align-items: center;">
                                <span style="color: #94a3b8; margin-right: 4px; font-size: 14px; font-weight: 500;">R$</span>
                                <input type="text" class="field-input" value="@item.EstimatedValue.ToString("N2")" />
                            </div>
                        </div>
                        <div class="field-container">
                            <label class="field-label">Localização</label>
                            <select class="field-select">
                                <option selected>@item.Location</option>
                            </select>
                        </div>
                    </div>

                    <!-- Conservation State -->
                    <div class="details-section">
                        <label class="field-label">Estado de Conservação</label>
                        <div class="conservation-buttons">
                            <button class="conservation-btn new @(item.State == ConservationState.New ? "active" : "")" 
                                @onclick="() => UpdateConservationState(ConservationState.New)">
                                Novo
                            </button>
                            <button class="conservation-btn good @(item.State == ConservationState.Good ? "active" : "")" 
                                @onclick="() => UpdateConservationState(ConservationState.Good)">
                                Bom
                            </button>
                            <button class="conservation-btn regular @(item.State == ConservationState.Regular ? "active" : "")" 
                                @onclick="() => UpdateConservationState(ConservationState.Regular)">
                                Regular
                            </button>
                            <button class="conservation-btn recoverable @(item.State == ConservationState.Recoverable ? "active" : "")" 
                                @onclick="() => UpdateConservationState(ConservationState.Recoverable)">
                                Recuperável
                            </button>
                        </div>
                    </div>

                    <!-- Observations -->
                    <div class="field-container">
                        <label class="field-label">Observações</label>
                        <input type="text" class="field-input" placeholder="Adicionar nota..." value="@item.Observations" />
                    </div>
                </div>

                <!-- History Button -->
                <div>
                    <button class="history-btn">
                        <span class="material-symbols-outlined">history</span>
                        Ver Histórico de Movimentações
                    </button>
                </div>
            </div>
        </main>

        <!-- Save Button - Floating -->
        <div class="save-btn-container">
            <button class="save-btn" @onclick="SaveChanges">
                <span>Salvar Alterações</span>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private InventoryItem? item;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Verificar se a sessão está configurada
            if (!appState.IsSessionConfigured())
            {
                Navigation.NavigateTo("/configuracao-sessao");
                return;
            }
            
            await LoadItem();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao inicializar página: {ex.Message}";
            Console.Error.WriteLine($"ItemDetails OnInitializedAsync error: {ex}");
            isLoading = false;
        }
    }

    private async Task LoadItem()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            if (string.IsNullOrEmpty(Id))
            {
                errorMessage = "ID do item não fornecido";
                isLoading = false;
                return;
            }

            item = await DbService.GetAsync<InventoryItem>("items", Id);
            
            if (item == null)
            {
                errorMessage = "Item não encontrado no banco de dados";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar item: {ex.Message}";
            Console.Error.WriteLine($"LoadItem error: {ex}");
            ToastService.ShowError(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddPhotos()
    {
        ToastService.ShowInfo("Funcionalidade de câmera em desenvolvimento");
    }

    private void UpdateConservationState(ConservationState state)
    {
        if (item != null)
        {
            item.State = state;
            StateHasChanged();
        }
    }

    private async Task SaveChanges()
    {
        if (item == null) return;

        try
        {
            item.UpdatedAt = DateTime.UtcNow;
            await DbService.UpdateAsync("items", item);
            ToastService.ShowSuccess("Item atualizado com sucesso!");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao salvar alterações: {ex.Message}";
            ToastService.ShowError(errorMessage);
            Console.Error.WriteLine($"SaveChanges error: {ex}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/dashboard");
    }
}
