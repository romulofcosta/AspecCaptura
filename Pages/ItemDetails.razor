@page "/item/{Id}"
@using pwa_camera_poc_blazor.Models
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject CameraService _cameraService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject AppState appState
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Detalhes do Item - ASPEC Capture</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 pb-20 details-container">
    @if (isLoading)
    {
        <div class="d-flex justify-center align-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (item == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">Item não encontrado ou removido.
        </MudAlert>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="GoBack">Voltar</MudButton>
    }
    else
    {
        <MudCard Elevation="4" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">@item.Nome</MudText>
                    <div class="d-flex gap-2 mt-2">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                            @item.Category</MudChip>
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">@item.Codigo
                        </MudChip>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="EditItem" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Localização</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@item.Localizacao</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Status</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@(item.Sincronizado ? "Sincronizado" : "Pendente")</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Observações</MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">@item.Observacoes</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Data Cadastro</MudText>
                            <MudText Typo="Typo.body1">@item.DataHora.ToString("dd/MM/yyyy HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Unidade</MudText>
                            <MudText Typo="Typo.body1">@item.UnidadeGestoraId</MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Fotos (@(item.Photos.Any() ? item.Photos.Count : item.RemoteUrls.Count))</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton StartIcon="@Icons.Material.Filled.AddAPhoto" Color="Color.Primary" OnClick="AddPhotos">
                        Adicionar</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @{
                    var displayPhotos = item.Photos.Any() ? item.Photos : item.RemoteUrls;
                }
                @if (displayPhotos.Any())
                {
                    <MudGrid Spacing="2">
                        @foreach (var (photo, index) in displayPhotos.Select((p, i) => (p, i)))
                        {
                            <MudItem @key="index" xs="6" sm="4" md="3">
                                <div class="details-image-card">
                                    <MudImage Src="@photo" ObjectFit="ObjectFit.Cover"
                                        Class="details-image cursor-pointer"
                                        OnClick="() => ViewFullImage(photo)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                        Class="details-delete-btn"
                                        OnClick="() => ConfirmRemovePhoto(index)" />
                                    @if (index == 0)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                            Class="details-chip-capa">Capa</MudChip>
                                    }
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <div class="d-flex justify-center align-center py-8">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhuma foto cadastrada</MudText>
                    </div>
                }
            </MudCardContent>
        </MudCard>

        <div class="mt-4">
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" OnClick="GoBack">Voltar para
                Lista</MudButton>
        </div>
    }
</MudContainer>

<!-- Camera Overlay - Custom Implementation -->
@if (showCameraModal)
{
    <!-- Dark Background -->
    <div class="modal-scrim" @onclick="CloseCameraModal"></div>
    
    <!-- Modal Content -->
    <div @onclick:stopPropagation class="camera-modal-content">
        <MudPaper Class="d-flex flex-column" Style="height: 100%; padding: 0; position: relative;">
            <!-- Header -->
            <div class="d-flex justify-space-between align-center pa-4" Style="border-bottom: 1px solid rgba(0,0,0,0.1); flex-shrink: 0;">
                <MudText Typo="Typo.h6">Nova Foto</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseCameraModal" />
            </div>

            <!-- Scrollable Content Area -->
            <div Style="flex: 1; overflow-y: auto; padding: 16px; min-height: 0;">
                <!-- Video Feed -->
                <div class="camera-viewport mb-3">
                    <video id="detail-camera-feed" autoplay playsinline></video>
                </div>

                <!-- Camera Controls -->
                <div class="d-flex gap-4 justify-center mb-3">
                    <MudIconButton Icon="@Icons.Material.Filled.FlipCameraIos" Color="Color.Secondary" OnClick="SwitchCamera"
                        Size="Size.Large" />
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Camera" OnClick="CaptureNewPhoto" />
                </div>

                <!-- Photo Thumbnails -->
                @if (newPhotos.Any())
                {
                    <div class="d-flex gap-2 mb-3 overflow-x-auto width-100">
                        @foreach (var p in newPhotos)
                        {
                            <MudImage Src="@p" Width="60" Height="60" ObjectFit="ObjectFit.Cover" Class="rounded" />
                        }
                    </div>
                }
            </div>

            <!-- Fixed Save Button at Bottom -->
            @if (newPhotos.Any())
            {
                <div Style="padding: 16px; border-top: 1px solid rgba(0,0,0,0.1); background: var(--mud-palette-surface); flex-shrink: 0; position: relative; z-index: 10;">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="SaveNewPhotos">
                        Salvar (@newPhotos.Count)</MudButton>
                </div>
            }
        </MudPaper>
    </div>
}

<!-- Full Image Overlay -->
@if (showFullImage)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="true" OnClick="CloseFullImage" ZIndex="3000">
        <div class="full-image-container">
            <MudImage Src="@fullImageSrc" ObjectFit="ObjectFit.Contain" Class="full-image" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Surface" Size="Size.Large"
                Class="full-image-close" OnClick="CloseFullImage" />
        </div>
    </MudOverlay>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private ItemPatrimonio? item;
    private bool isLoading = true;
    private bool showCameraModal = false;
    private bool useFrontCamera = false;
    private List<string> newPhotos = new();
    private bool showFullImage = false;
    private string fullImageSrc = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadItem();
    }

    private async Task LoadItem()
    {
        isLoading = true;
        try
        {
            item = await DbService.GetAsync<ItemPatrimonio>("items", Id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao carregar item: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddPhotos()
    {
        showCameraModal = true;
        appState.IsCameraActive = true;
        newPhotos.Clear();
        StateHasChanged();
        await _cameraService.IniciarCameraAsync("detail-camera-feed", useFrontCamera);
    }

    private async Task SwitchCamera()
    {
        useFrontCamera = !useFrontCamera;
        await _cameraService.PararCameraAsync("detail-camera-feed");
        await _cameraService.IniciarCameraAsync("detail-camera-feed", useFrontCamera);
    }

    private async Task CaptureNewPhoto()
    {
        try
        {
            var photo = await _cameraService.CapturarImagemAsync("detail-camera-feed");
            if (!string.IsNullOrEmpty(photo))
            {
                newPhotos.Add(photo);
                ToastService.ShowSuccess("Foto capturada!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao capturar foto: " + ex.Message);
        }
    }

    private async Task SaveNewPhotos()
    {
        if (item == null || !newPhotos.Any()) return;

        try
        {
            item.Photos.AddRange(newPhotos);
            await DbService.UpdateAsync("items", item);
            await CloseCameraModal();
            ToastService.ShowSuccess($"{newPhotos.Count} foto(s) adicionada(s) com sucesso!");
            newPhotos.Clear();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar fotos: " + ex.Message);
        }
    }

    // Replaces the custom modal with MudDialog MessageBox
    private async Task ConfirmRemovePhoto(int index)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Confirmar Remoção",
        "Deseja realmente remover esta foto?",
        yesText: "Remover", cancelText: "Cancelar");

        if (result == true)
        {
            await RemovePhoto(index);
        }
    }

    private async Task RemovePhoto(int index)
    {
        if (item == null) return;
        try
        {
            // Determinar se é remota ou local com base na exibição (prioridade para Photos)
            if (item.Photos.Any())
            {
                if (index < item.Photos.Count)
                {
                    item.Photos.RemoveAt(index);
                }
            }
            else
            {
                if (index < item.RemoteUrls.Count)
                {
                    item.RemoteUrls.RemoveAt(index);
                }
            }

            await DbService.UpdateAsync("items", item);
            ToastService.ShowSuccess("Foto removida com sucesso!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao remover foto: " + ex.Message);
        }
    }

    private void ViewFullImage(string photo)
    {
        fullImageSrc = photo;
        showFullImage = true;
    }

    private void CloseFullImage()
    {
        showFullImage = false;
        fullImageSrc = string.Empty;
    }

    private async Task CloseCameraModal()
    {
        await _cameraService.PararCameraAsync("detail-camera-feed");
        showCameraModal = false;
        appState.IsCameraActive = false;
        newPhotos.Clear();
    }

    private void EditItem()
    {
        ToastService.Show("Funcionalidade de edição em desenvolvimento", "info");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/home");
    }

    public async ValueTask DisposeAsync()
    {
        await _cameraService.PararCameraAsync("detail-camera-feed");
    }
}
