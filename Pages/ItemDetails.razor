@page "/item/{Id}"
@using pwa_camera_poc_blazor.Models
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject CameraService CameraService
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@using MudBlazor
@inject AppState appState
@inject IAuthService AuthService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Detalhes do Item - ASPEC Capture</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4 pb-16">
    @if (isLoading)
    {
        <div class="d-flex justify-center align-center" style="height: 50vh;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (item == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">Item não encontrado ou removido.
        </MudAlert>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="GoBack">Voltar</MudButton>
    }
    else
    {
        <MudCard Elevation="4" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">@item.Name</MudText>
                    <div class="d-flex gap-2 mt-2">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                            @item.Category</MudChip>
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">@item.Code
                        </MudChip>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="EditItem" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Localização</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@item.Location</MudText>
                    </MudItem>
                    <MudItem xs="6" sm="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Status</MudText>
                        <MudText Typo="Typo.body1" Class="mb-2">@(item.Synced ? "Sincronizado" : "Pendente")</MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Observações</MudText>
                            <MudText Typo="Typo.body1" Class="mb-2">@item.Observations</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Data Cadastro</MudText>
                            <MudText Typo="Typo.body1">@item.Timestamp.ToString("dd/MM/yyyy HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Unidade</MudText>
                            <MudText Typo="Typo.body1">@item.UnitId</MudText>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

        <MudCard Elevation="4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Fotos (@(item.Photos.Count + item.RemoteUrls.Count))</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton StartIcon="@Icons.Material.Filled.AddAPhoto" Color="Color.Primary" OnClick="AddPhotos">
                        Adicionar</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                @if (item.Photos.Any() || item.RemoteUrls.Any())
                {
                    <MudGrid Spacing="2">
                        @foreach (var (photo, index) in item.RemoteUrls.Concat(item.Photos).Select((p, i) => (p, i)))
                        {
                            <MudItem xs="6" sm="4" md="3">
                                <div style="position: relative; aspect-ratio: 1/1;">
                                    <MudImage Src="@photo" ObjectFit="ObjectFit.Cover"
                                        Style="width:100%; height:100%; border-radius: 4px; cursor: pointer;"
                                    @onclick="() => ViewFullImage(photo)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                        Style="position: absolute; top: 4px; right: 4px; background: rgba(255,255,255,0.8);"
                                        OnClick="() => ConfirmRemovePhoto(index)" />
                                    @if (index == 0)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                            Style="position: absolute; bottom: 4px; left: 4px;">Capa</MudChip>
                                    }
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <div class="d-flex justify-center align-center py-8">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhuma foto cadastrada</MudText>
                    </div>
                }
            </MudCardContent>
        </MudCard>

        <div class="mt-4">
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Outlined" OnClick="GoBack">Voltar para
                Lista</MudButton>
        </div>
    }
</MudContainer>

<!-- Camera Overlay using MudOverlay -->
@if (showCameraModal)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="false" ZIndex="2000">
        <MudPaper Class="pa-4 d-flex flex-column align-center" Style="width: 90vw; height: 90vh; max-width: 600px;">
            <div class="d-flex justify-space-between width-100 mb-2">
                <MudText Typo="Typo.h6">Nova Foto</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseCameraModal" />
            </div>

            <div class="flex-grow-1 width-100 mb-2" style="background: black; position: relative;">
                <video id="detail-camera-feed" autoplay playsinline
                    style="width: 100%; height: 100%; object-fit: cover;"></video>
            </div>

            <div class="d-flex gap-4">
                <MudIconButton Icon="@Icons.Material.Filled.FlipCameraIos" Color="Color.Secondary" OnClick="SwitchCamera"
                    Size="Size.Large" />
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Camera" OnClick="CaptureNewPhoto" />
            </div>

            @if (newPhotos.Any())
            {
                <div class="d-flex gap-2 mt-4 overflow-x-auto width-100">
                    @foreach (var p in newPhotos)
                    {
                        <MudImage Src="@p" Width="60" Height="60" ObjectFit="ObjectFit.Cover" Class="rounded" />
                    }
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-2" OnClick="SaveNewPhotos">
                    Salvar (@newPhotos.Count)</MudButton>
            }
        </MudPaper>
    </MudOverlay>
}

<!-- Full Image Overlay -->
@if (showFullImage)
{
    <MudOverlay Visible="true" DarkBackground="true" AutoClose="true" OnClick="CloseFullImage" ZIndex="3000">
        <div class="d-flex justify-center align-center" style="width: 100vw; height: 100vh; padding: 20px;">
            <MudImage Src="@fullImageSrc" ObjectFit="ObjectFit.Contain" Style="max-width: 100%; max-height: 100%;" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Surface" Size="Size.Large"
                Style="position: absolute; top: 20px; right: 20px;" OnClick="CloseFullImage" />
        </div>
    </MudOverlay>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private InventoryItem? item;
    private bool isLoading = true;
    private bool showCameraModal = false;
    private bool useFrontCamera = false;
    private List<string> newPhotos = new();
    private bool showFullImage = false;
    private string fullImageSrc = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadItem();
    }

    private async Task LoadItem()
    {
        isLoading = true;
        try
        {
            item = await DbService.GetAsync<InventoryItem>("items", Id);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao carregar item: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddPhotos()
    {
        showCameraModal = true;
        appState.IsCameraActive = true;
        newPhotos.Clear();
        StateHasChanged();
        await CameraService.StartCameraAsync("detail-camera-feed", useFrontCamera);
    }

    private async Task SwitchCamera()
    {
        useFrontCamera = !useFrontCamera;
        await CameraService.StopCameraAsync("detail-camera-feed");
        await CameraService.StartCameraAsync("detail-camera-feed", useFrontCamera);
    }

    private async Task CaptureNewPhoto()
    {
        try
        {
            var photo = await CameraService.TakePhotoAsync("detail-camera-feed");
            if (!string.IsNullOrEmpty(photo))
            {
                newPhotos.Add(photo);
                ToastService.ShowSuccess("Foto capturada!");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao capturar foto: " + ex.Message);
        }
    }

    private async Task SaveNewPhotos()
    {
        if (item == null || !newPhotos.Any()) return;

        try
        {
            item.Photos.AddRange(newPhotos);
            await DbService.UpdateAsync("items", item);
            await CloseCameraModal();
            ToastService.ShowSuccess($"{newPhotos.Count} foto(s) adicionada(s) com sucesso!");
            newPhotos.Clear();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao salvar fotos: " + ex.Message);
        }
    }

    // Replaces the custom modal with MudDialog MessageBox
    private async Task ConfirmRemovePhoto(int index)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Confirmar Remoção",
        "Deseja realmente remover esta foto?",
        yesText: "Remover", cancelText: "Cancelar");

        if (result == true)
        {
            await RemovePhoto(index);
        }
    }

    private async Task RemovePhoto(int index)
    {
        if (item == null) return;
        try
        {
            // Determinar se é remota ou local
            if (index < item.RemoteUrls.Count)
            {
                item.RemoteUrls.RemoveAt(index);
            }
            else
            {
                var localIndex = index - item.RemoteUrls.Count;
                item.Photos.RemoveAt(localIndex);
            }

            await DbService.UpdateAsync("items", item);
            ToastService.ShowSuccess("Foto removida com sucesso!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao remover foto: " + ex.Message);
        }
    }

    private void ViewFullImage(string photo)
    {
        fullImageSrc = photo;
        showFullImage = true;
    }

    private void CloseFullImage()
    {
        showFullImage = false;
        fullImageSrc = string.Empty;
    }

    private async Task CloseCameraModal()
    {
        await CameraService.StopCameraAsync("detail-camera-feed");
        showCameraModal = false;
        appState.IsCameraActive = false;
        newPhotos.Clear();
    }

    private void EditItem()
    {
        ToastService.Show("Funcionalidade de edição em desenvolvimento", "info");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/home");
    }

    public async ValueTask DisposeAsync()
    {
        await CameraService.StopCameraAsync("detail-camera-feed");
    }
}
