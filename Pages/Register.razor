@page "/register"
@layout AuthLayout
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Cadastro - ASPEC Inventory</PageTitle>

<button class="theme-toggle" @onclick="ToggleTheme" aria-label="Alternar tema">
    <span>
        @if (isDarkMode)
        {
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path
                    d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
        }
    </span>
</button>

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="6" width="16" height="14" rx="3" />
                <path d="M4 10h16" />
            </svg>
        </div>
        <h1 class="auth-title">Criar Conta</h1>
        <p class="auth-subtitle">Cadastre-se para começar</p>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="auth-alert @alertType show">@alertMessage</div>
    }

    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" class="auth-form">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="register-username" class="form-label">Usuário</label>
            <InputText id="register-username" class="form-input" @bind-Value="registerModel.Username"
                placeholder="Escolha um usuário" required minlength="3" />
        </div>

        <div class="form-group">
            <label for="register-password" class="form-label">Senha</label>
            <InputText type="password" id="register-password" class="form-input" @bind-Value="registerModel.Password"
                placeholder="Escolha uma senha" required minlength="4" />
        </div>

        <div class="form-group">
            <label class="form-label">Unidades Gestoras (Selecione pelo menos uma)</label>
            <div class="units-filter-bar">
                <InputText id="units-search-input" class="form-input" @bind-Value="searchQuery"
                    placeholder="Buscar unidade por nome" />
                <div class="units-filters-row">
                    <select class="form-select" @onchange="OnStateChanged">
                        <option value="">Todos os Estados</option>
                        @foreach (var state in states)
                        {
                            <option value="@state.Id">@state.Id - @state.Name</option>
                        }
                    </select>
                    <select class="form-select" disabled="@(string.IsNullOrEmpty(selectedStateId))"
                    @onchange="OnCityChanged">
                        <option value="">Todas as Cidades</option>
                        @foreach (var city in filteredCities)
                        {
                            <option value="@city.Id">@city.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (selectedUnits.Any())
            {
                <div class="selected-units">
                    @foreach (var unit in selectedUnits)
                    {
                        <div class="unit-chip">
                            <span>@unit.Value</span>
                            <button type="button" @onclick="() => RemoveUnit(unit.Key)">×</button>
                        </div>
                    }
                </div>
            }

            <div class="units-container">
                @if (availableUnits.Any())
                {
                    @foreach (var unit in filteredAvailableUnits)
                    {
                        <div class="unit-checkbox-item">
                            <div class="unit-label">@unit.Name</div>
                            <button type="button" class="add-unit-btn" @onclick="() => AddUnit(unit)"
                                disabled="@selectedUnits.ContainsKey(unit.Id)">
                                @if (selectedUnits.ContainsKey(unit.Id))
                                {
                                    <span>Adicionado</span>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24">
                                        <path d="M12 5v14" />
                                        <path d="M5 12h14" />
                                    </svg> <span>Adicionar</span>
                                }
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="units-placeholder">Selecione uma cidade primeiro</div>
                }
            </div>
        </div>

        <button type="submit" class="btn-primary @(isLoading ? "btn-loading" : "")" disabled="@isLoading">
            @(isLoading ? "" : "Cadastrar")
        </button>
    </EditForm>

    <div class="auth-toggle">
        <span>Já tem conta?</span>
        <a href="/login" class="auth-toggle-link">Faça login</a>
    </div>
</div>

<style>
    .units-container {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem;
        max-height: 150px;
        overflow-y: auto;
        background: var(--bg-input);
    }

    .units-filter-bar {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .units-filters-row {
        display: flex;
        gap: 0.5rem;
    }

    .units-placeholder {
        color: var(--text-secondary);
        font-size: 0.875rem;
        text-align: center;
        padding: 1rem;
    }

    .unit-checkbox-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        padding: 0.25rem;
        border-bottom: 1px solid var(--border-color);
    }

    .unit-checkbox-item:last-child {
        border-bottom: none;
    }

    .unit-label {
        flex: 1;
        font-size: 0.9rem;
        color: var(--text-primary);
        line-height: 1.4;
        padding-right: 10px;
    }

    .selected-units {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.5rem 0;
    }

    .unit-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 0.25rem 0.5rem;
        font-size: 0.85rem;
        color: var(--text-primary);
    }

    .unit-chip button {
        border: none;
        background: none;
        color: var(--danger-color);
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        padding: 0 0.25rem;
    }

    .add-unit-btn {
        border: 1px solid var(--border-color);
        background: var(--surface-color);
        color: var(--text-secondary);
        border-radius: 8px;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.8rem;
    }

    .add-unit-btn svg {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
    }

    .add-unit-btn:disabled {
        opacity: 0.6;
        cursor: default;
    }
</style>

@code {
    private RegisterModel registerModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool isDarkMode = false;
    private string searchQuery = "";

    private List<State> states = new();
    private List<City> filteredCities = new();
    private List<Unit> availableUnits = new();
    private Dictionary<int, string> selectedUnits = new();

    private string? selectedStateId;
    private int? selectedCityId;

    protected override async Task OnInitializedAsync()
    {
        await DbService.InitAsync();
        states = await DbService.GetAllAsync<State>("states");
        var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
        isDarkMode = theme == "dark";
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        selectedStateId = e.Value?.ToString();
        selectedCityId = null;
        availableUnits.Clear();
        if (string.IsNullOrEmpty(selectedStateId))
        {
            filteredCities.Clear();
        }
        else
        {
            // Note: Our interop getFromIndex handles this
            filteredCities = await JSRuntime.InvokeAsync<List<City>>("dbInterop.getFromIndex", "cities", "stateId",
            selectedStateId);
        }
    }

    private async Task OnCityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var cityId))
        {
            selectedCityId = cityId;
            availableUnits = await JSRuntime.InvokeAsync<List<Unit>>("dbInterop.getFromIndex", "units", "cityId", cityId);
        }
        else
        {
            selectedCityId = null;
            availableUnits.Clear();
        }
    }

    private IEnumerable<Unit> filteredAvailableUnits =>
    string.IsNullOrWhiteSpace(searchQuery)
    ? availableUnits
    : availableUnits.Where(u => u.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void AddUnit(Unit unit)
    {
        if (!selectedUnits.ContainsKey(unit.Id))
        {
            selectedUnits.Add(unit.Id, unit.Name);
        }
    }

    private void RemoveUnit(int id)
    {
        selectedUnits.Remove(id);
    }

    private async Task HandleRegister()
    {
        if (!selectedUnits.Any())
        {
            alertMessage = "Selecione pelo menos uma unidade gestora.";
            alertType = "error";
            return;
        }

        isLoading = true;
        alertMessage = null;

        try
        {
            await AuthService.RegisterAsync(registerModel.Username, registerModel.Password, selectedUnits.Keys.ToList());
            alertMessage = "Cadastro realizado com sucesso!";
            alertType = "success";
            await Task.Delay(1000);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            alertMessage = "Erro ao realizar cadastro: " + ex.Message;
            alertType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", isDarkMode ? "dark" : "light");
    }

    public class RegisterModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
