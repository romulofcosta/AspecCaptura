@page "/register"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IIndexedDbService DbService
@inject IJSRuntime JSRuntime
@inject AppState appState

<PageTitle>Cadastro - ASPEC Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center pa-4 register-container">
    <MudPaper id="register-card" Elevation="4" Class="pa-8 pa-sm-10 rounded-lg premium-card w-100 register-card">
        <div class="d-flex flex-column align-center mb-6">
            <div class="d-flex justify-center mb-4">
                <MudImage Src="images/aspec_logo.png" 
                    Alt="ASPEC Logo - Sistema de Captura de Patrimônio"
                    Class="logo-hover shadow-sm register-logo"
                    Width="64"
                    Height="64"
                    Loading="eager"
                    fetchpriority="high" />
            </div>
            <div class="d-flex justify-center mb-2">
                <h1 class="app-title-login">Aspec Capture</h1>
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true" Class="font-weight-bold">
                Criar conta
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Preencha os dados abaixo para começar a usar o app
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <MudAlert Severity="@(alertType == "success" ? Severity.Success : Severity.Error)" Class="mb-4">
                @alertMessage
            </MudAlert>
        }

        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <MudGrid Spacing="1">
                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Nome</MudText>
                    <MudTextField @bind-Value="registerModel.FirstName" Placeholder="Digite seu nome"
                        Variant="Variant.Outlined" InputType="InputType.Text" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Person" For="@(() => registerModel.FirstName)"
                        FullWidth="true" Class="mb-2" AutoFocus="true" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Sobrenome</MudText>
                    <MudTextField @bind-Value="registerModel.LastName" Placeholder="Digite seu sobrenome"
                        Variant="Variant.Outlined" InputType="InputType.Text" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Badge" For="@(() => registerModel.LastName)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">E-mail</MudText>
                    <MudTextField @bind-Value="registerModel.Username" Placeholder="Digite seu e-mail"
                        Variant="Variant.Outlined" InputType="InputType.Email" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Email" For="@(() => registerModel.Username)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Senha</MudText>
                    <MudTextField @bind-Value="registerModel.Password" Placeholder="Crie uma senha"
                        Variant="Variant.Outlined" InputType="InputType.Password" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Lock" For="@(() => registerModel.Password)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Confirmar senha</MudText>
                    <MudTextField @bind-Value="registerModel.ConfirmPassword" Placeholder="Repita a senha"
                        Variant="Variant.Outlined" InputType="InputType.Password" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Lock" For="@(() => registerModel.ConfirmPassword)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <!-- ESTADO MUDSELECT -->
<MudItem xs="12" Class="pb-4">
                    <MudSelect T="string" 
                               @bind-Value="SelectedStateId" 
                               Label="Estado" 
                               Variant="Variant.Outlined" 
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               Margin="Margin.Dense"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.LocationOn"
                               Disabled="@(!statesLoaded)"
                               FullWidth="true"
                               Class="mb-2">
                        @if (statesLoaded)
                        {
                            @foreach (var state in states)
                            {
                                <MudSelectItem Value="@state.Id">@state.Nome</MudSelectItem>
                            }
                        }
                        else
                        {
                            <MudSelectItem Value="@string.Empty" Disabled="true">Carregando...</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- CIDADE MUDSELECT -->
                <MudItem xs="12" Class="pb-4">
                    <MudSelect T="int" 
                               @bind-Value="SelectedCityId" 
                               Label="Município" 
                               Variant="Variant.Outlined" 
                               AnchorOrigin="Origin.BottomLeft"
                               TransformOrigin="Origin.TopLeft"
                               Margin="Margin.Dense"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.LocationCity"
                               Disabled="@(isLoading || !citiesLoaded || string.IsNullOrEmpty(SelectedStateId))"
                               FullWidth="true"
                               Class="mb-2"
                               Placeholder="@(string.IsNullOrEmpty(SelectedStateId) ? "Selecione um estado primeiro" : "Selecione o município")">
                        @foreach (var city in filteredCities)
                        {
                            <MudSelectItem Value="@city.Id">@city.Nome</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- UNIDADE MUDSELECT -->
                <MudItem xs="12" Class="pb-2">
                     <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">
                        Unidades Gestoras
                    </MudText>
                     
                     <div class="d-flex flex-column gap-2">
                          <MudSelect T="int" 
                                     @bind-Value="selectedUnitIdForAdd" 
                                     Label="Selecione uma unidade" 
                                     Variant="Variant.Outlined" 
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Business"
                                     Disabled="@(isLoading || !unitsLoaded || SelectedCityId == 0)"
                                     FullWidth="true"
                                     Placeholder="@(SelectedCityId == 0 ? "Selecione um município primeiro" : "Selecione uma unidade")">
                            @foreach (var unit in filteredUnits)
                            {
                                <MudSelectItem Value="@unit.Id">@unit.Nome</MudSelectItem>
                            }
                        </MudSelect>
                        
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(isLoading || !unitsLoaded || SelectedCityId == 0 || selectedUnitIdForAdd == 0)"
                                   OnClick="AddUnit"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   FullWidth="true"
                                   Class="add-unit-btn">
                            Adicionar unidade
                        </MudButton>

                        @if (registerModel.UnitIds.Any())
                        {
                            <div class="chips-container fade-in">
                                @foreach (var unitId in registerModel.UnitIds)
                                {
                                    <MudChip T="int" 
                                             Variant="Variant.Filled" 
                                             Color="Color.Primary" 
                                             Class="hover-lift"
                                             OnClose="() => RemoveUnit(unitId)">
                                        @GetUnitName(unitId)
                                    </MudChip>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(unitSelectionError))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="field-error">@unitSelectionError</MudText>
                        }
                     </div>
                </MudItem>

                <MudItem xs="12" Class="pt-2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                        FullWidth="true" Disabled="@isLoading" Size="Size.Large" Class="ms-n1 register-submit-btn shadow-md">
                        @if (isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Criando conta...</span>
                        }
                        else
                        {
                            <span>Criar conta</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>

        <div class="d-flex justify-center mt-6">
            <MudText Typo="Typo.body2" Class="mr-2">Já tem conta?</MudText>
            <MudLink Href="/login" Underline="Underline.Hover">Entrar</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private RegisterModel registerModel = new();
    private List<Estado> states = new();
    private List<Cidade> cities = new();
    private List<UnidadeGestora> units = new();
    private List<Cidade> filteredCities = new();
    private List<UnidadeGestora> filteredUnits = new();
    private bool statesLoaded = false;
    private bool citiesLoaded = false;
    private bool unitsLoaded = false;

    // Backing fields
    private string _selectedStateId = string.Empty;
    private int _selectedCityId;
    
    // Properties with logic
    public string SelectedStateId 
    { 
        get => _selectedStateId; 
        set 
        {
            if (_selectedStateId != value)
            {
                _selectedStateId = value;
                // Logic cascading
                _selectedCityId = 0;
                if (!string.IsNullOrEmpty(_selectedStateId))
                {
                    filteredCities = cities.Where(c => c.EstadoId == _selectedStateId).ToList();
                }
                else
                {
                    filteredCities = new List<Cidade>();
                }
                filteredUnits = new List<UnidadeGestora>();
                registerModel.UnitIds.Clear();
                StateHasChanged(); // Force UI update
            }
        } 
    }

    public int SelectedCityId 
    { 
        get => _selectedCityId; 
        set 
        { 
            if (_selectedCityId != value)
            {
                _selectedCityId = value;
                if (_selectedCityId > 0)
                {
                    filteredUnits = units.Where(u => u.CidadeId == _selectedCityId).ToList();
                }
                else
                {
                    filteredUnits = new List<UnidadeGestora>();
                }
                registerModel.UnitIds.Clear();
                StateHasChanged();
            }
        }
    }

    private int selectedUnitIdForAdd;
    private string? unitSelectionError;

    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#register-card");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch { }

        try
        {
            Console.WriteLine("Carregando estados...");
            states = await DbService.GetAllAsync<Estado>("states");
            if (states == null || !states.Any()) 
            {
                Console.WriteLine("AVISO: Nenhum estado encontrado no IndexedDB.");
                // Tenta carregar mocks APENAS se estiver vazio
                states = new List<Estado> { 
                    new Estado { Id = "CE", Nome = "Ceará" }, 
                    new Estado { Id = "SP", Nome = "São Paulo" } 
                };
            }
            statesLoaded = true;
            Console.WriteLine($"Estados carregados: {states.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERRO ao carregar estados: {ex.Message}");
            statesLoaded = false;
        }

        try
        {
            cities = await DbService.GetAllAsync<Cidade>("cities");
            citiesLoaded = true;
        }
        catch
        {
            citiesLoaded = false;
        }

        try
        {
            units = await DbService.GetAllAsync<UnidadeGestora>("units");
            unitsLoaded = true;
        }
        catch
        {
            unitsLoaded = false;
        }
    }

    private void AddUnit()
    {
        unitSelectionError = null;

        if (!unitsLoaded || SelectedCityId == 0)
        {
            unitSelectionError = "Selecione um município antes de adicionar unidades.";
            return;
        }

        if (selectedUnitIdForAdd == 0)
        {
            unitSelectionError = "Selecione uma unidade gestora.";
            return;
        }

        if (registerModel.UnitIds.Contains(selectedUnitIdForAdd))
        {
            unitSelectionError = "Esta unidade já foi adicionada.";
            return;
        }

        registerModel.UnitIds.Add(selectedUnitIdForAdd);
    }

    private void RemoveUnit(int unitId)
    {
        unitSelectionError = null;
        registerModel.UnitIds.Remove(unitId);
    }

    private string GetUnitName(int unitId)
    {
        var unit = filteredUnits.FirstOrDefault(u => u.Id == unitId) ?? units.FirstOrDefault(u => u.Id == unitId);
        return unit?.Nome ?? $"Unidade {unitId}";
    }

    private async Task HandleRegister()
    {
        alertMessage = null;
        alertType = null;
        isLoading = true;

        if (registerModel.UnitIds == null || !registerModel.UnitIds.Any())
        {
            alertMessage = "Selecione ao menos uma unidade gestora.";
            alertType = "error";
            isLoading = false;
            return;
        }

        try
        {
            await AuthService.RegisterAsync(
                registerModel.FirstName,
                registerModel.LastName,
                registerModel.Username,
                registerModel.Password,
                registerModel.UnitIds);

            alertMessage = "Cadastro realizado com sucesso! Redirecionando para o login...";
            alertType = "success";
            StateHasChanged();
            await Task.Delay(1000);
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            alertMessage = "Erro ao realizar cadastro. Tente novamente.";
            alertType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Campo obrigatório")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        [EmailAddress(ErrorMessage = "Formato de e-mail inválido")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        [MinLength(6, ErrorMessage = "A senha deve ter no mínimo 6 caracteres")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        [Compare(nameof(Password), ErrorMessage = "As senhas não coincidem")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public List<int> UnitIds { get; set; } = new();
    }
}
