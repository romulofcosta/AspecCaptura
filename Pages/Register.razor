    private async Task OnStateChanged(string value)
    {
        if (selectedStateId == value) return;

        selectedStateId = value;
        selectedCityId = null;
        availableUnits.Clear();
        filteredCities.Clear();

        if (!string.IsNullOrEmpty(selectedStateId))
        {
            try
            {
                filteredCities = await DbService.GetAllFromIndexAsync<City>("cities", "stateId", selectedStateId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading cities: {ex.Message}");
            }
        }

        StateHasChanged();
    }

    private async Task OnCityChanged(int? value)
    {
        if (selectedCityId == value) return;

        selectedCityId = value;
        availableUnits.Clear();

        if (value.HasValue)
        {
            try
            {
                availableUnits = await DbService.GetAllFromIndexAsync<Unit>("units", "cityId", value.Value);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error loading units: {ex.Message}");
            }
        }

        StateHasChanged();
    }

    private IEnumerable<Unit> filteredAvailableUnits =>
    string.IsNullOrWhiteSpace(searchQuery)
    ? availableUnits
    : availableUnits.Where(u => u.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void AddUnit(Unit unit)
    {
        if (!selectedUnits.ContainsKey(unit.Id))
        {
            selectedUnits.Add(unit.Id, unit.Name);
        }
    }

    private void RemoveUnit(int id)
    {
        selectedUnits.Remove(id);
    }

    private async Task HandleRegister()
    {
        if (!selectedUnits.Any())
        {
            alertMessage = "Selecione pelo menos uma unidade gestora.";
            alertType = "error";
            return;
        }

        isLoading = true;
        alertMessage = null;

        try
        {
            await AuthService.RegisterAsync(registerModel.Username, registerModel.Password, registerModel.FirstName,
            registerModel.LastName, selectedUnits.Keys.ToList());
            alertMessage = "Cadastro realizado com sucesso!";
            alertType = "success";
            await Task.Delay(1000);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            alertMessage = "Erro ao realizar cadastro: " + ex.Message;
            alertType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "A senha deve ter pelo menos 6 caracteres")]
        public string Password { get; set; } = string.Empty;
    }
}
