@page "/home"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inventário - ASPEC Capture</PageTitle>

<div id="inventory-section" class="inventory-section">
    <!-- Search and Filter Bar -->
    <div class="search-bar">
        <div class="search-input-wrapper">
            <span class="search-icon"><svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4.3-4.3" />
                </svg></span>
            <FluentSearch Placeholder="Buscar por nome, código ou categoria..." @bind-Value="searchQuery" />
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <FluentButton Appearance="Appearance.Stealth" @onclick="ClearSearch" aria-label="Limpar busca">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 6L6 18" />
                        <path d="M6 6l12 12" />
                    </svg>
                </FluentButton>
            }
        </div>

        <div id="search-controls" class="search-controls">
            <FluentButton Appearance="@(showFilters ? Appearance.Accent : Appearance.Stealth)" @onclick="ToggleFilters"
                aria-label="Filtros" title="Filtros">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
            </FluentButton>
            <div class="view-toggle">
                <FluentButton Appearance="@(viewMode == "grid" ? Appearance.Accent : Appearance.Stealth)"
                    @onclick="ToggleViewMode" aria-label="Alternar Visualização" title="Alternar Visualização">
                    @if (viewMode == "grid")
                    {
                        <span class="icon-grid">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="3" width="8" height="8" rx="1" />
                                <rect x="13" y="3" width="8" height="8" rx="1" />
                                <rect x="3" y="13" width="8" height="8" rx="1" />
                                <rect x="13" y="13" width="8" height="8" rx="1" />
                            </svg>
                        </span>
                    }
                    else
                    {
                        <span class="icon-list">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </span>
                    }
                </FluentButton>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div id="filter-panel" class="filter-panel @(showFilters ? "" : "hidden")">
        <div class="filter-group">
            <FluentLabel>Categoria:</FluentLabel>
            <div class="filter-chips">
                @foreach (var category in categories)
                {
                    <FluentButton Appearance="@(selectedCategory == category ? Appearance.Accent : Appearance.Stealth)"
                        @onclick="() => SelectCategory(category)">@category</FluentButton>
                }
            </div>
        </div>
        <div class="filter-group">
            <FluentLabel>Ordenar por:</FluentLabel>
            <FluentSelect TOption="string" @bind-Value="sortOrder" @onchange="OnSortChanged">
                <FluentOption TOption="string" Value="newest">Mais recentes</FluentOption>
                <FluentOption TOption="string" Value="oldest">Mais antigos</FluentOption>
                <FluentOption TOption="string" Value="name-asc">Nome (A-Z)</FluentOption>
                <FluentOption TOption="string" Value="name-desc">Nome (Z-A)</FluentOption>
                <FluentOption TOption="string" Value="code-asc">Código (A-Z)</FluentOption>
            </FluentSelect>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">Carregando itens...</div>
    }
    else if (!filteredItems.Any())
    {
        <!-- Empty State -->
        <div id="empty-state" class="empty-state">
            <div class="empty-icon">📸</div>
            <h3>Nenhum item no inventário</h3>
            <p>Comece capturando fotos dos itens que deseja inventariar</p>
        </div>
    }
    else
    {
        <!-- Gallery Grid/List -->
        <div id="gallery-grid" class="gallery-grid @(viewMode == "list" ? "list-view" : "")">
            @foreach (var item in pagedItems)
            {
                <ItemCard Item="item" OnView="() => NavigateToItem(item.Id)" />
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div id="pagination" class="pagination">
                <FluentButton Appearance="Appearance.Outline" Disabled="@(currentPage == 1)" @onclick="PrevPage">← Anterior</FluentButton>
                <span id="page-info" class="page-info">Página @currentPage de @totalPages</span>
                <FluentButton Appearance="Appearance.Outline" Disabled="@(currentPage == totalPages)" @onclick="NextPage">Próxima →</FluentButton>
            </div>
        }
    }
</div>



@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private string selectedCategory = "Todas";
    private string sortOrder = "newest";
    private string viewMode = "grid";
    private bool showFilters = false;
    private bool isLoading = true;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;

    private readonly string[] categories = { "Todas", "Móveis", "Eletrônicos", "Equipamentos", "Ferramentas", "Materiais",
"Outros" };

    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(async () =>
        {
            await LoadItems();
            StateHasChanged();
        });
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.CurrentUnitId != null)
            {
                items = await DbService.GetItemsByUnitAsync(user.CurrentUnitId.Value);

                // If no items, load example item
                if (!items.Any())
                {
                    await LoadExampleItem(user.CurrentUnitId.Value);
                    items = await DbService.GetItemsByUnitAsync(user.CurrentUnitId.Value);
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExampleItem(int unitId)
    {
        try
        {
            var json = await HttpClient.GetStringAsync("sample-data/exemplo-item.json");
            var exampleItem = System.Text.Json.JsonSerializer.Deserialize<InventoryItem>(json);
            if (exampleItem != null)
            {
                exampleItem.UnitId = unitId;
                await DbService.AddAsync("items", exampleItem);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading example item: " + ex.Message);
        }
    }

    private void ToggleFilters() => showFilters = !showFilters;
    private void ToggleViewMode() => viewMode = viewMode == "grid" ? "list" : "grid";
    private void ClearSearch() => searchQuery = "";

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        currentPage = 1;
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        sortOrder = e.Value?.ToString() ?? "newest";
        currentPage = 1;
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (selectedCategory != "Todas")
            {
                result = result.Where(i => i.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            result = sortOrder switch
            {
                "oldest" => result.OrderBy(i => i.Timestamp),
                "name-asc" => result.OrderBy(i => i.Name),
                "name-desc" => result.OrderByDescending(i => i.Name),
                "code-asc" => result.OrderBy(i => i.Code),
                _ => result.OrderByDescending(i => i.Timestamp)
            };

            return result;
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / pageSize);
    private IEnumerable<InventoryItem> pagedItems => filteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItem(string itemId)
    {
        Navigation.NavigateTo($"/item/{itemId}");
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}
