@page "/home"
@using pwa_camera_poc_blazor.Models
@using pwa_camera_poc_blazor.Components.Shared
@using Microsoft.JSInterop
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@using pwa_camera_poc_blazor.Services.AWS
@inject IAwsStorageService AwsService
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inventário - ASPEC Capture</PageTitle>

<MudContainer id="home-container" MaxWidth="MaxWidth.False" Class="pa-0 pb-20 home-container">
    <div class="px-4 pt-6">
        <!-- Search Bar & Filters -->
        <div class="d-flex align-center gap-2 mb-6">
            <MudPaper Elevation="2" Class="pa-1 rounded-pill d-flex align-center flex-grow-1 home-search-paper">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="ml-4" Color="Color.Default" />
                <MudTextField @bind-Value="searchQuery" Placeholder="Buscar por nome, código ou local..." 
                    Variant="Variant.Text" Class="flex-grow-1 mx-2" Margin="Margin.Dense" Underline="false" />
            </MudPaper>
            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="@(showFilters ? Color.Primary : Color.Default)" 
                OnClick="ToggleFilters" Variant="Variant.Filled" Class="home-btn-filter" />
        </div>

        <MudGrid Spacing="3">
            <!-- Action Button (Escanear Placa) -->
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                    StartIcon="@Icons.Material.Filled.DocumentScanner" OnClick="IniciarEscaneamento"
                    Class="home-btn-scan hover-lift ripple-effect">
                    Escanear Placa
                </MudButton>
            </MudItem>

            <!-- List Header -->
            <MudItem xs="12" Class="d-flex align-center justify-space-between mt-2">
                <MudText Typo="Typo.h6" Class="font-weight-bold">Ativos Registrados <span class="home-items-count">(@filteredItems.Count())</span></MudText>
                <MudLink Underline="Underline.None" Color="Color.Primary" Class="home-link-view-all">Ver todos</MudLink>
            </MudItem>

            <!-- Filter Panel -->
            @if (showFilters)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-4 rounded-lg slide-in-down" Elevation="2">
                        <div class="d-flex align-center justify-space-between mb-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Filtros e Ordenação</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ToggleFilters" />
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">Categoria</MudText>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (var category in categories)
                                    {
                                        <MudChip T="string" Color="@(selectedCategory == category ? Color.Primary : Color.Default)"
                                            OnClick="() => SelectCategory(category)"
                                            Variant="@(selectedCategory == category ? Variant.Filled : Variant.Outlined)"
                                            Size="Size.Medium"
                                            Style="min-height: 44px; min-width: 44px; padding: var(--spacing-md) var(--spacing-lg);">
                                            @category
                                        </MudChip>
                                    }
                                </div>
                            </MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string" @bind-Value="SortOrderProperty" Label="Ordenar por" Variant="Variant.Outlined"
                                    AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem Value="@("newest")">Mais recentes</MudSelectItem>
                                    <MudSelectItem Value="@("oldest")">Mais antigos</MudSelectItem>
                                    <MudSelectItem Value="@("name-asc")">Nome (A-Z)</MudSelectItem>
                                    <MudSelectItem Value="@("name-desc")">Nome (Z-A)</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

        @if (isLoading)
        {
            <MudItem xs="12" Class="d-flex flex-column gap-3">
                <SkeletonCard />
                <SkeletonCard />
                <SkeletonCard />
                <SkeletonCard />
            </MudItem>
        }
        else if (!filteredItems.Any())
        {
            <MudItem xs="12" Class="d-flex flex-column align-center justify-center my-16 py-16 fade-in">
                <div class="rounded-circle d-flex align-center justify-center mb-6 home-empty-state-icon-container float">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Default" Class="home-empty-state-icon" />
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold" Align="Align.Center">Nada por aqui ainda</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mb-8">Tente ajustar seus filtros ou comece a cadastrar novos patrimônios.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DocumentScanner" 
                    OnClick="IniciarInventario" Size="Size.Large" Class="home-btn-start hover-lift">
                    Começar Inventário
                </MudButton>
            </MudItem>
        }
        else
        {
            @foreach (var item in pagedItems)
            {
                <MudItem Class="inventory-grid-item stagger-item" xs="12" sm="@(viewMode == "list" ? 12 : 6)" md="@(viewMode == "list" ? 12 : 6)"
                    lg="@(viewMode == "list" ? 12 : 6)">
                    <ItemCard Item="item" OnView="NavigateToItemCallback" IsListView="@(viewMode == "list")" />
                </MudItem>
            }

            @if (totalPages > 1)
            {
                <MudItem xs="12" Class="d-flex justify-center align-center gap-4 my-8">
                    <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == 1)" OnClick="PrevPage"
                        StartIcon="@Icons.Material.Filled.ChevronLeft">Anterior</MudButton>
                    <MudText Typo="Typo.body2">Página @currentPage de @totalPages</MudText>
                    <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == totalPages)" OnClick="NextPage"
                        EndIcon="@Icons.Material.Filled.ChevronRight">Próxima</MudButton>
                </MudItem>
            }
        }
    </MudGrid>
</div>
</MudContainer>

@code {
    private List<ItemPatrimonio> items = new();
    private string searchQuery = "";
    private string selectedCategory = "Todas";
    private string sortOrder = "newest";
    private string viewMode = "list";
    private bool showFilters = false;
    private bool isLoading = true;
    private bool isSyncing = false;
    private DotNetObjectReference<Home>? dotNetHelper;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;

    private readonly string[] categories = { "Todas", "Móveis", "Eletrônicos", "Equipamentos", "Ferramentas", "Materiais",
"Outros" };

    // Property binding for Sort Order to handle page reset
    private string SortOrderProperty
    {
        get => sortOrder;
        set
        {
            if (sortOrder != value)
            {
                sortOrder = value;
                currentPage = 1;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#home-container");
                
                // Initialize pull-to-refresh gesture
                dotNetHelper = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("gestureHandler.initPullToRefresh", "home-container", dotNetHelper);
                
                // Tenta sincronizar automaticamente ao carregar (mas sem bloquear UI ou forçar re-upload agressivo)
                _ = SyncPendingItems(autoSync: true);
            }
            catch { /* Log or handle JS interop errors if necessary */ }
        }
    }

    [JSInvokable]
    public async Task OnPullToRefresh()
    {
        Console.WriteLine("[Home] Pull to refresh triggered");
        await LoadItems();
        await SyncPendingItems(autoSync: false);
    }

    private async Task SyncPendingItems(bool autoSync = false)
    {
        if (isSyncing) return;
        
        // Se for autoSync, não bloqueamos UI com loading global, apenas processamos
        if (!autoSync) 
        {
            isSyncing = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            var username = user?.NomeUsuario ?? "unknown";

            // CORREÇÃO OTIMIZADA: Buscar apenas IDs dos itens pendentes para evitar carregar fotos pesadas
            // Usa índice 'synced' (false = 0)
            List<string> pendingIds = new();
            try {
                pendingIds = await DbService.GetAllKeysFromIndexAsync<string>("items", "synced", 0);
            }
            catch {
                 // Fallback: se índice não existir
                 Console.WriteLine("Fallback sync: buscando todos os itens (lento)");
                 var allItems = await DbService.GetAllAsync<ItemPatrimonio>("items");
                 if (allItems != null)
                    pendingIds = allItems.Where(i => !i.Sincronizado).Select(i => i.Id).ToList();
            }

            if (!pendingIds.Any()) 
            {
                if (!autoSync) isSyncing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
            
            bool stateChanged = false;

            // Processa um por um para economizar memória
            foreach (var id in pendingIds)
            {
                // Carrega o item completo (com fotos)
                var item = await DbService.GetAsync<ItemPatrimonio>("items", id);
                
                // Filtra usuário
                if (item == null || item.CriadoPor != username) continue;
                if (item.Sincronizado) continue;

                bool itemSyncSuccess = false;

                // 1. Verifica se já existe no S3 (evita re-upload desnecessário)
                bool exists = await AwsService.ItemExistsInS3Async(item.Id);
                
                if (exists)
                {
                    itemSyncSuccess = true;
                }
                else
                {
                    // 2. Se não existe, tenta fazer o upload
                    
                    // A. Upload da Foto (se houver)
                    bool photoSuccess = true;
                    if (item.Photos != null && item.Photos.Any())
                    {
                        var firstPhoto = item.Photos.FirstOrDefault();
                        if (!string.IsNullOrEmpty(firstPhoto))
                        {
                            var (success, url) = await AwsService.UploadPhotoAsync(item.Id, item.Codigo, firstPhoto);
                            if (success && !string.IsNullOrEmpty(url))
                            {
                                if (item.RemoteUrls == null) item.RemoteUrls = new List<string>();
                                if (!item.RemoteUrls.Contains(url))
                                {
                                    item.RemoteUrls.Add(url);
                                }
                            }
                            else
                            {
                                photoSuccess = false;
                                Console.WriteLine($"Falha ao enviar foto do item {item.Nome}");
                            }
                        }
                    }

                    // B. Upload dos Metadados (apenas se foto ok ou se não tiver foto)
                    if (photoSuccess)
                    {
                        var metadata = ItemMetadata.FromItemPatrimonio(item, username);
                        var (metaSuccess, _) = await AwsService.UploadMetadataAsync(item.Id, metadata);
                        
                        if (metaSuccess)
                        {
                            itemSyncSuccess = true;
                        }
                        else
                        {
                             Console.WriteLine($"Falha ao enviar metadados do item {item.Nome}");
                        }
                    }
                }

                // 3. Atualiza estado local se sucesso (seja por já existir ou por upload novo)
                if (itemSyncSuccess)
                {
                    // Tenta garantir que temos a URL remota para exibição
                    var imageUrl = await AwsService.GetItemImageUrlAsync(item);
                    if (!string.IsNullOrEmpty(imageUrl))
                    {
                        if (item.RemoteUrls == null) item.RemoteUrls = new List<string>();
                        if (!item.RemoteUrls.Contains(imageUrl))
                        {
                            item.RemoteUrls.Add(imageUrl);
                        }
                    }

                    item.Sincronizado = true;
                    // item.Photos = new List<string>(); // MANTÉM fotos locais
                    
                    await DbService.UpdateAsync("items", item);
                    stateChanged = true;
                }
            }

            if (stateChanged)
            {
                // Atualiza contadores globais
                if (user != null)
                {
                    // Como não temos 'synced' E 'createdBy' juntos, é difícil contar pendentes sem carregar.
                    // Ignora contagem precisa por enquanto para evitar lentidão
                }
                
                // Recarrega lista para refletir status
                await LoadItems(); 
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro na sincronização: {ex.Message}");
        }
        finally
        {
            isSyncing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Mantendo compatibilidade com o nome antigo caso algum outro componente chame, mas redirecionando
    private async Task CheckRemoteSyncStatus() => await SyncPendingItems();

    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.UnidadeGestoraAtualId != null)
            {
                // Aqui ainda usamos GetItemsByUnitAsync que carrega tudo.
                // Se o usuário tiver muitos itens, isso será lento.
                var allItems = await DbService.GetItemsByUnitAsync(user.UnidadeGestoraAtualId.Value);
                
                // Filtra apenas os itens criados pelo usuário atual
                items = allItems.Where(i => i.CriadoPor == user.NomeUsuario).ToList();

                // If no items, load example item
                if (!items.Any())
                {
                    await LoadExampleItem(user.UnidadeGestoraAtualId.Value, user.NomeUsuario);
                    allItems = await DbService.GetItemsByUnitAsync(user.UnidadeGestoraAtualId.Value);
                    items = allItems.Where(i => i.CriadoPor == user.NomeUsuario).ToList();
                }
            }
            else
            {
                items = new List<ItemPatrimonio>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExampleItem(int unitId, string username)
    {
        try
        {
            var json = await HttpClient.GetStringAsync("sample-data/exemplo-item.json");
            var exampleItem = System.Text.Json.JsonSerializer.Deserialize<ItemPatrimonio>(json);
            if (exampleItem != null)
            {
                exampleItem.UnidadeGestoraId = unitId;
                exampleItem.CriadoPor = username; // Define o criador
                await DbService.AddAsync("items", exampleItem);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading example item: " + ex.Message);
        }
    }

    private void ToggleFilters() => showFilters = !showFilters;
    private void ToggleViewMode() => viewMode = viewMode == "grid" ? "list" : "grid";
    private void ClearSearch() => searchQuery = "";

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        currentPage = 1;
    }

    private IEnumerable<ItemPatrimonio> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (selectedCategory != "Todas")
            {
                result = result.Where(i => i.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                i.Nome.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Codigo.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            result = sortOrder switch
            {
                "oldest" => result.OrderBy(i => i.DataHora),
                "name-asc" => result.OrderBy(i => i.Nome),
                "name-desc" => result.OrderByDescending(i => i.Nome),
                "code-asc" => result.OrderBy(i => i.Codigo),
                _ => result.OrderByDescending(i => i.DataHora)
            };

            return result;
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / pageSize);
    private IEnumerable<ItemPatrimonio> pagedItems => filteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItemCallback(ItemPatrimonio item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    /// <summary>
    /// Inicia o escaneamento de placa - navega para a página de captura em modo scan
    /// </summary>
    private void IniciarEscaneamento()
    {
        Navigation.NavigateTo("/captura?mode=scan");
    }

    /// <summary>
    /// Inicia o inventário - navega para a página de captura em modo photo
    /// </summary>
    private void IniciarInventario()
    {
        Navigation.NavigateTo("/captura?mode=photo");
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
        dotNetHelper?.Dispose();
    }
}