@page "/"
@page "/home"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@using pwa_camera_poc_blazor.Services.AWS
@inject IAwsStorageService AwsService
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Aspec Captura</PageTitle>

<!-- Header -->
<div class="minimal-header">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #F1F5F9; display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Medium" Color="Color.Default" />
            </div>
            <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h1 style="font-size: 18px; font-weight: 600; color: #003366; margin: 0;">
                        Olá, @GetFirstName()
                    </h1>
                </div>
                <p style="font-size: 12px; color: #94A3B8; font-weight: 500; margin: 0;">Aspec Captura</p>
            </div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" 
                       Color="Color.Default" 
                       Style="background: #F8FAFC; border-radius: 50%;" 
                       OnClick="@(() => Navigation.NavigateTo("/notifications"))" />
    </div>
    
    <div class="context-info" style="justify-content: space-between;">
        <div class="context-info">
            <MudIcon Icon="@Icons.Material.Filled.BusinessCenter" Size="Size.Small" Color="Color.Default" />
            <span class="context-text">@GetContextName()</span>
        </div>
        <button class="btn-change" @onclick="ChangeContext">Alterar</button>
    </div>
</div>

<!-- Main Content -->
<div style="padding: 32px 24px;">
    
    <!-- Statistics Cards -->
    <section style="margin-bottom: 40px;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
            <div class="minimal-card stat-card">
                <span class="stat-label">Total</span>
                <span class="stat-value" style="color: #003366;">@items.Count</span>
            </div>
            <div class="minimal-card stat-card">
                <span class="stat-label">Sincro.</span>
                <span class="stat-value" style="color: #2e7d32;">@items.Count(i => i.Synced)</span>
            </div>
            <div class="minimal-card stat-card">
                <span class="stat-label">Pend.</span>
                <span class="stat-value" style="color: #ed6c02;">@items.Count(i => !i.Synced)</span>
            </div>
        </div>
    </section>
    
    <!-- Search and Capture -->
    <section style="margin-bottom: 40px; display: flex; flex-direction: column; gap: 16px;">
        <div style="position: relative;">
            <div style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); pointer-events: none;">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Default" />
            </div>
            <input class="search-minimal" 
                   placeholder="Buscar patrimônio..." 
                   type="text" 
                   @bind="searchQuery"
                   @bind:event="oninput" />
        </div>
        
        <button class="btn-primary-minimal" @onclick="StartCapture">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" Color="Color.Surface" />
            <span>Iniciar Captura</span>
        </button>
    </section>
    
    <!-- Recent Items -->
    <section>
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <h2 class="section-title">Itens Recentes</h2>
            <button class="btn-change" @onclick="ViewAll">Ver todos</button>
        </div>
        
        @if (isLoading)
        {
            <div style="display: flex; justify-content: center; padding: 40px 0;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!filteredItems.Any())
        {
            <div style="text-align: center; padding: 40px 0; color: #94A3B8;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Style="opacity: 0.3; font-size: 64px;" />
                <p style="margin-top: 16px; font-size: 14px;">Nenhum item encontrado</p>
            </div>
        }
        else
        {
            @foreach (var item in filteredItems.Take(10))
            {
                <div class="item-card-minimal" @onclick="@(() => NavigateToItem(item))">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div class="icon-box">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Color="Color.Default" />
                        </div>
                        <div>
                            <p style="font-weight: 600; color: #1E293B; font-size: 14px; margin: 0;">@item.Name</p>
                            <p style="font-size: 10px; color: #94A3B8; font-weight: 500; margin: 0;">
                                #@item.Code • @item.UpdatedAt.ToString("dd/MM HH:mm")
                            </p>
                        </div>
                    </div>
                    @if (item.Synced)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Color="Color.Default" Style="opacity: 0.3;" />
                    }
                </div>
            }
        }
    </section>
</div>

@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se a sessão está configurada
        if (!appState.IsSessionConfigured())
        {
            Navigation.NavigateTo("/configuracao-sessao");
            return;
        }
        
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            string esfera = appState.EsferaAtual ?? user?.Esfera ?? string.Empty;
            
            if (appState.CurrentUO?.IdUO != null)
            {
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                
                if (esfera == "A")
                {
                    items = allItems.ToList();
                }
                else if (!string.IsNullOrEmpty(esfera))
                {
                    items = allItems.Where(i => i.Esfera == esfera).ToList();
                }
                else
                {
                    items = allItems.ToList();
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }

            // If no items, load example item
            if (!items.Any())
            {
                await LoadExampleItem(appState.CurrentUO?.IdUO ?? "", user?.UsuarioNome ?? "");
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO?.IdUO ?? "");
                if (esfera == "A")
                    items = allItems.ToList();
                else if (!string.IsNullOrEmpty(esfera))
                    items = allItems.Where(i => i.Esfera == esfera).ToList();
                else
                    items = allItems.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExampleItem(string idUO, string username)
    {
        try
        {
            var json = await HttpClient.GetStringAsync("sample-data/exemplo-item.json");
            var exampleItem = System.Text.Json.JsonSerializer.Deserialize<InventoryItem>(json);
            if (exampleItem != null)
            {
                exampleItem.IdOrgao = appState.CurrentOrgao?.IdOrgao;
                exampleItem.IdUO = idUO;
                exampleItem.IdArea = appState.CurrentArea?.IdArea;
                exampleItem.IdSubarea = appState.CurrentSubarea?.IdSubarea;
                exampleItem.CreatedBy = username;
                await DbService.AddAsync("items", exampleItem);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading example item: " + ex.Message);
        }
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                    i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            return result.OrderByDescending(i => i.UpdatedAt);
        }
    }

    private string GetFirstName()
    {
        if (appState.CurrentUser == null) return "Usuário";
        var parts = appState.CurrentUser.NomeCompleto?.Split(' ');
        return parts?.FirstOrDefault() ?? "Usuário";
    }

    private string GetContextName()
    {
        return appState.CurrentUO?.NomeUO ?? "Selecione uma unidade";
    }

    private void ChangeContext()
    {
        Navigation.NavigateTo("/configuracao-sessao");
    }

    private void StartCapture()
    {
        Navigation.NavigateTo("/camera");
    }

    private void ViewAll()
    {
        Navigation.NavigateTo("/items");
    }

    private void NavigateToItem(InventoryItem item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}