@page "/home"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inventário - ASPEC Capture</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 pb-16">
    <!-- Search and Filter Bar -->
    <MudPaper Elevation="0" Class="d-flex gap-2 align-center pa-2 mb-4 mud-background-gray rounded-lg">
        <MudTextField @bind-Value="searchQuery" Label="Buscar" Placeholder="Buscar por nome, código ou categoria..."
            Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
            Class="flex-grow-1 label-fix" Clearable="true" OnClearButtonClick="ClearSearch" Margin="Margin.Dense"
            UserAttributes="@(new Dictionary<string, object> { { "id", "search-input" } })" />

        <div class="d-flex gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                Color="@(showFilters ? Color.Primary : Color.Default)" OnClick="ToggleFilters" AriaLabel="Filtros" />

            <MudIconButton
                Icon="@(viewMode == "grid" ? Icons.Material.Filled.GridView : Icons.Material.Filled.ViewList)"
                Color="@(viewMode == "grid" ? Color.Primary : Color.Default)" OnClick="ToggleViewMode"
                AriaLabel="Alternar Visualização" />
        </div>
    </MudPaper>

    <!-- Filter Panel -->
    @if (showFilters)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Categoria:</MudText>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var category in categories)
                        {
                            <MudChip T="string" Color="@(selectedCategory == category ? Color.Primary : Color.Default)"
                                OnClick="() => SelectCategory(category)"
                                Variant="@(selectedCategory == category ? Variant.Filled : Variant.Outlined)">
                                @category
                            </MudChip>
                        }
                    </div>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="SortOrderProperty" Label="Ordenar por" Variant="Variant.Outlined"
                        AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense"
                        UserAttributes="@(new Dictionary<string, object> { { "id", "sort-select" } })">
                        <MudSelectItem Value="@("newest")">Mais recentes</MudSelectItem>
                        <MudSelectItem Value="@("oldest")">Mais antigos</MudSelectItem>
                        <MudSelectItem Value="@("name-asc")">Nome (A-Z)</MudSelectItem>
                        <MudSelectItem Value="@("name-desc")">Nome (Z-A)</MudSelectItem>
                        <MudSelectItem Value="@("code-asc")">Código (A-Z)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-center my-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (!filteredItems.Any())
    {
        <!-- Empty State -->
        <div class="d-flex flex-column align-center my-16">
            <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Large" Color="Color.Default"
                Style="font-size: 6rem; opacity: 0.3;" />
            <MudText Typo="Typo.h5" Class="mt-4">Nenhum item encontrado</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Tente mudar os filtros ou capture novos itens.</MudText>
        </div>
    }
    else
    {
        <!-- Gallery Grid/List -->
        <MudGrid Spacing="3">
            @foreach (var item in pagedItems)
            {
                <MudItem xs="12" sm="@(viewMode == "list" ? 12 : 6)" md="@(viewMode == "list" ? 12 : 4)"
                    lg="@(viewMode == "list" ? 12 : 3)">
                    <ItemCard Item="item" OnView="NavigateToItemCallback" IsListView="@(viewMode == "list")" />
                </MudItem>
            }
        </MudGrid>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="d-flex justify-center align-center gap-4 my-8">
                <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == 1)" OnClick="PrevPage"
                    StartIcon="@Icons.Material.Filled.ChevronLeft">Anterior</MudButton>
                <MudText>Página @currentPage de @totalPages</MudText>
                <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == totalPages)" OnClick="NextPage"
                    EndIcon="@Icons.Material.Filled.ChevronRight">Próxima</MudButton>
            </div>
        }
    }
</MudContainer>



@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private string selectedCategory = "Todas";
    private string sortOrder = "newest";
    private string viewMode = "grid";
    private bool showFilters = false;
    private bool isLoading = true;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;

    private readonly string[] categories = { "Todas", "Móveis", "Eletrônicos", "Equipamentos", "Ferramentas", "Materiais",
"Outros" };

    // Property binding for Sort Order to handle page reset
    private string SortOrderProperty
    {
        get => sortOrder;
        set
        {
            if (sortOrder != value)
            {
                sortOrder = value;
                currentPage = 1;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(async () =>
        {
            await LoadItems();
            StateHasChanged();
        });
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.CurrentUnitId != null)
            {
                items = await DbService.GetItemsByUnitAsync(user.CurrentUnitId.Value);

                // If no items, load example item
                if (!items.Any())
                {
                    await LoadExampleItem(user.CurrentUnitId.Value);
                    items = await DbService.GetItemsByUnitAsync(user.CurrentUnitId.Value);
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExampleItem(int unitId)
    {
        try
        {
            var json = await HttpClient.GetStringAsync("sample-data/exemplo-item.json");
            var exampleItem = System.Text.Json.JsonSerializer.Deserialize<InventoryItem>(json);
            if (exampleItem != null)
            {
                exampleItem.UnitId = unitId;
                await DbService.AddAsync("items", exampleItem);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading example item: " + ex.Message);
        }
    }

    private void ToggleFilters() => showFilters = !showFilters;
    private void ToggleViewMode() => viewMode = viewMode == "grid" ? "list" : "grid";
    private void ClearSearch() => searchQuery = "";

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        currentPage = 1;
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (selectedCategory != "Todas")
            {
                result = result.Where(i => i.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            result = sortOrder switch
            {
                "oldest" => result.OrderBy(i => i.Timestamp),
                "name-asc" => result.OrderBy(i => i.Name),
                "name-desc" => result.OrderByDescending(i => i.Name),
                "code-asc" => result.OrderBy(i => i.Code),
                _ => result.OrderByDescending(i => i.Timestamp)
            };

            return result;
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / pageSize);
    private IEnumerable<InventoryItem> pagedItems => filteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItemCallback(InventoryItem item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}
