@page "/home"
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@using pwa_camera_poc_blazor.Services.AWS
@inject IAwsStorageService AwsService
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inventário - ASPEC Capture</PageTitle>

<MudContainer id="home-container" MaxWidth="MaxWidth.Large" Class="mt-4 pb-20" Style="overflow-y: auto; height: 100%;">
    <MudGrid Spacing="2">
        <!-- Search and Filter Bar -->
        <MudItem xs="12">
            <MudPaper Elevation="0" Class="d-flex gap-2 align-center pa-2 mud-background-gray rounded-lg">
                <MudTextField @bind-Value="searchQuery" Placeholder="Buscar por nome, código ou categoria..."
                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                    Class="flex-grow-1" Clearable="true" OnClearButtonClick="ClearSearch" Margin="Margin.Dense"
                    UserAttributes="@(new Dictionary<string, object> { { "id", "search-input" } })" />

                <div class="d-flex gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                        Color="@(showFilters ? Color.Primary : Color.Default)" OnClick="ToggleFilters" title="Filtros" />

                    <MudIconButton Icon="@Icons.Material.Filled.Sync"
                        Color="@(isSyncing ? Color.Warning : Color.Primary)" 
                        OnClick="@(() => SyncPendingItems(false))" 
                        Disabled="@isSyncing"
                        title="@(isSyncing ? "Sincronizando..." : "Sincronizar")" />

                    <MudIconButton
                        Icon="@(viewMode == "grid" ? Icons.Material.Filled.GridView : Icons.Material.Filled.ViewList)"
                        Color="@(viewMode == "grid" ? Color.Primary : Color.Default)" OnClick="ToggleViewMode"
                        title="Alternar Visualização" />
                </div>
            </MudPaper>
        </MudItem>

        <!-- Filter Panel -->
        @if (showFilters)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Categoria</MudText>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var category in categories)
                                {
                                    <MudChip T="string" Color="@(selectedCategory == category ? Color.Primary : Color.Default)"
                                        OnClick="() => SelectCategory(category)"
                                        Variant="@(selectedCategory == category ? Variant.Filled : Variant.Outlined)">
                                        @category
                                    </MudChip>
                                }
                            </div>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" @bind-Value="SortOrderProperty" Label="Ordenar por" Variant="Variant.Outlined"
                                AnchorOrigin="Origin.BottomCenter" Margin="Margin.Dense" Dense="true"
                                UserAttributes="@(new Dictionary<string, object> { { "id", "sort-select" } })">
                                <MudSelectItem Value="@("newest")">Mais recentes</MudSelectItem>
                                <MudSelectItem Value="@("oldest")">Mais antigos</MudSelectItem>
                                <MudSelectItem Value="@("name-asc")">Nome (A-Z)</MudSelectItem>
                                <MudSelectItem Value="@("name-desc")">Nome (Z-A)</MudSelectItem>
                                <MudSelectItem Value="@("code-asc")">Código (A-Z)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }

        @if (isLoading)
        {
            <MudItem xs="12" Class="d-flex justify-center my-16">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </MudItem>
        }
        else if (!filteredItems.Any())
        {
            <MudItem xs="12" Class="d-flex flex-column align-center my-16">
                <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Large" Color="Color.Default"
                    Style="font-size: 6rem; opacity: 0.1;" />
                <MudText Typo="Typo.h5" Class="mt-4">Nenhum item encontrado</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Tente mudar os filtros ou capture novos itens.</MudText>
            </MudItem>
        }
        else
        {
            @foreach (var item in pagedItems)
            {
                <MudItem Class="inventory-grid-item" xs="12" sm="@(viewMode == "list" ? 12 : 6)" md="@(viewMode == "list" ? 12 : 6)"
                    lg="@(viewMode == "list" ? 12 : 6)">
                    <ItemCard Item="item" OnView="NavigateToItemCallback" IsListView="@(viewMode == "list")" />
                </MudItem>
            }

            @if (totalPages > 1)
            {
                <MudItem xs="12" Class="d-flex justify-center align-center gap-4 my-8">
                    <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == 1)" OnClick="PrevPage"
                        StartIcon="@Icons.Material.Filled.ChevronLeft">Anterior</MudButton>
                    <MudText Typo="Typo.body2">Página @currentPage de @totalPages</MudText>
                    <MudButton Variant="Variant.Outlined" Disabled="@(currentPage == totalPages)" OnClick="NextPage"
                        EndIcon="@Icons.Material.Filled.ChevronRight">Próxima</MudButton>
                </MudItem>
            }
        }
    </MudGrid>
</MudContainer>

@code {
    private List<InventoryItem> items = new();
    private string searchQuery = "";
    private string selectedCategory = "Todas";
    private string sortOrder = "newest";
    private string viewMode = "list";
    private bool showFilters = false;
    private bool isLoading = true;
    private bool isSyncing = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 12;

    private readonly string[] categories = { "Todas", "Móveis", "Eletrônicos", "Equipamentos", "Ferramentas", "Materiais",
"Outros" };

    // Property binding for Sort Order to handle page reset
    private string SortOrderProperty
    {
        get => sortOrder;
        set
        {
            if (sortOrder != value)
            {
                sortOrder = value;
                currentPage = 1;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#home-container");
                
                // Tenta sincronizar automaticamente ao carregar (mas sem bloquear UI ou forçar re-upload agressivo)
                _ = SyncPendingItems(autoSync: true);
            }
            catch { /* Log or handle JS interop errors if necessary */ }
        }
    }

    private async Task SyncPendingItems(bool autoSync = false)
    {
        if (isSyncing) return;
        
        // Se for autoSync, não bloqueamos UI com loading global, apenas processamos
        if (!autoSync) 
        {
            isSyncing = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            var username = user?.UsuarioNome ?? "unknown";

            // CORREÇÃO OTIMIZADA: Buscar apenas IDs dos itens pendentes para evitar carregar fotos pesadas
            // Usa índice 'synced' (false = 0)
            List<string> pendingIds = new();
            try {
                pendingIds = await DbService.GetAllKeysFromIndexAsync<string>("items", "synced", 0);
            }
            catch {
                 // Fallback: se índice não existir
                 Console.WriteLine("Fallback sync: buscando todos os itens (lento)");
                 var allItems = await DbService.GetAllAsync<InventoryItem>("items");
                 if (allItems != null)
                    pendingIds = allItems.Where(i => !i.Synced).Select(i => i.Id).ToList();
            }

            if (!pendingIds.Any()) 
            {
                if (!autoSync) isSyncing = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
            
            bool stateChanged = false;

            // Processa um por um para economizar memória
            foreach (var id in pendingIds)
            {
                // Carrega o item completo (com fotos)
                var item = await DbService.GetAsync<InventoryItem>("items", id);
                
                // Filtra usuário
                if (item == null || item.CreatedBy != username) continue;
                if (item.Synced) continue;

                bool itemSyncSuccess = false;

                // 1. Verifica se já existe no S3 (evita re-upload desnecessário)
                bool exists = await AwsService.ItemExistsInS3Async(item.Id);
                
                if (exists)
                {
                    itemSyncSuccess = true;
                }
                else
                {
                    // 2. Se não existe, tenta fazer o upload
                    
                    // A. Upload da Foto (se houver)
                    bool photoSuccess = true;
                    if (item.Photos != null && item.Photos.Any())
                    {
                        var firstPhoto = item.Photos.FirstOrDefault();
                        if (!string.IsNullOrEmpty(firstPhoto))
                        {
                            var (success, url) = await AwsService.UploadPhotoAsync(item.Id, item.Code, firstPhoto);
                            if (success && !string.IsNullOrEmpty(url))
                            {
                                if (item.RemoteUrls == null) item.RemoteUrls = new List<string>();
                                if (!item.RemoteUrls.Contains(url))
                                {
                                    item.RemoteUrls.Add(url);
                                }
                            }
                            else
                            {
                                photoSuccess = false;
                                Console.WriteLine($"Falha ao enviar foto do item {item.Name}");
                            }
                        }
                    }

                    // B. Upload dos Metadados (apenas se foto ok ou se não tiver foto)
                    if (photoSuccess)
                    {
                        var metadata = ItemMetadata.FromInventoryItem(item, username);
                        var (metaSuccess, _) = await AwsService.UploadMetadataAsync(item.Id, metadata);
                        
                        if (metaSuccess)
                        {
                            itemSyncSuccess = true;
                        }
                        else
                        {
                             Console.WriteLine($"Falha ao enviar metadados do item {item.Name}");
                        }
                    }
                }

                // 3. Atualiza estado local se sucesso (seja por já existir ou por upload novo)
                if (itemSyncSuccess)
                {
                    // Tenta garantir que temos a URL remota para exibição
                    var imageUrl = await AwsService.GetItemImageUrlAsync(item);
                    if (!string.IsNullOrEmpty(imageUrl))
                    {
                        if (item.RemoteUrls == null) item.RemoteUrls = new List<string>();
                        if (!item.RemoteUrls.Contains(imageUrl))
                        {
                            item.RemoteUrls.Add(imageUrl);
                        }
                    }

                    item.Synced = true;
                    // item.Photos = new List<string>(); // MANTÉM fotos locais
                    
                    await DbService.UpdateAsync("items", item);
                    stateChanged = true;
                }
            }

            if (stateChanged)
            {
                // Atualiza contadores globais
                if (user != null)
                {
                    // Como não temos 'synced' E 'createdBy' juntos, é difícil contar pendentes sem carregar.
                    // Ignora contagem precisa por enquanto para evitar lentidão
                }
                
                // Recarrega lista para refletir status
                await LoadItems(); 
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro na sincronização: {ex.Message}");
        }
        finally
        {
            isSyncing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Mantendo compatibilidade com o nome antigo caso algum outro componente chame, mas redirecionando
    private async Task CheckRemoteSyncStatus() => await SyncPendingItems();

    protected override async Task OnInitializedAsync()
    {
        appState.OnChange += HandleStateChange;
        await LoadItems();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (appState.CurrentUO?.IdUO != null)
            {
                // Aqui ainda usamos GetItemsByUOAsync que carrega tudo.
                // Se o usuário tiver muitos itens, isso será lento.
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                
                // Filtra apenas os itens criados pelo usuário atual
                items = allItems.Where(i => i.CreatedBy == user.UsuarioNome).ToList();

                // If no items, load example item
                if (!items.Any())
                {
                    await LoadExampleItem(appState.CurrentUO.IdUO, user.UsuarioNome);
                    allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                    items = allItems.Where(i => i.CreatedBy == user.UsuarioNome).ToList();
                }
            }
            else
            {
                items = new List<InventoryItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading items: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExampleItem(string idUO, string username)
    {
        try
        {
            var json = await HttpClient.GetStringAsync("sample-data/exemplo-item.json");
            var exampleItem = System.Text.Json.JsonSerializer.Deserialize<InventoryItem>(json);
            if (exampleItem != null)
            {
                exampleItem.IdOrgao = appState.CurrentOrgao?.IdOrgao;
                exampleItem.IdUO = idUO;
                exampleItem.IdArea = appState.CurrentArea?.IdArea;
                exampleItem.IdSubarea = appState.CurrentSubarea?.IdSubarea;
                exampleItem.CreatedBy = username; // Define o criador
                await DbService.AddAsync("items", exampleItem);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading example item: " + ex.Message);
        }
    }

    private void ToggleFilters() => showFilters = !showFilters;
    private void ToggleViewMode() => viewMode = viewMode == "grid" ? "list" : "grid";
    private void ClearSearch() => searchQuery = "";

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        currentPage = 1;
    }

    private IEnumerable<InventoryItem> filteredItems
    {
        get
        {
            var result = items.AsEnumerable();

            if (selectedCategory != "Todas")
            {
                result = result.Where(i => i.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                result = result.Where(i =>
                i.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Code.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                i.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                );
            }

            result = sortOrder switch
            {
                "oldest" => result.OrderBy(i => i.Timestamp),
                "name-asc" => result.OrderBy(i => i.Name),
                "name-desc" => result.OrderByDescending(i => i.Name),
                "code-asc" => result.OrderBy(i => i.Code),
                _ => result.OrderByDescending(i => i.Timestamp)
            };

            return result;
        }
    }

    private int totalPages => (int)Math.Ceiling((double)filteredItems.Count() / pageSize);
    private IEnumerable<InventoryItem> pagedItems => filteredItems.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private void NavigateToItemCallback(InventoryItem item)
    {
        Navigation.NavigateTo($"/item/{item.Id}");
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}