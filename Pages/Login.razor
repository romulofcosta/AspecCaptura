@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState appState
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic

<PageTitle>Login - ASPEC Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-start pa-0">
    <MudPaper id="login-card" Elevation="4" Class="@($"pa-8 pa-sm-10 rounded-lg premium-card w-100 mb-8 {loginContentClass}")"
        Style="max-width: 440px;">
        <div class="d-flex flex-column align-center mb-6">
            <div class="d-flex justify-center mb-4">
                <MudImage Src="images/aspec_logo.png" Alt="ASPEC Logo"
                    Style="width: 100px; height: 100px; object-fit: contain; border-radius: 12px;"
                    Class="logo-hover shadow-sm" />
            </div>
            <div class="d-flex justify-center mb-2">
                <h1 class="app-title-login">Aspec Capture</h1>
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true" Class="font-weight-bold">Bem-vindo
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">Faça login para continuar</MudText>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <MudAlert Severity="@(alertType == "success" ? Severity.Success : Severity.Error)" Class="mb-4">
                @alertMessage
            </MudAlert>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudGrid Spacing="1">
                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Usuário</MudText>
                    <MudTextField @bind-Value="loginModel.Usuario" Placeholder="Digite seu usuário (ex: CE305.joao.silva)"
                        Variant="Variant.Outlined" InputType="InputType.Text" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Person" For="@(() => loginModel.Usuario)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Senha</MudText>
                    <MudTextField @bind-Value="loginModel.Senha" Placeholder="Digite sua senha"
                        Variant="Variant.Outlined" InputType="InputType.Password" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Lock" For="@(() => loginModel.Senha)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                        FullWidth="true" Disabled="@isLoading" Size="Size.Large" Class="mt-2 py-3 shadow-md">
                        @if (isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Entrando...</span>
                        }
                        else
                        {
                            <span>Entrar</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>


    </MudPaper>

    <div class="d-flex justify-center mt-4">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="version-indicator">Versão: v0.2.2 (Session Fix)</MudText>
    </div>
</MudContainer>

@if (showLoadingOverlay)
{
    <div class="loading-overlay show">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
        <MudText Color="Color.Primary" Typo="Typo.h6">@loadingMessage</MudText>
    </div>
}

@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool showLoadingOverlay = false;
    private string loadingMessage = "Entrando...";
    private string loginContentClass = "fade-in";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#login-card");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch { }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;
        loadingMessage = "Entrando...";
        showLoadingOverlay = true;
        StateHasChanged();

        try
        {
            var user = await AuthService.LoginAsync(loginModel.Usuario, loginModel.Senha);
            if (user != null)
            {
                alertMessage = "Login realizado com sucesso!";
                alertType = "success";
                loadingMessage = "Redirecionando...";
                loginContentClass = "fade-out";
                StateHasChanged();
                await Task.Delay(1000);
                Navigation.NavigateTo("/tombamentos-sync");
            }
            else
            {
                alertMessage = "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception)
        {
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            showLoadingOverlay = false;
            isLoading = false;
            StateHasChanged();
        }
    }

    public class LoginModel : IValidatableObject
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Usuario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Senha { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var cleanUsername = Usuario?.Trim().ToLower();
            if (!string.IsNullOrEmpty(cleanUsername) && cleanUsername != "admin" && !cleanUsername.Contains("."))
            {
                yield return new ValidationResult("Formato de usuário inválido (use PREFIXO.nome)", new[] { nameof(Usuario) });
            }
        }
    }
}
