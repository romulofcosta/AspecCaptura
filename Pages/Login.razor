        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .login-footer {
        width: 100%;
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 8px;
    }

    .version-text {
        font-size: 10px;
        color: var(--color-text-secondary);
        opacity: 0.6;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .dot.online {
        background-color: #10B981;
        box-shadow: 0 0 8px #10B981;
    }

    .status-text {
        font-size: 10px;
        font-weight: var(--font-weight-bold);
        color: var(--color-text-primary);
    }

    .input-field {
        color: #1e293b;
    }

    /* Loading Workflow Styles */
    .loading-workflow {
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
    }

    .progress-card {
        background: white;
        width: 100%;
        padding: 32px;
        border-radius: var(--radius-card);
        border: 1px solid var(--color-border);
    }

    .progress-title {
        font-size: var(--font-size-title-md);
        color: var(--color-primary);
        margin-bottom: 24px;
        font-weight: var(--font-weight-bold);
    }

    .progress-bar-container {
        width: 100%;
        height: 8px;
        background-color: #EDF2F7;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 32px;
    }

    .progress-bar-fill {
        height: 100%;
        background-color: var(--color-primary);
        transition: width 0.3s ease;
    }

    .loading-steps {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .loading-step {
