@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Login - ASPEC Inventory</PageTitle>

<FluentButton Class="theme-toggle" @onclick="ToggleTheme" aria-label="Alternar tema">
    <span>
        @if (isDarkMode)
        {
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path
                    d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
        }
    </span>
</FluentButton>

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="6" width="16" height="14" rx="3" />
                <path d="M4 10h16" />
            </svg>
        </div>
        <h1 class="auth-title">Bem-vindo</h1>
        <p class="auth-subtitle">Faça login para continuar</p>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="auth-alert @alertType show">@alertMessage</div>
    }

    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <FluentLabel For="login-username">E-mail</FluentLabel>
            <FluentTextField Id="login-username" @bind-Value="loginModel.Username"
                Placeholder="Digite seu e-mail" />
            <ValidationMessage For="@(() => loginModel.Username)" />
        </div>

        <div class="form-group">
            <FluentLabel For="login-password">Senha</FluentLabel>
            <FluentTextField Type="TextFieldType.Password" Id="login-password" @bind-Value="loginModel.Password"
                Placeholder="Digite sua senha" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>

        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Disabled="@isLoading">
            @(isLoading ? "Entrando..." : "Entrar")
        </FluentButton>
    </EditForm>

    <div class="auth-toggle">
        <span>Não tem conta?</span>
        <a href="/register" class="auth-toggle-link">Cadastre-se</a>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool isDarkMode = false;

    protected override async Task OnInitializedAsync()
    {
        var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
        isDarkMode = theme == "dark";
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;

        try
        {
            var user = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            if (user != null)
            {
                alertMessage = "Login realizado com sucesso!";
                alertType = "success";
                await Task.Delay(1000);
                Navigation.NavigateTo("/home");
            }
            else
            {
                alertMessage = "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception ex)
        {
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("appInterop.setTheme", isDarkMode ? "dark" : "light");
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Password { get; set; } = string.Empty;
    }
}
