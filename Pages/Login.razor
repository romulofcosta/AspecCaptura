@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState appState

<PageTitle>Login - ASPEC Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center auth-container"
    Style="min-height: 100vh;">
    <MudCard Elevation="0" Class="pa-10 premium-card" Style="width: 100%; max-width: 440px;">
        <MudCardHeader Class="d-flex flex-column align-center pb-0">
            <CardHeaderContent>
                <div class="d-flex justify-center mb-2">
                    <MudImage Src="images/aspec_logo.png" Alt="ASPEC Logo"
                        Style="width: 120px; height: 120px; object-fit: contain; border-radius: 16px; transition: transform 0.3s ease-in-out;"
                        Class="logo-hover shadow-sm" />
                </div>
                <div class="d-flex justify-center mb-4">
                    <h1 class="app-title-login">Aspec Capture</h1>
                </div>
                <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true"><b>Bem-vindo</b></MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">Faça login para continuar
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrEmpty(alertMessage))
            {
                <MudAlert Severity="@(alertType == "success" ? Severity.Success : Severity.Error)" Class="mb-4">
                    @alertMessage
                </MudAlert>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="loginModel.Username" Label="E-mail" Placeholder="Digite seu e-mail"
                    Variant="Variant.Outlined" InputType="InputType.Email" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Email" For="@(() => loginModel.Username)"
                    Class="mb-6 label-fix" />

                <MudTextField @bind-Value="loginModel.Password" Label="Senha" Placeholder="Digite sua senha"
                    Variant="Variant.Outlined" InputType="InputType.Password" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Lock" For="@(() => loginModel.Password)"
                    Class="mb-6 label-fix" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                    FullWidth="true" Disabled="@isLoading" Size="Size.Large" Class="mt-2 py-4 shadow-md">
                    @(isLoading ? "Entrando..." : "Entrar")
                </MudButton>
            </EditForm>
        </MudCardContent>

        <MudCardActions Class="d-flex justify-center pb-4">
            <MudText Typo="Typo.body2" Class="mr-2">Não tem conta?</MudText>
            <MudLink Href="/register" Underline="Underline.Hover">Cadastre-se</MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch { }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;

        try
        {
            var user = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            if (user != null)
            {
                alertMessage = "Login realizado com sucesso!";
                alertType = "success";
                await Task.Delay(1000);
                Navigation.NavigateTo("/home");
            }
            else
            {
                alertMessage = "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception)
        {
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Password { get; set; } = string.Empty;
    }
}
