@page "/login"
@layout AuthMinimalLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState appState
@inject ILogger<Login> Logger
@using System.ComponentModel.DataAnnotations
@using MudBlazor

<PageTitle>Login - Aspec Captura</PageTitle>

<div class="auth-card">
    <!-- Logo e Título -->
    <div class="app-logo">
        <MudImage Src="images/aspec_logo.png" Alt="Aspec Logo" 
                  Style="width: 64px; height: 64px; border-radius: 12px; object-fit: contain;" />
    </div>
    
    <h1 class="app-title">Aspec Captura</h1>
    <p class="app-subtitle">Inventário Patrimonial</p>
    
    <!-- Alerta de Erro/Sucesso -->
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert-minimal @(alertType == "success" ? "alert-success" : "alert-error")">
            @alertMessage
        </div>
    }
    
    <!-- Formulário -->
    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        
        <div class="form-group">
            <label class="form-label">LOGIN</label>
            <input class="form-input" 
                   type="text" 
                   placeholder="Usuário" 
                   @bind="loginModel.Usuario" 
                   disabled="@isLoading" />
            <ValidationMessage For="@(() => loginModel.Usuario)" />
        </div>
        
        <div class="form-group">
            <label class="form-label">SENHA</label>
            <div style="position: relative;">
                <input class="form-input" 
                       type="@(showPassword ? "text" : "password")" 
                       placeholder="••••••••" 
                       @bind="loginModel.Senha" 
                       disabled="@isLoading"
                       style="padding-right: 48px;" />
                <button type="button" 
                        @onclick="TogglePasswordVisibility"
                        style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 8px; color: #94A3B8;">
                    <MudIcon Icon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" 
                             Size="Size.Small" />
                </button>
            </div>
            <ValidationMessage For="@(() => loginModel.Senha)" />
        </div>
        
        <button type="submit" class="btn-login" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="loading-spinner"></span>
                <span>Entrando...</span>
            }
            else
            {
                <span>Entrar</span>
            }
        </button>
    </EditForm>
    
    <!-- Links de Ajuda -->
    <div class="auth-links">
        <a href="#" class="auth-link" @onclick:preventDefault="true" @onclick="ShowForgotPassword">
            Esqueceu a senha?
        </a>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("Login page initialized");
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
            Logger.LogInformation($"Theme loaded: {theme}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error loading theme, using default");
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        Logger.LogDebug($"Password visibility toggled: {showPassword}");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;
        StateHasChanged();

        try
        {
            Logger.LogInformation($"Login attempt for user: {loginModel.Usuario}");
            
            var result = await AuthService.LoginAsync(loginModel.Usuario, loginModel.Senha);
            
            if (result.Success && result.User != null)
            {
                Logger.LogInformation($"Login successful for user: {loginModel.Usuario}");
                alertMessage = "Login realizado com sucesso!";
                alertType = "success";
                StateHasChanged();
                await Task.Delay(1000);
                Navigation.NavigateTo("/configuracao-sessao");
            }
            else
            {
                Logger.LogWarning($"Login failed for user: {loginModel.Usuario}. Error: {result.ErrorMessage}");
                alertMessage = result.ErrorMessage ?? "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Login exception for user: {loginModel.Usuario}");
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowForgotPassword()
    {
        Logger.LogInformation("Forgot password requested");
        await JSRuntime.InvokeVoidAsync("alert", "Funcionalidade 'Esqueceu a senha' será implementada em breve.");
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Campo obrigatório")]
        public string Usuario { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        public string Senha { get; set; } = string.Empty;
    }
}
