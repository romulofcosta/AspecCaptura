    .loading-step.completed { color: var(--color-success); }
    .loading-step.pending { color: var(--color-text-secondary); }

    .loading-step .material-symbols-outlined {
        font-size: 20px;
    }
</style>


@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool isPostLoginLoading = false;
    private int loadProgress = 0;
    private List<LoadingStep> loadingSteps = new()
    {
        new LoadingStep { Label = "Autenticando sessão...", IsCompleted = false },
        new LoadingStep { Label = "Buscando dados do município...", IsCompleted = false },
        new LoadingStep { Label = "Sincronizando base de bens...", IsCompleted = false },
        new LoadingStep { Label = "Finalizando configuração...", IsCompleted = false }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("Login page initialized");
            // Basic initialization
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during initialization");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;
        StateHasChanged();

        try
        {
            Logger.LogInformation($"Login attempt for user: {loginModel.Usuario}");
            
            var result = await AuthService.LoginAsync(loginModel.Usuario, loginModel.Senha);
            
            if (result.Success && result.User != null)
            {
                Logger.LogInformation($"Login successful for user: {loginModel.Usuario}");
                isLoading = false;
                await StartPostLoginLoading();
            }
            else
            {
                Logger.LogWarning($"Login failed for user: {loginModel.Usuario}. Error: {result.ErrorMessage}");
                alertMessage = result.ErrorMessage ?? "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Login exception for user: {loginModel.Usuario}");
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task StartPostLoginLoading()
    {
        isPostLoginLoading = true;
        StateHasChanged();

        loadProgress = 10;
        StateHasChanged();
        await Task.Delay(250);
        Navigation.NavigateTo("/tombamentos-sync");
    }

    private void ShowConfig()
    {
        Logger.LogInformation("System configuration requested");
        Navigation.NavigateTo("/configuracao-sessao");
    }



    public class LoadingStep
    {
        public string Label { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Campo obrigatório")]
        public string Usuario { get; set; } = string.Empty;

        [Required(ErrorMessage = "Campo obrigatório")]
        public string Senha { get; set; } = string.Empty;
    }
}
