    }

    .alert {
        padding: 12px;
        border-radius: 8px;
        font-size: 12px;
        text-align: center;
        margin-bottom: 24px;
        font-weight: var(--font-weight-medium);
    }

    .alert.error { background-color: #FEE2E2; color: var(--color-danger); }
    .alert.success { background-color: #DCFCE7; color: var(--color-success); }

    .config-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
