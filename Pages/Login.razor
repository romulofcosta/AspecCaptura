@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject IProvisioningService ProvisioningService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AppState appState
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using pwa_camera_poc_blazor.Services.Provisioning

<PageTitle>Login - ASPEC Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-start pa-0 pb-16">
    <MudPaper id="login-card" Elevation="4" Class="@($"pa-8 pa-sm-10 rounded-lg premium-card w-100 mb-8 {loginContentClass} login-card")">
        <div class="d-flex flex-column align-center mb-6">
            <div class="d-flex justify-center mb-4">
                <MudImage Src="images/aspec_logo.png" 
                    Alt="ASPEC Logo - Sistema de Captura de Patrimônio"
                    Class="logo-hover shadow-sm login-logo"
                    Width="64"
                    Height="64"
                    Loading="eager"
                    fetchpriority="high" />
            </div>
            <div class="d-flex justify-center mb-2">
                <h1 class="app-title-login">Aspec Capture</h1>
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true" Class="font-weight-bold">Bem-vindo
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">Faça login para continuar</MudText>
        </div>

        @if (!string.IsNullOrEmpty(alertMessage))
        {
            <MudAlert Severity="@(alertType == "success" ? Severity.Success : Severity.Error)" Class="mb-4">
                @alertMessage
            </MudAlert>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudGrid Spacing="1">
                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">E-mail ou Usuário</MudText>
                    <MudTextField @bind-Value="loginModel.Username" Placeholder="Digite seu e-mail"
                        Variant="Variant.Outlined" InputType="InputType.Text" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Person" For="@(() => loginModel.Username)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12" Class="pb-4">
                    <MudText Typo="Typo.caption" Class="mb-1 ml-1" Color="Color.Secondary">Senha</MudText>
                    <MudTextField @bind-Value="loginModel.Password" Placeholder="Digite sua senha"
                        Variant="Variant.Outlined" InputType="InputType.Password" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Lock" For="@(() => loginModel.Password)"
                        FullWidth="true" Class="mb-2" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                        FullWidth="true" Disabled="@isLoading" Size="Size.Large" Class="ms-n1 login-submit-btn shadow-md">
                        @if (isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">Entrando...</span>
                        }
                        else
                        {
                            <span>Entrar</span>
                        }
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>

        <div class="d-flex justify-center mt-6">
            <MudText Typo="Typo.body2" Class="mr-2">Não tem conta?</MudText>
            <MudLink Href="/register" Underline="Underline.Hover">Cadastre-se</MudLink>
        </div>
    </MudPaper>

    <div class="d-flex justify-center mt-4">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="version-indicator">Versão: v1.5.0 (UI/UX Overhaul - Footer Fix & MudSelect Upgrade)</MudText>
    </div>
</MudContainer>

<LoadingOverlay IsVisible="@showLoadingOverlay" Message="@loadingMessage" />

@code {
    private LoginModel loginModel = new();
    private string? alertMessage;
    private string? alertType;
    private bool isLoading = false;
    private bool showLoadingOverlay = false;
    private string loadingMessage = "Entrando...";
    private string loginContentClass = "fade-in";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("appInterop.checkOverflow", "#login-card");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("appInterop.getTheme");
            appState.IsDarkMode = theme == "dark";
        }
        catch { }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        alertMessage = null;
        loadingMessage = "Entrando...";
        showLoadingOverlay = true;
        StateHasChanged();

        try
        {
            var user = await AuthService.AutenticarAsync(loginModel.Username, loginModel.Password);
            if (user != null)
            {
                alertMessage = "Login realizado com sucesso!";
                alertType = "success";
                
                // v1.5.0: Sync users and inventory after authentication
                loadingMessage = "Sincronizando dados...";
                StateHasChanged();
                
                try
                {
                    var ugId = user.UnidadeGestoraAtualId ?? 1;
                    await AuthService.SincronizarUsuariosUGAsync(ugId, ProvisioningService);
                    var cargaItems = await ProvisioningService.DownloadInventarioCargaAsync(ugId);
                    await ProvisioningService.SincronizarInventarioLocalAsync(cargaItems);
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"[Login] Provisioning error (non-fatal): {ex.Message}");
                    // Non-fatal: continue to home even if provisioning fails
                }
                
                loadingMessage = "Redirecionando...";
                loginContentClass = "fade-out";
                StateHasChanged();
                await Task.Delay(1000);
                Navigation.NavigateTo("/home");
            }
            else
            {
                alertMessage = "Usuário ou senha inválidos.";
                alertType = "error";
            }
        }
        catch (Exception)
        {
            alertMessage = "Erro ao realizar login. Verifique suas credenciais e tente novamente.";
            alertType = "error";
        }
        finally
        {
            showLoadingOverlay = false;
            isLoading = false;
            StateHasChanged();
        }
    }

    public class LoginModel : IValidatableObject
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Campo obrigatório")]
        public string Password { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var cleanUsername = Username?.Trim().ToLower();
            if (!string.IsNullOrEmpty(cleanUsername) && cleanUsername != "admin")
            {
                var emailAttribute = new System.ComponentModel.DataAnnotations.EmailAddressAttribute();
                if (!emailAttribute.IsValid(Username))
                {
                    yield return new ValidationResult("Formato de e-mail inválido", new[] { nameof(Username) });
                }
            }
        }
    }
}
