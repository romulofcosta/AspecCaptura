@page "/configuracao-sessao"
@using pwa_camera_poc_blazor.Components.Forms
@inject IAuthService AuthService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout AuthMinimalLayout

<PageTitle>Configuração de Sessão - Aspec Captura</PageTitle>

<div class="config-page">
    <div class="config-header">
        <div class="powered-by">
            <div class="avatar-icon">
                <span class="material-symbols-outlined">account_circle</span>
            </div>
            <div class="powered-text">
                <span class="powered-label">POWERED BY</span>
                <span class="powered-brand">Aspec Avatar</span>
            </div>
        </div>
        <h1 class="config-title">Configuração</h1>
        <p class="config-subtitle">Configure o fluxo da sua sessão de inventário.</p>
    </div>

    <div class="config-form">
        @* Órgão *@
        <div class="form-group">
            <label class="input-label">ÓRGÃO</label>
            <div class="select-wrapper">
                <select class="input-field" @onchange="OnOrgaoSelectChanged">
                    <option value="" disabled selected="@(string.IsNullOrEmpty(SelectedOrgaoId))">Selecione o órgão</option>
                    @if (_usuario != null)
                    {
                        @foreach (var orgao in GetOrgaosFiltered())
                        {
                            <option value="@orgao.IdOrgao" selected="@(SelectedOrgaoId == orgao.IdOrgao)">@orgao.NomeOrgao</option>
                        }
                    }
                </select>
                <span class="material-symbols-outlined select-icon">expand_more</span>
            </div>
        </div>

        @* Unidade *@
        <div class="form-group">
            <label class="input-label">UNIDADE</label>
            <div class="select-wrapper">
                <select class="input-field" @onchange="OnUOSelectChanged" disabled="@(string.IsNullOrEmpty(SelectedOrgaoId))">
                    <option value="" disabled selected="@(string.IsNullOrEmpty(SelectedUOId))">Selecione a unidade</option>
                    @foreach (var uo in GetUOsFiltered())
                    {
                        <option value="@uo.IdUO" selected="@(SelectedUOId == uo.IdUO)">@uo.NomeUO</option>
                    }
                </select>
                <span class="material-symbols-outlined select-icon">expand_more</span>
            </div>
        </div>

        @* Área *@
        <div class="form-group">
            <label class="input-label">ÁREA</label>
            <div class="select-wrapper">
                <select class="input-field" @onchange="OnAreaSelectChanged" disabled="@(string.IsNullOrEmpty(SelectedUOId))">
                    <option value="" disabled selected="@(string.IsNullOrEmpty(SelectedAreaId))">Selecione a área</option>
                    @foreach (var area in GetAreasFiltered())
                    {
                        <option value="@area.IdArea" selected="@(SelectedAreaId == area.IdArea)">@area.NomeArea</option>
                    }
                </select>
                <span class="material-symbols-outlined select-icon">expand_more</span>
            </div>
        </div>

        @* Subárea *@
        <div class="form-group">
            <label class="input-label">SUBÁREA</label>
            <div class="select-wrapper">
                <select class="input-field" @onchange="OnSubareaSelectChanged" disabled="@(string.IsNullOrEmpty(SelectedAreaId))">
                    <option value="" disabled selected="@(string.IsNullOrEmpty(SelectedSubareaId))">Selecione a subárea</option>
                    @foreach (var sub in GetSubareasFiltered())
                    {
                        <option value="@sub.IdSubarea" selected="@(SelectedSubareaId == sub.IdSubarea)">@sub.NomeSubarea</option>
                    }
                </select>
                <span class="material-symbols-outlined select-icon">expand_more</span>
            </div>
        </div>

        <p class="config-note">
            Sua localização será sincronizada automaticamente com o sistema central.
        </p>

        <button class="start-session-button" @onclick="ConfirmarSessao" disabled="@(!IsFormValid)">
            Iniciar Sessão
            <span class="material-symbols-outlined">arrow_forward</span>
        </button>
    </div>
</div>

<style>
    .config-page {
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .config-header {
        margin-top: 20px;
        margin-bottom: 40px;
    }

    .powered-by {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 32px;
        background: #F8FAFC;
        padding: 8px 16px;
        border-radius: 12px;
        width: fit-content;
    }

    .avatar-icon {
        color: #1E3A5F;
    }

    .powered-text {
        display: flex;
        flex-direction: column;
    }

    .powered-label {
        font-size: 8px;
        font-weight: 700;
        color: #94A3B8;
        letter-spacing: 0.05em;
    }

    .powered-brand {
        font-size: 14px;
        font-weight: 700;
        color: #1E3A5F;
    }

    .config-title {
        font-size: 28px;
        font-weight: 700;
        color: #1E293B;
        margin: 0 0 8px;
    }

    .config-subtitle {
        font-size: 14px;
        color: #94A3B8;
        margin: 0;
    }

    .config-form {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .input-label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        color: #94A3B8;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .select-wrapper {
        position: relative;
    }

    .input-field {
        width: 100%;
        padding: 14px 16px;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        font-size: 14px;
        color: #1E293B;
        appearance: none;
        cursor: pointer;
    }

    .input-field:focus {
        outline: none;
        border-color: #1E3A5F;
        box-shadow: 0 0 0 4px rgba(30, 58, 95, 0.05);
    }

    .input-field:disabled {
        background: #F8FAFC;
        cursor: not-allowed;
        color: #CBD5E1;
    }

    .select-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94A3B8;
        pointer-events: none;
    }

    .config-note {
        font-size: 12px;
        color: #CBD5E1;
        text-align: center;
        margin: 40px 0 24px;
        line-height: 1.5;
    }

    .start-session-button {
        width: 100%;
        padding: 18px;
        background: #1E293B;
        color: #FFFFFF;
        border: none;
        border-radius: 999px;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        margin-top: auto;
        margin-bottom: 20px;
    }

    .start-session-button:disabled {
        background: #CBD5E1;
        cursor: not-allowed;
    }
</style>

@code {
    private Usuario? _usuario;
    private string? SelectedOrgaoId;
    private string? SelectedUOId;
    private string? SelectedAreaId;
    private string? SelectedSubareaId;

    private void OnOrgaoSelectChanged(ChangeEventArgs e) => OnOrgaoChanged(e.Value?.ToString() ?? string.Empty);
    private void OnUOSelectChanged(ChangeEventArgs e) => OnUOChanged(e.Value?.ToString() ?? string.Empty);
    private void OnAreaSelectChanged(ChangeEventArgs e) => OnAreaChanged(e.Value?.ToString() ?? string.Empty);
    private void OnSubareaSelectChanged(ChangeEventArgs e) => OnSubareaChanged(e.Value?.ToString() ?? string.Empty);

    private bool IsFormValid => !string.IsNullOrEmpty(SelectedOrgaoId) &&
                                !string.IsNullOrEmpty(SelectedUOId) &&
                                !string.IsNullOrEmpty(SelectedAreaId) &&
                                !string.IsNullOrEmpty(SelectedSubareaId);

    protected override async Task OnInitializedAsync()
    {
        _usuario = await AuthService.GetCurrentUserAsync();
        if (_usuario == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var versionKey = $"versao:{_usuario.Prefixo?.Trim().ToUpperInvariant()}";
        var baseVersion = await DbService.GetMetadataAsync(versionKey);
        if (string.IsNullOrWhiteSpace(baseVersion))
        {
            Navigation.NavigateTo("/tombamentos-sync");
            return;
        }

        if (appState.CurrentOrgao != null)
        {
            SelectedOrgaoId = appState.CurrentOrgao.IdOrgao;
            SelectedUOId = appState.CurrentUO?.IdUO;
            SelectedAreaId = appState.CurrentArea?.IdArea;
            SelectedSubareaId = appState.CurrentSubarea?.IdSubarea;
        }
    }

    private void OnOrgaoChanged(string id)
    {
        SelectedOrgaoId = id;
        SelectedUOId = null;
        SelectedAreaId = null;
        SelectedSubareaId = null;
    }

    private void OnUOChanged(string id)
    {
        SelectedUOId = id;
        SelectedAreaId = null;
        SelectedSubareaId = null;
    }

    private void OnAreaChanged(string id)
    {
        SelectedAreaId = id;
        SelectedSubareaId = null;
    }

    private void OnSubareaChanged(string id) => SelectedSubareaId = id;

    private IEnumerable<Orgao> GetOrgaosFiltered()
    {
        if (_usuario == null) return Enumerable.Empty<Orgao>();
        return _usuario.Orgaos;
    }

    private IEnumerable<UnidadeOrcamentaria> GetUOsFiltered()
    {
        if (_usuario == null || string.IsNullOrEmpty(SelectedOrgaoId)) return Enumerable.Empty<UnidadeOrcamentaria>();
        return _usuario.Orgaos.FirstOrDefault(o => o.IdOrgao == SelectedOrgaoId)?.UnidadesOrcamentarias
               ?? Enumerable.Empty<UnidadeOrcamentaria>();
    }

    private IEnumerable<Area> GetAreasFiltered()
    {
        if (_usuario == null || string.IsNullOrEmpty(SelectedUOId)) return Enumerable.Empty<Area>();
        var orgao = _usuario.Orgaos.FirstOrDefault(o => o.IdOrgao == SelectedOrgaoId);
        return orgao?.UnidadesOrcamentarias.FirstOrDefault(u => u.IdUO == SelectedUOId)?.Areas
               ?? Enumerable.Empty<Area>();
    }

    private IEnumerable<Subarea> GetSubareasFiltered()
    {
        if (_usuario == null || string.IsNullOrEmpty(SelectedAreaId)) return Enumerable.Empty<Subarea>();
        var orgao = _usuario.Orgaos.FirstOrDefault(o => o.IdOrgao == SelectedOrgaoId);
        var uo = orgao?.UnidadesOrcamentarias.FirstOrDefault(u => u.IdUO == SelectedUOId);
        return uo?.Areas.FirstOrDefault(a => a.IdArea == SelectedAreaId)?.Subareas
               ?? Enumerable.Empty<Subarea>();
    }

    private async Task ConfirmarSessao()
    {
        if (!IsFormValid) return;

        var orgao = _usuario?.Orgaos.FirstOrDefault(o => o.IdOrgao == SelectedOrgaoId);
        var uo = orgao?.UnidadesOrcamentarias.FirstOrDefault(u => u.IdUO == SelectedUOId);
        var area = uo?.Areas.FirstOrDefault(a => a.IdArea == SelectedAreaId);
        var sub = area?.Subareas.FirstOrDefault(s => s.IdSubarea == SelectedSubareaId);

        if (orgao != null && uo != null && area != null && sub != null)
        {
            appState.CurrentOrgao = orgao;
            appState.CurrentUO = uo;
            appState.CurrentArea = area;
            appState.CurrentSubarea = sub;
            appState.UnidadeNome = uo.NomeUO;
            
            await appState.SaveStateAsync(); // Persistir a configuração da sessão
            Navigation.NavigateTo("/");
        }
    }
}
