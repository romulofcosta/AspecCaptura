@page "/sincronizacao"
@using pwa_camera_poc_blazor.Models
@using System.Text.RegularExpressions
@using System.Text
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject IJSRuntime JSRuntime
@inject AppState appState
@inject ISnackbar Snackbar
@inject IAwsStorageService AwsService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Sincronização - ASPEC Capture</PageTitle>

<MudContainer id="sync-container" MaxWidth="MaxWidth.Large" Class="mt-4 pb-20 sync-container">
    <MudText Typo="Typo.h4" Class="mb-2 font-weight-bold">Sincronização Cloud</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">Envie seus itens capturados localmente para o servidor ASPEC.</MudText>

    <MudGrid Spacing="3">
        <!-- Status Cards -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center rounded-lg">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="font-weight-bold">@pendingCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Itens Pendentes</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center rounded-lg bg-success-soft">
                <MudText Typo="Typo.h3" Color="Color.Success" Class="font-weight-bold">@syncedCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Sincronizados (Hoje)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <div class="d-flex justify-center gap-4 my-6">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                           OnClick="SincronizarTudoAsync" Disabled="@isSyncing" Class="py-3 px-8 shadow-md"
                           StartIcon="@(isSyncing ? null : Icons.Material.Filled.CloudUpload)">
                    @(isSyncing ? "Sincronizando..." : "Sincronizar Tudo Agora")
                </MudButton>
                
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" 
                           OnClick="CreateTestItem" Disabled="@isSyncing" Class="py-3 px-6">
                    Criar Item de Teste
                </MudButton>
            </div>

            @if (displayItems.Any())
            {
                    <MudCard Elevation="1" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Itens Recentes</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <MudList T="ItemPatrimonio" Dense="true" ReadOnly="true">
                            @foreach (var item in displayItems)
                            {
                                        <MudListItem @key="item.Id" Class="@($"sync-item-card mb-2 {(processingItems.ContainsKey(item.Id) && processingItems[item.Id] ? "processing" : "")}")">
                                            <div class="d-flex align-center justify-space-between py-2 px-4 width-100">
                                                <div class="d-flex flex-column">
                                                    <MudText Typo="Typo.body1" Class="font-weight-medium">@item.Nome</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Codigo  @item.Category</MudText>
                                                </div>
                                                <div class="d-flex flex-column align-end">
                                                    <MudText Typo="Typo.caption">@item.DataHora.ToString("dd/MM/yyyy HH:mm")</MudText>
                                                    @if (processingItems.ContainsKey(item.Id) && processingItems[item.Id])
                                                    {
                                                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mt-1" />
                                                    }
                                                    else if (item.Sincronizado)
                                                    {
                                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Class="mt-1" Icon="@Icons.Material.Filled.Check">Sincronizado</MudChip>
                                                    }
                                                    else
                                                    {
                                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text" Class="mt-1">Pendente</MudChip>
                                                    }
                                                </div>
                                            </div>
                                            <MudDivider />
                                        </MudListItem>
                            }
                            </MudList>
                        </MudCardContent>
                    </MudCard>
            }
            else
            {
                    <div class="sync-empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Default" Class="mb-4" Style="font-size: 3rem;" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold">Nenhum item pendente</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Capture itens com a câmera para começar a sincronizar.</MudText>
                    </div>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<ItemPatrimonio> displayItems = new();
    private int pendingCount = 0;
    private int syncedCount = 0;
    private bool isSyncing = false;
    private Dictionary<string, bool> processingItems = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarEstatisticasAsync();
    }

    private string GetItemClass(string itemId)
    {
        if (processingItems.ContainsKey(itemId) && processingItems[itemId])
        {
            return "mud-alert-text-info"; // Highlight processing item
        }
        return "";
    }

    private async Task CarregarEstatisticasAsync()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) return;

        displayItems.Clear();
        pendingCount = 0;
        syncedCount = 0;
        var today = DateTime.Today;

        try 
        {
            // Busca chaves para performance
            List<string> allKeys = new();
            try {
                // Tenta pegar todas as chaves (mais leve)
                allKeys = await DbService.GetAllKeysAsync<string>("items");
            }
            catch {
                // Fallback: carregar tudo se não tiver GetAllKeys (não deve acontecer com db v3)
                var allItems = await DbService.GetAllAsync<ItemPatrimonio>("items");
                if (allItems != null) 
                {
                    // Se carregou tudo, já filtra aqui
                    var userItems = allItems.Where(i => i.CriadoPor == currentUser.NomeUsuario).ToList();
                    
                    // Display: Pendentes OU Criados Hoje
                    displayItems = userItems.Where(i => !i.Sincronizado || i.DataHora.Date == today)
                                          .OrderByDescending(i => i.DataHora)
                                          .ToList();
                    
                    pendingCount = userItems.Count(i => !i.Sincronizado);
                    syncedCount = userItems.Count(i => i.Sincronizado && i.DataHora.Date == today);
                    appState.PendingSyncCount = pendingCount;
                    return;
                }
            }

            // Se usou Keys, carrega itens relevantes um a um
            foreach (var id in allKeys)
            {
                var item = await DbService.GetAsync<ItemPatrimonio>("items", id);
                if (item != null && item.CriadoPor == currentUser.NomeUsuario)
                {
                    bool isPending = !item.Sincronizado;
                    bool isToday = item.DataHora.Date == today;

                    if (isPending) pendingCount++;
                    if (item.Sincronizado && isToday) syncedCount++;

                    if (isPending || isToday)
                    {
                        displayItems.Add(item);
                    }
                }
            }
            
            // Ordena memória
            displayItems = displayItems.OrderByDescending(i => i.DataHora).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao carregar stats: " + ex.Message);
        }

        appState.PendingSyncCount = pendingCount;
    }

    private async Task CreateTestItem()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) 
        {
            Snackbar.Add("Você precisa estar logado para criar um item.", Severity.Warning);
            return;
        }

        var testItem = new ItemPatrimonio
        {
            Nome = "Item de Teste " + DateTime.Now.ToString("HH:mm:ss"),
            Codigo = "TEST-" + new Random().Next(1000, 9999),
            Category = "Teste",
            Localizacao = "Laboratório",
            Observacoes = "Item criado para teste de sincronização",
            Status = "ativo",
            DataHora = DateTime.Now,
            Sincronizado = false,
            UnidadeGestoraId = currentUser.UnidadeGestoraAtualId,
            CriadoPor = currentUser.NomeUsuario,
            Photos = new List<string> { "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=" }
        };

        await DbService.AddAsync("items", testItem);
        await CarregarEstatisticasAsync();
        Snackbar.Add("Item de teste criado!", Severity.Success);
    }

    private string SanitizeForS3(string input)
    {
        if (string.IsNullOrEmpty(input)) return "unknown";
        
        // Remove acentos
        string normalized = input.Normalize(NormalizationForm.FormD);
        StringBuilder builder = new StringBuilder();
        foreach (char c in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                builder.Append(c);
            }
        }
        string withoutAccents = builder.ToString().Normalize(NormalizationForm.FormC);

        // Remove caracteres especiais e espaços
        string sanitized = Regex.Replace(withoutAccents, @"[^a-zA-Z0-9\-_]", "");
        return sanitized.ToLowerInvariant();
    }

    private async Task SincronizarTudoAsync()
    {
        if (isSyncing) return;
        isSyncing = true;

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) throw new Exception("Usuário não autenticado.");

            // Identifica itens para sincronizar (apenas os pendentes da lista atual)
            var itemsToSync = displayItems.Where(i => !i.Sincronizado).ToList();
            
            if (!itemsToSync.Any())
            {
                Snackbar.Add("Nenhum item pendente para sincronizar.", Severity.Info);
                return;
            }

            int total = itemsToSync.Count;
            int successCount = 0;
            int current = 0;

            foreach (var item in itemsToSync)
            {
                current++;
                processingItems[item.Id] = true;
                StateHasChanged(); // Atualiza UI para mostrar spinner/border

                // Verifica se item ainda existe/é válido
                var dbItem = await DbService.GetAsync<ItemPatrimonio>("items", item.Id);
                if (dbItem == null || dbItem.Sincronizado) 
                {
                    processingItems[item.Id] = false;
                    continue;
                }

                try
                {
                    // 1. Upload da primeira foto (capa)
                    if (dbItem.Photos.Any())
                    {
                        var base64 = dbItem.Photos.First();
                        
                        var photoResult = await AwsService.UploadPhotoAsync(dbItem.Id, dbItem.Codigo, base64);

                        if (!photoResult.Success)
                        {
                            if (photoResult.Url != null && photoResult.Url.Contains("403"))
                            {
                                Snackbar.Add($"Acesso negado (403) ao enviar foto. Verifique permissões.", Severity.Error);
                            }
                            else 
                            {
                                Snackbar.Add($"Erro ao enviar foto de: {dbItem.Nome}", Severity.Error);
                            }
                            processingItems[item.Id] = false;
                            continue;
                        }
                        
                        if (!string.IsNullOrEmpty(photoResult.Url))
                        {
                            if (dbItem.RemoteUrls == null) dbItem.RemoteUrls = new List<string>();
                            if (!dbItem.RemoteUrls.Contains(photoResult.Url))
                                dbItem.RemoteUrls.Add(photoResult.Url);
                        }
                    }

                    // 2. Metadados
                    var metadata = ItemMetadata.FromItemPatrimonio(dbItem, currentUser.NomeUsuario);
                    var metadataResult = await AwsService.UploadMetadataAsync(dbItem.Id, metadata);

                    if (metadataResult.Success)
                    {
                        // 3. Sucesso - Atualiza Objeto em Memória e DB
                        dbItem.Sincronizado = true;
                        // dbItem.Photos = new List<string>(); // NÃO LIMPAR FOTOS (Persistência Visual)
                        
                        await DbService.UpdateAsync("items", dbItem);
                        
                        // Atualiza lista em memória para refletir na UI sem recarregar tudo
                        var displayItem = displayItems.FirstOrDefault(i => i.Id == item.Id);
                        if (displayItem != null)
                        {
                            displayItem.Sincronizado = true;
                            // displayItem.Photos = ... (mantem)
                        }

                        successCount++;
                        syncedCount++;
                        pendingCount--;
                        appState.PendingSyncCount = pendingCount;
                        
                        Snackbar.Add($"Item sincronizado: {dbItem.Nome}", Severity.Success);
                    }
                    else
                    {
                        Snackbar.Add($"Erro ao enviar metadados de: {dbItem.Nome}", Severity.Error);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Erro item {dbItem.Id}: {ex.Message}");
                    Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
                }
                
                processingItems[item.Id] = false;
                StateHasChanged();
                await Task.Delay(100);
            }

            if (successCount > 0)
            {
                Snackbar.Add($"{successCount} itens sincronizados com sucesso!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro crítico: " + ex.Message, Severity.Error);
        }
        finally
        {
            isSyncing = false;
            processingItems.Clear();
            await InvokeAsync(StateHasChanged);
        }
    }
}