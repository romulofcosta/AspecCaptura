@page "/sync"
@using pwa_camera_poc_blazor.Models
@inject IIndexedDbService DbService
@inject IAuthService AuthService
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@inject IJSRuntime JSRuntime
@inject AppState appState
@using pwa_camera_poc_blazor.Services.AWS
@inject IAwsStorageService AwsService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Sincronização - ASPEC Capture</PageTitle>

<MudContainer id="sync-container" MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-2 font-weight-bold">Sincronização Cloud</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">Envie seus itens capturados localmente para o servidor ASPEC.</MudText>

    <MudGrid Spacing="3">
        <!-- Status Cards -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center rounded-lg">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="font-weight-bold">@unsyncedItems.Count</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Itens Pendentes</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="1" Class="pa-6 d-flex flex-column align-center rounded-lg" Style="background: rgba(var(--mud-palette-success-rgb), 0.05);">
                <MudText Typo="Typo.h3" Color="Color.Success" Class="font-weight-bold">@syncedCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Sincronizados</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            @if (unsyncedItems.Any())
            {
                    <div class="d-flex justify-center my-6">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                                   OnClick="SyncAll" Disabled="@isSyncing" Class="py-3 px-8 shadow-md"
                                   StartIcon="@(isSyncing ? null : Icons.Material.Filled.CloudUpload)">
                        @(isSyncing ? "Sincronizando..." : "Sincronizar Tudo Agora")
                        </MudButton>
                    </div>

                    <MudCard Elevation="1" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Lista de Itens Pendentes</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <MudList T="InventoryItem" Dense="true" ReadOnly="true">
                            @foreach (var item in unsyncedItems)
                            {
                                        <MudListItem>
                                            <div class="d-flex align-center justify-space-between py-2 px-4 width-100">
                                                <div class="d-flex flex-column">
                                                    <MudText Typo="Typo.body1" Class="font-weight-medium">@item.Name</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Code • @item.Category</MudText>
                                                </div>
                                                <div class="d-flex flex-column align-end">
                                                    <MudText Typo="Typo.caption">@item.Timestamp.ToString("dd/MM/yyyy HH:mm")</MudText>
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text" Class="mt-1">Pendente</MudChip>
                                                </div>
                                            </div>
                                            <MudDivider />
                                        </MudListItem>
                            }
                            </MudList>
                        </MudCardContent>
                    </MudCard>
            }
            else
            {
                    <MudPaper Elevation="0" Class="pa-16 d-flex flex-column align-center rounded-lg mud-background-gray" Style="border: 2px dashed rgba(0,0,0,0.1);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold">Tudo em dia!</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Todos os itens capturados já estão sincronizados com a nuvem.</MudText>
                    </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<InventoryItem> unsyncedItems = new();
    private int syncedCount = 0;
    private bool isSyncing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser == null) return;

        // Carrega todos os itens do IndexedDB
        var allItems = await DbService.GetAllAsync<InventoryItem>("items");

        // Filtra apenas os itens criados pelo usuário atual
        var userItems = allItems.Where(i => i.CreatedBy == currentUser.Username).ToList();

        unsyncedItems = userItems.Where(i => !i.Synced).OrderByDescending(i => i.Timestamp).ToList();
        syncedCount = userItems.Count(i => i.Synced);
        appState.PendingSyncCount = unsyncedItems.Count;
    }

    private async Task SyncAll()
    {
        if (isSyncing) return;
        isSyncing = true;

        try
        {
            var currentUser = await AuthService.GetCurrentUserAsync();
            if (currentUser == null) throw new Exception("Usuário não autenticado.");

            // Inicializa serviço AWS com o token da sessão (se disponível)
            if (!string.IsNullOrEmpty(AuthService.AwsIdToken))
            {
                AwsService.InitializeWithToken(AuthService.AwsIdToken);
            }

            int total = unsyncedItems.Count;
            int successCount = 0;

            foreach (var (item, index) in unsyncedItems.Select((v, i) => (v, i)).ToList())
            {
                Snackbar.Add($"Sincronizando item {index + 1} de {total}: {item.Name}", Severity.Info);

                try
                {
                    // 1. Upload da primeira foto (capa) como {itemId}.jpg
                    if (item.Photos.Any())
                    {
                        var base64 = item.Photos.First();
                        var photoResult = await AwsService.UploadPhotoAsync(item.Id, base64);

                        if (!photoResult.Success)
                        {
                            Snackbar.Add($"Erro ao enviar foto de: {item.Name}", Severity.Error);
                            continue;
                        }
                    }

                    // 2. Criar metadados compatíveis com Desktop
                    var metadata = ItemMetadata.FromInventoryItem(item, currentUser.Username);

                    // 3. Upload do Metadata como {itemId}.json
                    var metadataResult = await AwsService.UploadMetadataAsync(item.Id, metadata);

                    if (metadataResult.Success)
                    {
                        // 4. Marca como sincronizado e limpa fotos locais para economizar espaço
                        item.Photos = new List<string>();
                        item.Synced = true;

                        await DbService.UpdateAsync("items", item);
                        successCount++;
                    }
                    else
                    {
                        Snackbar.Add($"Erro ao enviar metadados de: {item.Name}", Severity.Error);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Erro ao sincronizar item {item.Id}: {ex.Message}");
                    Snackbar.Add($"Erro ao sincronizar: {item.Name}", Severity.Error);
                }

                await Task.Delay(200); // UI breathing room
            }

            if (successCount > 0)
            {
                Snackbar.Add($"{successCount} itens sincronizados com sucesso!", Severity.Success);
            }

            await LoadStats();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erro durante a sincronização: " + ex.Message, Severity.Error);
            Console.WriteLine(ex);
        }
        finally
        {
            isSyncing = false;
        }
    }
}
