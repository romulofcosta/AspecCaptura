@page "/sync"
@layout pwa_camera_poc_blazor.Components.Layout.AppLayout
@using pwa_camera_poc_blazor.Models
@using System.Text.RegularExpressions
@using System.Text
@inject pwa_camera_poc_blazor.Services.Storage.IIndexedDbService DbService
@inject IAuthService AuthService
@inject IAwsStorageService AwsService
@inject NavigationManager Navigation
@inject AppState appState
@inject pwa_camera_poc_blazor.Services.ToastService ToastService
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Sincronização - Aspec Captura</PageTitle>

<div id="sync-container" class="minimal-page sync-page">
    <div class="sync-header">
        <button class="back-btn" @onclick='() => Navigation.NavigateTo("/items")'>
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <h1 class="page-title">Sincronização Cloud</h1>
    </div>
    <p class="page-subtitle">Envie seus itens capturados localmente para o servidor ASPEC.</p>

    <!-- Status Cards -->
    <div class="stats-grid">
        <div class="minimal-card stat-card">
            <h2 class="stat-value pending">@pendingCount</h2>
            <p class="stat-label">Itens Pendentes</p>
        </div>
        
        <div class="minimal-card stat-card synced-bg">
            <h2 class="stat-value synced">@syncedCount</h2>
            <p class="stat-label">Sincronizados (Hoje)</p>
        </div>
    </div>

    <div class="actions-row">
        <button class="btn-primary-minimal sync-btn" @onclick="SyncAll" disabled="@isSyncing">
            @if (!isSyncing)
            {
                <span class="material-symbols-outlined">cloud_upload</span>
            }
            else
            {
                <div class="spinner text-white"></div>
            }
            <span>@(isSyncing ? "Sincronizando..." : "Sincronizar Tudo Agora")</span>
        </button>
        
        <button class="btn-secondary-minimal" @onclick="CreateTestItem" disabled="@isSyncing">
            Criar Item de Teste
        </button>
    </div>

    @if (displayItems.Any())
    {
        <div class="minimal-card">
            <div class="card-header">
                <h3 class="card-title">Itens Recentes</h3>
            </div>
            <div class="items-list">
                @foreach (var item in displayItems)
                {
                    <div class="item-row @(processingItems.ContainsKey(item.Id) && processingItems[item.Id] ? "processing" : "")">
                        <div class="item-info">
                            <p class="item-name">@item.Name</p>
                            <p class="item-meta">@item.Code • @item.Category</p>
                        </div>
                        <div class="item-status">
                            <span class="item-timestamp">@item.Timestamp.ToString("dd/MM/yyyy HH:mm")</span>
                            @if (processingItems.ContainsKey(item.Id) && processingItems[item.Id])
                            {
                                <div class="spinner"></div>
                            }
                            else if (item.Synced)
                            {
                                <span class="status-indicator success">
                                    <span class="material-symbols-outlined">check</span>
                                    Sincronizado
                                </span>
                            }
                            else
                            {
                                <span class="status-indicator pending">
                                    Pendente
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-container">
            <span class="material-symbols-outlined empty-icon">event_note</span>
            <h3 class="empty-title">Nenhum item recente</h3>
            <p class="empty-text">Capture itens com a câmera para começar.</p>
        </div>
    }
</div>

