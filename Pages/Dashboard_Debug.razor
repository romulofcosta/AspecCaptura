@page "/dashboard-debug"
@layout MinimalLayout
@using pwa_camera_poc_blazor.Models
@inject IAuthService AuthService
@inject IIndexedDbService DbService
@inject NavigationManager Navigation
@inject AppState appState
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Dashboard Debug - Aspec Captura</PageTitle>

<div style="padding: 20px; font-family: monospace;">
    <h1>Dashboard Debug</h1>
    
    <div style="background: #f0f0f0; padding: 10px; margin: 10px 0;">
        <h3>Estado da Sessão:</h3>
        <p>CurrentOrgao: @(appState.CurrentOrgao?.NomeOrgao ?? "null")</p>
        <p>CurrentUO: @(appState.CurrentUO?.NomeUO ?? "null")</p>
        <p>CurrentArea: @(appState.CurrentArea?.NomeArea ?? "null")</p>
        <p>CurrentSubarea: @(appState.CurrentSubarea?.NomeSubarea ?? "null")</p>
        <p>IsSessionConfigured: @appState.IsSessionConfigured()</p>
        <p>EsferaAtual: @(appState.EsferaAtual ?? "null")</p>
    </div>
    
    <div style="background: #e0f0ff; padding: 10px; margin: 10px 0;">
        <h3>Estado do Carregamento:</h3>
        <p>isLoading: @isLoading</p>
        <p>items.Count: @items.Count</p>
        <p>Erro: @errorMessage</p>
    </div>
    
    <div style="background: #f0fff0; padding: 10px; margin: 10px 0;">
        <h3>Logs:</h3>
        @foreach (var log in logs)
        {
            <p>@log</p>
        }
    </div>
    
    <button @onclick="TestLoadItems" style="padding: 10px; margin: 5px;">Testar Carregamento</button>
    <button @onclick="ClearLogs" style="padding: 10px; margin: 5px;">Limpar Logs</button>
    <button @onclick="GoToConfig" style="padding: 10px; margin: 5px;">Ir para Configuração</button>
    
    @if (items.Any())
    {
        <div style="background: #fff0f0; padding: 10px; margin: 10px 0;">
            <h3>Itens Carregados:</h3>
            @foreach (var item in items.Take(5))
            {
                <p>@item.Name - @item.Code</p>
            }
        </div>
    }
</div>

@code {
    private List<InventoryItem> items = new();
    private bool isLoading = true;
    private string errorMessage = "";
    private List<string> logs = new();

    protected override async Task OnInitializedAsync()
    {
        AddLog("OnInitializedAsync iniciado");
        
        try
        {
            AddLog($"IsSessionConfigured: {appState.IsSessionConfigured()}");
            
            if (!appState.IsSessionConfigured())
            {
                AddLog("Sessão não configurada - mas continuando para debug");
                // Não redirecionar para debug
            }
            
            appState.OnChange += HandleStateChange;
            await TestLoadItems();
        }
        catch (Exception ex)
        {
            AddLog($"Erro em OnInitializedAsync: {ex.Message}");
            errorMessage = ex.Message;
        }
    }

    private async Task TestLoadItems()
    {
        AddLog("TestLoadItems iniciado");
        isLoading = true;
        errorMessage = "";
        
        try
        {
            AddLog("Obtendo usuário atual...");
            var user = await AuthService.GetCurrentUserAsync();
            AddLog($"Usuário: {user?.UsuarioNome ?? "null"}");
            
            string esfera = appState.EsferaAtual ?? user?.Esfera ?? string.Empty;
            AddLog($"Esfera: '{esfera}'");
            
            AddLog($"CurrentUO.IdUO: {appState.CurrentUO?.IdUO ?? "null"}");
            
            if (appState.CurrentUO?.IdUO != null)
            {
                AddLog("Carregando itens do banco...");
                var allItems = await DbService.GetItemsByUOAsync(appState.CurrentUO.IdUO);
                AddLog($"Itens encontrados: {allItems.Count()}");
                
                if (esfera == "A")
                {
                    items = allItems.ToList();
                    AddLog("Filtro: Todos os itens (esfera A)");
                }
                else if (!string.IsNullOrEmpty(esfera))
                {
                    items = allItems.Where(i => i.Esfera == esfera).ToList();
                    AddLog($"Filtro: Esfera '{esfera}' - {items.Count} itens");
                }
                else
                {
                    items = allItems.ToList();
                    AddLog("Filtro: Todos os itens (esfera vazia)");
                }
            }
            else
            {
                AddLog("CurrentUO.IdUO é null - lista vazia");
                items = new List<InventoryItem>();
            }
            
            AddLog($"Total de itens após filtro: {items.Count}");
        }
        catch (Exception ex)
        {
            AddLog($"Erro em TestLoadItems: {ex.Message}");
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void AddLog(string message)
    {
        logs.Add($"{DateTime.Now:HH:mm:ss} - {message}");
        if (logs.Count > 20) logs.RemoveAt(0);
        StateHasChanged();
    }

    private void ClearLogs()
    {
        logs.Clear();
        StateHasChanged();
    }

    private void GoToConfig()
    {
        Navigation.NavigateTo("/configuracao-sessao");
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        appState.OnChange -= HandleStateChange;
    }
}