# ============================================================================
# ASPEC CAPTURA - VARIÁVEIS DE AMBIENTE
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha com valores reais
# 3. NUNCA commite o arquivo .env no Git!
# ============================================================================

# Ambiente
ASPNETCORE_ENVIRONMENT=Development

# ============================================================================
# AWS CREDENTIALS
# ============================================================================
# Para MVP/Testes: Use credenciais atuais
# Para Produção: Migrar para AWS Secrets Manager
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-2
AWS_BUCKET_NAME=aspec-capture

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Gerar secret forte: openssl rand -base64 64
# Para MVP: Pode usar um secret simples
# Para Produção: OBRIGATÓRIO usar secret forte e único
JWT_SECRET=change-this-to-a-strong-secret-minimum-256-bits
JWT_ISSUER=aspec-capture-api
JWT_AUDIENCE=aspec-capture-client
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Separar múltiplas origens com vírgula
# Para MVP: localhost
# Para Produção: domínios reais
ALLOWED_ORIGINS=http://localhost:5000,https://localhost:5001,http://localhost:5173

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_CAPTURE_PER_MINUTE=30

# ============================================================================
# FEATURES FLAGS
# ============================================================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_ERRORS=true
ENABLE_LOCAL_DATA=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=Information
LOG_SENSITIVE_DATA=false
