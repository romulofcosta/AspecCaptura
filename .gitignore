## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Performance Trace
*.etl

# ODP.NET Application Configuration
App.config

# SASS compilation
.sass-cache/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service Projects
*.ccproj
*.sfproj
*.cspkg
*.cscfg
*.ctp

# Visual Studio CoreForm folder
Migrations/

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
node_modules/
orleans-http/
.DS_Store
*.pyc
*.pyo

# User-specific files
.idea/
.project
.classpath
.settings/
.vscode/

# Local Netlify folder
.netlify

# Netlify publish directory (if you want to keep it out of git)
# Since we are using bin/Release/net8.0/publish/wwwroot, it's already covered by [Bb]in/
