## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.tmp
*.log
*.err

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
out/

# Local .NET SDK and runtime
.dotnet/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code settings
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Performance Trace
*.etl

# ODP.NET Application Configuration
App.config

# SASS compilation
.sass-cache/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service Projects
*.ccproj
*.sfproj
*.cspkg
*.cscfg
*.ctp

# Visual Studio CoreForm folder
Migrations/

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
node_modules/
orleans-http/
.DS_Store
*.pyc
*.pyo

# IDE-specific files
.idea/
.project
.classpath
.settings/
.trae/

# Local Netlify folder
.netlify

# Build and error logs (arquivos temporários de debug)
build*.txt
build*.log
error*.txt
errors*.txt
output*.txt
blazor_output.txt
msbuild.log
run_logs.txt
current_errors.txt
full_build_error.txt
last_diff.txt

# Arquivos de commit temporários
commit-message*.txt

# Arquivos JSON de teste/sample (manter apenas os necessários para o projeto)
*_sample.json
*_end.json
test-payload.json

# Documentação temporária ou de debug (manter apenas docs oficiais)
BUILD_COMPARISON.md
QUAL_BUILD_USAR.md
RELATORIO_ANALISE_JSON.md
RESUMO_CORRECOES.md
SOLUCAO_CORS.md
VERSION_UPDATE.md

# Scripts de instalação baixados
dotnet-install.sh

# Netlify publish directory (if you want to keep it out of git)
# Since we are using bin/Release/net8.0/publish/wwwroot, it's already covered by [Bb]in/
